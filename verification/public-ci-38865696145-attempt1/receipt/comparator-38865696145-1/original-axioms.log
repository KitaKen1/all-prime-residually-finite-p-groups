def AllPrimeGroups.CoefficientObligations : ℕ → Prop :=
fun p =>
  ∃ R x,
    ∃ (_ : CharP R p) (_ : Infinite R),
      ∃ ε n,
        3 ≤ n ∧
          Group.IsFinitelyPresented (AllPrimeGroups.Steinberg n R) ∧
            (∀ (A : Matrix (Fin n) (Fin n) R), ε.mapMatrix A = 0 → IsNilpotent A) ∧
              Function.Injective ⇑(AllPrimeGroups.Stable.of R n) ∧
                (∀ (z : AllPrimeGroups.StableSteinberg R),
                    (AllPrimeGroups.Stable.representation R) z = 1 →
                      (AllPrimeGroups.Stable.map ε) z = 1 → ∃ a, z ^ p ^ a = 1) ∧
                  ∃ ι Q x_3,
                    ∃ (_ : ∀ (i : ι), Finite (Q i)),
                      ∃ q,
                        ∀ (z : AllPrimeGroups.StableSteinberg R),
                          (∀ (i : ι), (AllPrimeGroups.Stable.map (q i)) z = 1) → z = 1
