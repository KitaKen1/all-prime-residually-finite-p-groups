import AllPrimeGroups.ColumnComplex
import Mathlib.Algebra.Group.Subgroup.Pointwise
import Mathlib.GroupTheory.GroupAction.Defs
import Mathlib.GroupTheory.Coset.Basic
import Mathlib.Tactic.Group

/-! Transport of cosets along the column complex (manuscript Lemma 11.1, second paragraph).

Let a group G map to a group H acting on the vertices of the column complex by automorphisms.
Fix three standard vertices x₀, x₁, x₂, a subgroup P of H fixing x₀ with a homomorphic section
σ : P → G, and an element s of G sending x₀ to x₁ and fixing x₂. Assume that

* G is generated by σ(P) and s, and s² lies in σ(P);
* P acts transitively on neighbours of x₀ and on triangles at x₀;
* conjugation by s carries σ of the stabilizer of x₁ in P into σ(P);
* the triangle relation: for some t ∈ P sending x₁ to x₂, s⁻¹ σ(t)⁻¹ s σ(t) s ∈ σ(P).

Then every element of G whose image fixes x₀ lies in σ(P). Cosets of σ(P) are transported
along edges by g σ(P) ↦ g σ(p) s σ(P), where p ∈ P moves x₁ to the neighbour in g-coordinates;
backtracking and triangles act trivially, so the simple connectivity of the column complex makes
the transport of σ(P) along a closed path trivial. -/

namespace AllPrimeGroups
namespace ColumnComplex

open Classical

variable {k : Type*} [Field k] {n : ℕ} {X : Type*} (r : X → Fin n → k)
variable {G H : Type*} [Group G] [Group H] [MulAction H X]

/-- The data of manuscript Lemma 11.1 for coset transport. -/
structure TransportData (G H : Type*) [Group G] [Group H] [MulAction H X] where
  π : G →* H
  b : Fin n → X
  hb : ∀ i, r (b i) = Pi.single i 1
  i₀ : Fin n
  i₁ : Fin n
  i₂ : Fin n
  P : Subgroup H
  σ : P →* G
  s : G
  adj_smul : ∀ (h : H) (u v : X), Adj r u v → Adj r (h • u) (h • v)
  tri_smul : ∀ (h : H) (u v w : X), Tri r u v w → Tri r (h • u) (h • v) (h • w)
  π_σ : ∀ p : P, π (σ p) = p
  fix₀ : ∀ p : P, (p : H) • b i₀ = b i₀
  s₀ : π s • b i₀ = b i₁
  s₂ : π s • b i₂ = b i₂
  gen : Subgroup.closure (Set.range σ ∪ {s}) = ⊤
  sq : s * s ∈ σ.range
  nbr : ∀ w : X, Adj r (b i₀) w → ∃ p : P, (p : H) • b i₁ = w
  tri : ∀ w u : X, Tri r (b i₀) w u → ∃ p : P, (p : H) • b i₁ = w ∧ (p : H) • b i₂ = u
  stab : ∀ q : P, (q : H) • b i₁ = b i₁ → s⁻¹ * σ q * s ∈ σ.range
  t : P
  t₁ : (t : H) • b i₁ = b i₂
  triangle : s⁻¹ * (σ t)⁻¹ * s * σ t * s ∈ σ.range

variable {r} in
theorem Move.head?_eq {p q : List X} (h : Move r p q) : p.head? = q.head? := by
  cases h with
  | back x y v w _ => cases x <;> rfl
  | tri x y u v w _ => cases x <;> rfl

variable {r} in
/-- Homotopy invariance for paths from a fixed vertex. -/
theorem Homotopic.invariant_head {S : Type*} (x₀ : X) (F : List X → S)
    (hF : ∀ p q, Move r p q → p.IsChain (Adj r) → p.head? = some x₀ → F p = F q)
    {p q : List X} (h : Homotopic r p q) :
    (p.IsChain (Adj r) → p.head? = some x₀ → F p = F q) ∧
      (p.IsChain (Adj r) ↔ q.IsChain (Adj r)) ∧ p.head? = q.head? := by
  induction h with
  | rel p q hpq => exact ⟨hF p q hpq, hpq.isChain_iff, hpq.head?_eq⟩
  | refl p => exact ⟨fun _ _ => rfl, Iff.rfl, rfl⟩
  | symm p q _ ih =>
    exact ⟨fun hq hh => (ih.1 (ih.2.1.mpr hq) (ih.2.2.trans hh)).symm, ih.2.1.symm, ih.2.2.symm⟩
  | trans p q s _ _ ih₁ ih₂ =>
    exact ⟨fun hp hh => (ih₁.1 hp hh).trans (ih₂.1 (ih₁.2.1.mp hp) (ih₁.2.2.symm.trans hh)),
      ih₁.2.1.trans ih₂.2.1, ih₁.2.2.trans ih₂.2.2⟩

namespace TransportData
variable {r}
variable (D : TransportData r G H)

/-- Equivalence modulo σ(P) on the right. -/
def Rel (g g' : G) : Prop := g⁻¹ * g' ∈ D.σ.range

theorem Rel.refl' (g : G) : D.Rel g g := by
  unfold Rel
  rw [inv_mul_cancel]
  exact D.σ.range.one_mem

variable {D} in
theorem Rel.symm' {g g' : G} (h : D.Rel g g') : D.Rel g' g := by
  unfold Rel at *
  have := D.σ.range.inv_mem h
  simpa only [mul_inv_rev, inv_inv] using this

variable {D} in
theorem Rel.trans' {g g' g'' : G} (h₁ : D.Rel g g') (h₂ : D.Rel g' g'') : D.Rel g g'' := by
  unfold Rel at *
  have := D.σ.range.mul_mem h₁ h₂
  simpa only [mul_assoc, mul_inv_cancel_left] using this

variable {D} in
theorem Rel.mul_left {g g' : G} (h : D.Rel g g') (x : G) : D.Rel (x * g) (x * g') := by
  unfold Rel at *
  simpa only [mul_inv_rev, mul_assoc, inv_mul_cancel_left] using h

theorem rel_mul_σ (g : G) (p : D.P) : D.Rel g (g * D.σ p) := by
  unfold Rel
  rw [inv_mul_cancel_left]
  exact ⟨p, rfl⟩

/-- The column of a coset representative. -/
def col (g : G) : X := D.π g • D.b D.i₀

theorem col_one : D.col 1 = D.b D.i₀ := by rw [col, map_one, one_smul]

theorem col_rel {g g' : G} (h : D.Rel g g') : D.col g = D.col g' := by
  obtain ⟨p, hp⟩ := h
  have hg' : g' = g * D.σ p := by rw [hp, mul_inv_cancel_left]
  rw [hg', col, col, map_mul, mul_smul, D.π_σ, D.fix₀]

/-- Two elements of P moving x₁ to the same vertex give related transports. -/
theorem key {p p' : D.P} (h : (p : H) • D.b D.i₁ = (p' : H) • D.b D.i₁) :
    D.Rel (D.σ p * D.s) (D.σ p' * D.s) := by
  unfold Rel
  have hq : ((p⁻¹ * p' : D.P) : H) • D.b D.i₁ = D.b D.i₁ := by
    rw [Subgroup.coe_mul, Subgroup.coe_inv, mul_smul, ← h, inv_smul_smul]
  have := D.stab (p⁻¹ * p') hq
  rw [map_mul, map_inv] at this
  simpa only [mul_inv_rev, mul_assoc] using this

theorem exists_nbr (g : G) (w : X) (hw : Adj r (D.col g) w) :
    ∃ p : D.P, (p : H) • D.b D.i₁ = (D.π g)⁻¹ • w := by
  apply D.nbr
  have := D.adj_smul (D.π g)⁻¹ _ _ hw
  rwa [col, inv_smul_smul] at this

/-- One transport step, with an arbitrary result off the edges. -/
noncomputable def step (g : G) (w : X) : G :=
  if hw : Adj r (D.col g) w then g * D.σ (D.exists_nbr g w hw).choose * D.s else g

theorem step_of_not_adj (g : G) (w : X) (hw : ¬ Adj r (D.col g) w) : D.step g w = g := by
  simp only [step, hw, ↓reduceDIte]

theorem step_spec (g : G) (w : X) (hw : Adj r (D.col g) w) {p : D.P}
    (hp : (p : H) • D.b D.i₁ = (D.π g)⁻¹ • w) : D.Rel (D.step g w) (g * D.σ p * D.s) := by
  have hc := (D.exists_nbr g w hw).choose_spec
  have he : D.step g w = g * D.σ (D.exists_nbr g w hw).choose * D.s := by
    simp only [step, hw, ↓reduceDIte]
  rw [he, mul_assoc, mul_assoc]
  exact (D.key (hc.trans hp.symm)).mul_left g

theorem col_step (g : G) (w : X) (hw : Adj r (D.col g) w) : D.col (D.step g w) = w := by
  have hc := (D.exists_nbr g w hw).choose_spec
  have he : D.step g w = g * D.σ (D.exists_nbr g w hw).choose * D.s := by
    simp only [step, hw, ↓reduceDIte]
  rw [he, col, map_mul, map_mul, mul_smul, mul_smul, D.s₀, D.π_σ, hc, smul_inv_smul]

theorem step_rel {g g' : G} (h : D.Rel g g') (w : X) (hw : Adj r (D.col g) w) :
    D.Rel (D.step g w) (D.step g' w) := by
  obtain ⟨p₀, hp₀⟩ := h
  have hg' : g' = g * D.σ p₀ := by rw [hp₀, mul_inv_cancel_left]
  obtain ⟨p, hp⟩ := D.exists_nbr g w hw
  have hw' : Adj r (D.col g') w := by rwa [← D.col_rel ⟨p₀, hp₀⟩]
  have hp' : ((p₀⁻¹ * p : D.P) : H) • D.b D.i₁ = (D.π g')⁻¹ • w := by
    rw [Subgroup.coe_mul, Subgroup.coe_inv, mul_smul, hp, hg', map_mul, D.π_σ, mul_inv_rev,
      mul_smul]
  refine (D.step_spec g w hw hp).trans' (Rel.symm' ?_)
  refine (D.step_spec g' w hw' hp').trans' ?_
  rw [hg', map_mul, map_inv, mul_assoc g, mul_inv_cancel_left]
  exact Rel.refl' D _

/-- Transport is equivariant for left multiplication. -/
theorem step_mul (x g : G) (w : X) (hw : Adj r (D.col g) w) :
    D.Rel (D.step (x * g) (D.π x • w)) (x * D.step g w) := by
  obtain ⟨p, hp⟩ := D.exists_nbr g w hw
  have hw' : Adj r (D.col (x * g)) (D.π x • w) := by
    have := D.adj_smul (D.π x) _ _ hw
    rwa [col, ← mul_smul, ← map_mul] at this
  have hp' : (p : H) • D.b D.i₁ = (D.π (x * g))⁻¹ • (D.π x • w) := by
    rw [hp, map_mul, mul_inv_rev, mul_smul, inv_smul_smul]
  refine (D.step_spec (x * g) _ hw' hp').trans' (Rel.symm' ?_)
  have := (D.step_spec g w hw hp).mul_left x
  simpa only [mul_assoc] using this

theorem s_fix₁ : D.π D.s • D.b D.i₁ = D.b D.i₀ := by
  obtain ⟨q, hq⟩ := D.sq
  have h1 : D.π (D.s * D.s) • D.b D.i₀ = D.b D.i₀ := by rw [← hq, D.π_σ, D.fix₀]
  rwa [map_mul, mul_smul, D.s₀] at h1

/-- Backtracking is trivial. -/
theorem step_back (g : G) (w : X) (hw : Adj r (D.col g) w) :
    D.Rel (D.step (D.step g w) (D.col g)) g := by
  obtain ⟨p, hp⟩ := D.exists_nbr g w hw
  have h1 := D.step_spec g w hw hp
  have hw' : Adj r (D.col (D.step g w)) (D.col g) := by
    rw [D.col_step g w hw]
    exact hw.symm
  have hw'' : Adj r (D.col (g * D.σ p * D.s)) (D.col g) := by
    rwa [← D.col_rel h1]
  have hp1 : ((1 : D.P) : H) • D.b D.i₁ = (D.π (g * D.σ p * D.s))⁻¹ • D.col g := by
    rw [eq_inv_smul_iff, map_mul, map_mul, mul_smul, mul_smul, OneMemClass.coe_one, one_smul,
      D.s_fix₁, D.π_σ, D.fix₀]
    rfl
  refine (D.step_rel h1 (D.col g) hw').trans' ((D.step_spec _ _ hw'' hp1).trans' ?_)
  rw [map_one, mul_one]
  refine Rel.symm' ?_
  unfold Rel
  have e : g⁻¹ * (g * D.σ p * D.s * D.s) = D.σ p * (D.s * D.s) := by group
  rw [e]
  exact D.σ.range.mul_mem ⟨p, rfl⟩ D.sq

/-- Triangles are trivial. -/
theorem step_tri (g : G) (w u : X) (h : Tri r (D.col g) w u) :
    D.Rel (D.step (D.step g w) u) (D.step g u) := by
  have h' : Tri r (D.b D.i₀) ((D.π g)⁻¹ • w) ((D.π g)⁻¹ • u) := by
    have := D.tri_smul (D.π g)⁻¹ _ _ _ h
    rwa [col, inv_smul_smul] at this
  obtain ⟨p, hp1, hp2⟩ := D.tri _ _ h'
  have hrel : D.Rel g (g * D.σ p) := D.rel_mul_σ g p
  have hw : Adj r (D.col g) w := h.adj12
  have hu : Adj r (D.col g) u := h.adj13
  have hwu : Adj r w u := h.adj23
  have hcol' : D.col (g * D.σ p) = D.col g := (D.col_rel hrel).symm
  have hg'1 : (D.π (g * D.σ p))⁻¹ • w = D.b D.i₁ := by
    rw [map_mul, D.π_σ, mul_inv_rev, mul_smul, ← hp1, inv_smul_smul]
  have hg'2 : (D.π (g * D.σ p))⁻¹ • u = D.b D.i₂ := by
    rw [map_mul, D.π_σ, mul_inv_rev, mul_smul, ← hp2, inv_smul_smul]
  have e1 : D.Rel (D.step (g * D.σ p) w) (g * D.σ p * D.σ 1 * D.s) :=
    D.step_spec _ w (by rw [hcol']; exact hw) (by rw [hg'1]; exact one_smul H _)
  have e1' : D.Rel (D.step g w) (g * D.σ p * D.s) := by
    have := (D.step_rel hrel w hw).trans' e1
    rwa [map_one, mul_one] at this
  have hAdj1 : Adj r (D.col (D.step g w)) u := by
    rw [D.col_step g w hw]
    exact hwu
  have hAdj2 : Adj r (D.col (g * D.σ p * D.s)) u := by
    rw [← D.col_rel e1']
    exact hAdj1
  have hs2 : (D.π (g * D.σ p * D.s))⁻¹ • u = D.b D.i₂ := by
    rw [map_mul (D.π) (g * D.σ p) D.s, mul_inv_rev, mul_smul, hg'2, inv_smul_eq_iff, D.s₂]
  have e2 : D.Rel (D.step (g * D.σ p * D.s) u) (g * D.σ p * D.s * D.σ D.t * D.s) :=
    D.step_spec _ u hAdj2 (by rw [hs2, D.t₁])
  have e3 : D.Rel (D.step (g * D.σ p) u) (g * D.σ p * D.σ D.t * D.s) :=
    D.step_spec _ u (by rw [hcol']; exact hu) (by rw [hg'2, D.t₁])
  refine (D.step_rel e1' u hAdj1).trans' (e2.trans' ?_)
  refine Rel.trans' ?_ (e3.symm'.trans' (D.step_rel hrel u hu).symm')
  unfold Rel
  have e : (g * D.σ p * D.s * D.σ D.t * D.s)⁻¹ * (g * D.σ p * D.σ D.t * D.s) =
      (D.s⁻¹ * (D.σ D.t)⁻¹ * D.s * D.σ D.t * D.s)⁻¹ := by group
  rw [e]
  exact D.σ.range.inv_mem D.triangle

/-- Transport along a list of vertices. -/
noncomputable def trans (g : G) (l : List X) : G := l.foldl D.step g

theorem trans_cons (g : G) (w : X) (l : List X) :
    D.trans g (w :: l) = D.trans (D.step g w) l := rfl

theorem trans_append (g : G) (l₁ l₂ : List X) :
    D.trans g (l₁ ++ l₂) = D.trans (D.trans g l₁) l₂ := List.foldl_append

/-- Transport follows the path. -/
theorem col_trans : ∀ (l : List X) (g : G), (D.col g :: l).IsChain (Adj r) →
    (D.col g :: l).getLast? = some (D.col (D.trans g l))
  | [], g, _ => rfl
  | w :: l, g, hc => by
    rw [List.isChain_cons_cons] at hc
    have hcol := D.col_step g w hc.1
    rw [trans_cons, List.getLast?_cons_cons, ← col_trans l (D.step g w) (by rw [hcol]; exact hc.2),
      hcol]

theorem trans_rel : ∀ (l : List X) {g g' : G}, D.Rel g g' → (D.col g :: l).IsChain (Adj r) →
    D.Rel (D.trans g l) (D.trans g' l)
  | [], _, _, h, _ => h
  | w :: l, g, g', h, hc => by
    rw [List.isChain_cons_cons] at hc
    rw [trans_cons, trans_cons]
    exact trans_rel l (D.step_rel h w hc.1) (by rw [D.col_step g w hc.1]; exact hc.2)

include D in
theorem isChain_map (x : H) : ∀ (l : List X), l.IsChain (Adj r) →
    (l.map (x • ·)).IsChain (Adj r)
  | [], _ => List.IsChain.nil
  | [_], _ => List.IsChain.singleton _
  | u :: v :: l, hc => by
    rw [List.isChain_cons_cons] at hc
    rw [List.map_cons, List.map_cons, List.isChain_cons_cons]
    exact ⟨D.adj_smul x _ _ hc.1, by simpa only [List.map_cons] using isChain_map x (v :: l) hc.2⟩

theorem trans_mul (x : G) : ∀ (l : List X) (g : G), (D.col g :: l).IsChain (Adj r) →
    D.Rel (D.trans (x * g) (l.map (D.π x • ·))) (x * D.trans g l)
  | [], g, _ => Rel.refl' D _
  | w :: l, g, hc => by
    have hc' := hc
    rw [List.isChain_cons_cons] at hc'
    rw [List.map_cons, trans_cons, trans_cons]
    have h1 := D.step_mul x g w hc'.1
    have hcol : D.col (D.step (x * g) (D.π x • w)) = D.π x • w := by
      have hw' : Adj r (D.col (x * g)) (D.π x • w) := by
        have := D.adj_smul (D.π x) _ _ hc'.1
        rwa [col, ← mul_smul, ← map_mul] at this
      exact D.col_step _ _ hw'
    have hc2 : (D.col (D.step (x * g) (D.π x • w)) :: l.map (D.π x • ·)).IsChain (Adj r) := by
      rw [hcol]
      simpa only [List.map_cons] using D.isChain_map (D.π x) (w :: l) hc'.2
    refine (D.trans_rel _ h1 hc2).trans' ?_
    exact trans_mul x l (D.step g w) (by rw [D.col_step g w hc'.1]; exact hc'.2)

/-- Elements reachable by transporting σ(P) along a path from x₀. -/
def Reach (g : G) : Prop :=
  ∃ l : List X, (D.b D.i₀ :: l).IsChain (Adj r) ∧
    (D.b D.i₀ :: l).getLast? = some (D.col g) ∧ D.Rel (D.trans 1 l) g

theorem reach_one : D.Reach 1 :=
  ⟨[], List.IsChain.singleton _, by rw [D.col_one]; rfl, Rel.refl' D _⟩

theorem reach_σ (q : D.P) {g : G} (hg : D.Reach g) : D.Reach (D.σ q * g) := by
  obtain ⟨l, hc, hlast, hrel⟩ := hg
  have hq : D.π (D.σ q) • D.b D.i₀ = D.b D.i₀ := by rw [D.π_σ, D.fix₀]
  refine ⟨l.map (D.π (D.σ q) • ·), ?_, ?_, ?_⟩
  · have := D.isChain_map (D.π (D.σ q)) _ hc
    rwa [List.map_cons, hq] at this
  · have := congrArg (Option.map (D.π (D.σ q) • ·)) hlast
    rw [← List.getLast?_map, List.map_cons, hq] at this
    rw [this, col, col, map_mul, mul_smul]
    rfl
  · have hc1 : (D.col 1 :: l).IsChain (Adj r) := by rw [D.col_one]; exact hc
    have h1 := D.trans_mul (D.σ q) l 1 hc1
    rw [mul_one] at h1
    have h2 : D.Rel 1 (D.σ q) := by
      unfold Rel
      rw [inv_one, one_mul]
      exact ⟨q, rfl⟩
    have hc2 : (D.col 1 :: l.map (D.π (D.σ q) • ·)).IsChain (Adj r) := by
      have := D.isChain_map (D.π (D.σ q)) _ hc
      rwa [List.map_cons, hq, ← D.col_one] at this
    exact (D.trans_rel _ h2 hc2).trans' (h1.trans' (hrel.mul_left _))

theorem reach_s (h01 : Adj r (D.b D.i₀) (D.b D.i₁)) {g : G} (hg : D.Reach g) :
    D.Reach (D.s * g) := by
  obtain ⟨l, hc, hlast, hrel⟩ := hg
  refine ⟨D.b D.i₁ :: l.map (D.π D.s • ·), ?_, ?_, ?_⟩
  · have := D.isChain_map (D.π D.s) _ hc
    rw [List.map_cons, D.s₀] at this
    exact List.isChain_cons_cons.mpr ⟨h01, this⟩
  · have := congrArg (Option.map (D.π D.s • ·)) hlast
    rw [← List.getLast?_map, List.map_cons, D.s₀] at this
    rw [List.getLast?_cons_cons, this, col, col, map_mul, mul_smul]
    rfl
  · rw [trans_cons]
    have hadj : Adj r (D.col 1) (D.b D.i₁) := by rw [D.col_one]; exact h01
    have h0 : D.Rel (D.step 1 (D.b D.i₁)) D.s := by
      have := D.step_spec 1 (D.b D.i₁) hadj (p := 1) (by simp)
      rwa [one_mul, map_one, one_mul] at this
    have hcol : D.col (D.step 1 (D.b D.i₁)) = D.b D.i₁ := D.col_step 1 _ hadj
    have hc2 : (D.col (D.step 1 (D.b D.i₁)) :: l.map (D.π D.s • ·)).IsChain (Adj r) := by
      have := D.isChain_map (D.π D.s) _ hc
      rwa [List.map_cons, D.s₀, ← hcol] at this
    have hc1 : (D.col 1 :: l).IsChain (Adj r) := by rw [D.col_one]; exact hc
    have h1 := D.trans_mul D.s l 1 hc1
    rw [mul_one] at h1
    exact (D.trans_rel _ h0 hc2).trans' (h1.trans' (hrel.mul_left _))

theorem reach_all (h01 : Adj r (D.b D.i₀) (D.b D.i₁)) (g : G) : D.Reach g := by
  have hg : g ∈ Subgroup.closure (Set.range D.σ ∪ {D.s}) := by rw [D.gen]; trivial
  induction hg using Subgroup.closure_induction_left with
  | one => exact D.reach_one
  | mul_left x hx y _ ih =>
    rcases hx with ⟨q, rfl⟩ | hx
    · exact D.reach_σ q ih
    · rw [Set.mem_singleton_iff.mp hx]
      exact D.reach_s h01 ih
  | inv_mul_cancel x hx y _ ih =>
    rcases hx with ⟨q, rfl⟩ | hx
    · rw [← map_inv]
      exact D.reach_σ q⁻¹ ih
    · rw [Set.mem_singleton_iff.mp hx]
      obtain ⟨q, hq⟩ := D.sq
      have e : D.s⁻¹ * y = D.σ q⁻¹ * (D.s * y) := by
        rw [map_inv, hq]
        group
      rw [e]
      exact D.reach_σ q⁻¹ (D.reach_s h01 ih)

theorem step_one_base : D.step 1 (D.b D.i₀) = 1 :=
  D.step_of_not_adj 1 _ (by rw [D.col_one]; exact Adj.irrefl _)

theorem trans_head (m : List X) : D.trans 1 (D.b D.i₀ :: m) = D.trans 1 m := by
  rw [trans_cons, D.step_one_base]

/-- Transport from σ(P) along a path from x₀ follows the path. -/
theorem col_trans_one (l : List X) (hc : l.IsChain (Adj r)) (hh : l.head? = some (D.b D.i₀)) :
    l.getLast? = some (D.col (D.trans 1 l)) := by
  cases l with
  | nil => simp at hh
  | cons v m =>
    simp only [List.head?_cons, Option.some.injEq] at hh
    subst hh
    rw [D.trans_head]
    have := D.col_trans m 1 (by rw [D.col_one]; exact hc)
    rwa [D.col_one] at this

/-- A move does not change the transport of σ(P) along a path from x₀. -/
theorem trans_move (p q : List X) (h : Move r p q) (hc : p.IsChain (Adj r))
    (hh : p.head? = some (D.b D.i₀)) : D.Rel (D.trans 1 p) (D.trans 1 q) := by
  cases h with
  | back x y v w hvw =>
    have e1 : x ++ v :: w :: v :: y = (x ++ [v]) ++ (w :: v :: y) := by simp
    have e2 : x ++ v :: y = (x ++ [v]) ++ y := by simp
    rw [e1] at hc hh
    have ep : D.trans 1 (x ++ v :: w :: v :: y) =
        D.trans (D.step (D.step (D.trans 1 (x ++ [v])) w) v) y := by
      rw [e1]
      exact List.foldl_append
    have eq : D.trans 1 (x ++ v :: y) = D.trans (D.trans 1 (x ++ [v])) y := by
      rw [e2]
      exact List.foldl_append
    rw [ep, eq]
    rw [List.isChain_append] at hc
    have hcol : D.col (D.trans 1 (x ++ [v])) = v := by
      have := D.col_trans_one (x ++ [v]) hc.1
        ((List.head?_append_of_ne_nil (x ++ [v]) (by simp)).symm.trans hh)
      rw [List.getLast?_append_cons, List.getLast?_singleton] at this
      exact (Option.some.inj this).symm
    have hc2 := hc.2.1
    rw [List.isChain_cons_cons] at hc2
    have hw : Adj r (D.col (D.trans 1 (x ++ [v]))) w := by rw [hcol]; exact hvw
    have hb := D.step_back _ w hw
    rw [hcol] at hb
    refine D.trans_rel y hb ?_
    rw [D.col_step _ v (by rw [D.col_step _ w hw]; exact hvw.symm)]
    exact hc2.2
  | tri x y u v w huvw =>
    have e1 : x ++ u :: v :: w :: y = (x ++ [u]) ++ (v :: w :: y) := by simp
    have e2 : x ++ u :: w :: y = (x ++ [u]) ++ (w :: y) := by simp
    rw [e1] at hc hh
    have ep : D.trans 1 (x ++ u :: v :: w :: y) =
        D.trans (D.step (D.step (D.trans 1 (x ++ [u])) v) w) y := by
      rw [e1]
      exact List.foldl_append
    have eq : D.trans 1 (x ++ u :: w :: y) = D.trans (D.step (D.trans 1 (x ++ [u])) w) y := by
      rw [e2]
      exact List.foldl_append
    rw [ep, eq]
    rw [List.isChain_append] at hc
    have hcol : D.col (D.trans 1 (x ++ [u])) = u := by
      have := D.col_trans_one (x ++ [u]) hc.1
        ((List.head?_append_of_ne_nil (x ++ [u]) (by simp)).symm.trans hh)
      rw [List.getLast?_append_cons, List.getLast?_singleton] at this
      exact (Option.some.inj this).symm
    have hc2 := hc.2.1
    rw [List.isChain_cons_cons] at hc2
    have ht : Tri r (D.col (D.trans 1 (x ++ [u]))) v w := by rw [hcol]; exact huvw
    refine D.trans_rel y (D.step_tri _ v w ht) ?_
    have hv : Adj r (D.col (D.trans 1 (x ++ [u]))) v := ht.adj12
    rw [D.col_step _ w (by rw [D.col_step _ v hv]; exact huvw.adj23)]
    exact hc2.2

/-- Manuscript Lemma 11.1, coset transport: an element whose image fixes x₀ lies in σ(P). -/
theorem mem_range (hn : 3 ≤ n) (h01 : Adj r (D.b D.i₀) (D.b D.i₁)) (g : G)
    (hg : D.π g • D.b D.i₀ = D.b D.i₀) : g ∈ D.σ.range := by
  obtain ⟨l, hc, hlast, hrel⟩ := D.reach_all h01 g
  have hcol : D.col g = D.b D.i₀ := hg
  rw [hcol] at hlast
  have hhom := simply_connected r D.b D.hb hn _ l (D.b D.i₀) le_rfl hc ⟨D.i₀, rfl⟩ hlast
  have hinv := (hhom.invariant_head (D.b D.i₀) (fun l => (D.trans 1 l : G ⧸ D.σ.range))
    (fun p q hpq hp hh => QuotientGroup.eq.mpr (D.trans_move p q hpq hp hh))).1 hc rfl
  rw [D.trans_head, D.trans_head] at hinv
  have h1 : D.Rel (D.trans 1 l) 1 := QuotientGroup.eq.mp hinv
  have h2 : D.Rel 1 g := h1.symm'.trans' hrel
  unfold Rel at h2
  simpa using h2

/-- Consequently the map to H is injective. -/
theorem π_injective (hn : 3 ≤ n) (h01 : Adj r (D.b D.i₀) (D.b D.i₁)) :
    Function.Injective D.π := by
  rw [← MonoidHom.ker_eq_bot_iff, eq_bot_iff]
  intro g hg
  rw [MonoidHom.mem_ker] at hg
  obtain ⟨p, rfl⟩ := D.mem_range hn h01 g (by rw [hg, one_smul])
  have hp : (p : H) = 1 := by rw [← D.π_σ, hg]
  have : p = 1 := Subtype.ext hp
  rw [this, map_one]
  exact Subgroup.one_mem _

