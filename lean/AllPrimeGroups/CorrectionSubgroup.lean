import AllPrimeGroups.RelocationMoves

/-! The correction subgroup (manuscript Lemma 20.3: normalization and commutation).

Every coordinate carries a phase. A root `x_ij(w)` of a word is consistent when the phases of i
and j are the start and end phases of w. The correction subgroup `U` is generated by the
wrong-row roots `x_ij(a)`, whose end phase is that of the column but whose start phase differs
from that of the row, and by the opposite-root commutators `[x_ij(a), x_ji(b)]` with
`σ(a) ≠ P(i) = τ(b)`; when `ab ≠ 0` these are the manuscript's diagonal elements `H_i(ab)`.

Consistent roots normalize `U`, and the generators of `U` commute pairwise. The only input
about opposite roots is the zero alternative of manuscript Lemma 20.2 for two wrong-row roots;
the diagonal generators are moved to a fresh auxiliary coordinate by the exact cut movement of
Lemma 20.1. Faithfulness of `U` is proved in `CorrectionFaithful.lean`. -/

namespace AllPrimeGroups
noncomputable section
namespace Kernel
open Classical

namespace PhaseGrading
variable {ℓ : ℕ} {R : Type*} [Ring R] [Algebra (ZMod ℓ) R]
variable {m : ℕ} [NeZero m] (G : PhaseGrading ℓ R m) {K : ℕ} (P : Fin K → Fin m)

/-- Off-diagonal wrong-row roots. -/
def wrongRoots : Set (Steinberg K R) :=
  {g | ∃ (i j : Fin K) (hij : i ≠ j) (a : R), a ∈ G.W ∧ P i ≠ G.σ a ∧ P j = G.τ a ∧
    g = Steinberg.x ⟨i, j, hij⟩ a}

/-- Diagonal wrong-row elements, as opposite-root commutators. -/
def wrongDiagonals : Set (Steinberg K R) :=
  {g | ∃ (i j : Fin K) (hij : i ≠ j) (a b : R), a ∈ G.W ∧ b ∈ G.W ∧ P i ≠ G.σ a ∧
    P i = G.τ b ∧ g = bracket (Steinberg.x ⟨i, j, hij⟩ a) (Steinberg.x ⟨j, i, hij.symm⟩ b)}

/-- The correction subgroup `U(S, P)` of manuscript Lemma 20.3. -/
def correction : Subgroup (Steinberg K R) :=
  Subgroup.closure (G.wrongRoots P ∪ G.wrongDiagonals P)

theorem wrongRoot_mem {i j : Fin K} (hij : i ≠ j) {a : R} (ha : a ∈ G.W) (hi : P i ≠ G.σ a)
    (hj : P j = G.τ a) : Steinberg.x ⟨i, j, hij⟩ a ∈ G.correction P :=
  Subgroup.subset_closure (Or.inl ⟨i, j, hij, a, ha, hi, hj, rfl⟩)

theorem wrongDiagonal_mem {i j : Fin K} (hij : i ≠ j) {a b : R} (ha : a ∈ G.W) (hb : b ∈ G.W)
    (hi : P i ≠ G.σ a) (hi' : P i = G.τ b) :
    bracket (Steinberg.x ⟨i, j, hij⟩ a) (Steinberg.x ⟨j, i, hij.symm⟩ b) ∈ G.correction P :=
  Subgroup.subset_closure (Or.inr ⟨i, j, hij, a, b, ha, hb, hi, hi', rfl⟩)

/-- The negative of a product of a wrong-row word with a word ending at the column phase. -/
theorem wrongRoot_neg_mul_mem {i j : Fin K} (hij : i ≠ j) {a w : R} (ha : a ∈ G.W)
    (hw : w ∈ G.W) (hi : P i ≠ G.σ a) (hj : P j = G.τ w) :
    Steinberg.x ⟨i, j, hij⟩ (-(a * w)) ∈ G.correction P := by
  by_cases h0 : a * w = 0
  · rw [h0, neg_zero, Steinberg.x_zero]
    exact Subgroup.one_mem _
  · obtain ⟨hmem, hσ, hτ⟩ := G.mul_mem a ha w hw h0
    rw [Steinberg.x_neg]
    exact Subgroup.inv_mem _
      (G.wrongRoot_mem P hij hmem (by rw [hσ]; exact hi) (by rw [hτ]; exact hj))

/-- Opposite-root commutators with `b a = 0` do not depend on the auxiliary index. -/
theorem bracket_index {i j h : Fin K} (hij : i ≠ j) (hih : i ≠ h) (hhj : h ≠ j) {a b : R}
    (hba : b * a = 0) :
    bracket (Steinberg.x ⟨i, j, hij⟩ a) (Steinberg.x ⟨j, i, hij.symm⟩ b) =
      bracket (Steinberg.x ⟨i, h, hih⟩ a) (Steinberg.x ⟨h, i, hih.symm⟩ b) := by
  have he := Steinberg.move_cut hih hhj hij a 1 b hba
  simpa only [mul_one, one_mul] using he

theorem bracket_conj (c X Z : Steinberg K R) :
    c * bracket X Z * c⁻¹ = bracket (c * X * c⁻¹) (c * Z * c⁻¹) := by
  simp only [bracket]
  group

theorem conj_wrongRoot_mem {γ δ : Fin K} (hγδ : γ ≠ δ) {w : R} (hw : w ∈ G.W)
    (hδ : P δ = G.τ w) {α β : Fin K} (hαβ : α ≠ β) {a : R} (ha : a ∈ G.W)
    (hσa : P α ≠ G.σ a) (hτa : P β = G.τ a) :
    Steinberg.x ⟨γ, δ, hγδ⟩ w * Steinberg.x ⟨α, β, hαβ⟩ a * (Steinberg.x ⟨γ, δ, hγδ⟩ w)⁻¹ ∈
      G.correction P := by
  by_cases hδα : δ = α
  · subst hδα
    by_cases hγβ : γ = β
    · subst hγβ
      have he : Steinberg.x ⟨γ, δ, hγδ⟩ w * Steinberg.x ⟨δ, γ, hαβ⟩ a *
          (Steinberg.x ⟨γ, δ, hγδ⟩ w)⁻¹ =
          (bracket (Steinberg.x ⟨δ, γ, hαβ⟩ a) (Steinberg.x ⟨γ, δ, hαβ.symm⟩ w))⁻¹ *
            Steinberg.x ⟨δ, γ, hαβ⟩ a := by
        simp only [bracket]
        group
      rw [he]
      exact Subgroup.mul_mem _ (Subgroup.inv_mem _ (G.wrongDiagonal_mem P hαβ ha hw hσa hδ))
        (G.wrongRoot_mem P hαβ ha hσa hτa)
    · rw [Steinberg.conjugate_chain γ δ β hγδ hαβ hγβ w a,
        G.mul_eq_zero w hw a ha (by rw [← hδ]; exact hσa), Steinberg.x_zero, one_mul]
      exact G.wrongRoot_mem P hαβ ha hσa hτa
  · by_cases hγβ : γ = β
    · subst hγβ
      rw [Steinberg.conjugate_reverse α γ δ hαβ hγδ (Ne.symm hδα) a w]
      exact Subgroup.mul_mem _ (G.wrongRoot_neg_mul_mem P (Ne.symm hδα) ha hw hσa hδ)
        (G.wrongRoot_mem P hαβ ha hσa hτa)
    · rw [Steinberg.conjugate_commute ⟨γ, δ, hγδ⟩ ⟨α, β, hαβ⟩ hδα hγβ w a]
      exact G.wrongRoot_mem P hαβ ha hσa hτa

theorem conj_wrongDiagonal_mem (hK : 5 ≤ K) {γ δ : Fin K} (hγδ : γ ≠ δ) {w : R}
    (hw : w ∈ G.W) (hδ : P δ = G.τ w) {α β : Fin K} (hαβ : α ≠ β)
    {a b : R} (ha : a ∈ G.W) (hb : b ∈ G.W) (hσa : P α ≠ G.σ a) (hτb : P α = G.τ b) :
    Steinberg.x ⟨γ, δ, hγδ⟩ w *
        bracket (Steinberg.x ⟨α, β, hαβ⟩ a) (Steinberg.x ⟨β, α, hαβ.symm⟩ b) *
        (Steinberg.x ⟨γ, δ, hγδ⟩ w)⁻¹ ∈ G.correction P := by
  have hba : b * a = 0 := G.mul_eq_zero b hb a ha (by rw [← hτb]; exact hσa)
  obtain ⟨β', h1, h2, h3, h4⟩ := exists_fresh hK α β γ δ
  have hgen := G.wrongDiagonal_mem P hαβ ha hb hσa hτb
  rw [bracket_index hαβ (Ne.symm h1) h2 hba] at hgen ⊢
  rw [bracket_conj]
  by_cases hγα : γ = α
  · subst hγα
    have hcX := Steinberg.conjugate_commute ⟨γ, δ, hγδ⟩ ⟨γ, β', Ne.symm h1⟩ (Ne.symm hγδ)
      (Ne.symm h1) w a
    have hcZ := Steinberg.conjugate_reverse β' γ δ h1 hγδ h4 b w
    have hY : Commute (Steinberg.x (R := R) ⟨β', δ, h4⟩ (-(b * w)))
        (bracket (Steinberg.x ⟨γ, β', Ne.symm h1⟩ a) (Steinberg.x ⟨β', γ, h1⟩ b)) := by
      obtain ⟨β'', k1, k2, k3, _⟩ := exists_fresh hK γ β' δ β
      rw [bracket_index (Ne.symm h1) (Ne.symm k1) k2 hba]
      apply CommutatorCalculus.commute_bracket_right
      · exact Steinberg.x_commute _ _ (Ne.symm hγδ) (Ne.symm k2) _ _
      · exact Steinberg.x_commute _ _ (Ne.symm k3) h1 _ _
    have key : ∀ A Y B : Steinberg K R, Commute Y B → A * Y * B * Y⁻¹ = A * B := by
      intro A Y B h
      calc A * Y * B * Y⁻¹ = A * (Y * B * Y⁻¹) := by group
        _ = A * B := by rw [CommutatorCalculus.conj_of_commute h]
    rw [hcX, hcZ, CommutatorCalculus.mul_right,
      Steinberg.x_mul γ β' δ (Ne.symm h1) h4 hγδ a (-(b * w)), key _ _ _ hY]
    have hm : Steinberg.x (R := R) ⟨γ, δ, hγδ⟩ (a * -(b * w)) ∈ G.correction P := by
      rw [mul_neg, ← mul_assoc]
      by_cases hab : a * b = 0
      · rw [hab, zero_mul, neg_zero, Steinberg.x_zero]
        exact Subgroup.one_mem _
      · obtain ⟨hmem, hσ, _⟩ := G.mul_mem a ha b hb hab
        exact G.wrongRoot_neg_mul_mem P hγδ hmem hw (by rw [hσ]; exact hσa) hδ
    exact Subgroup.mul_mem _ hm hgen
  · by_cases hδα : δ = α
    · subst hδα
      have hcX : Steinberg.x ⟨γ, δ, hγδ⟩ w * Steinberg.x ⟨δ, β', Ne.symm h1⟩ a *
          (Steinberg.x ⟨γ, δ, hγδ⟩ w)⁻¹ = Steinberg.x ⟨δ, β', Ne.symm h1⟩ a := by
        rw [Steinberg.conjugate_chain γ δ β' hγδ (Ne.symm h1) (Ne.symm h3) w a,
          G.mul_eq_zero w hw a ha (by rw [← hδ]; exact hσa), Steinberg.x_zero, one_mul]
      have hcZ := Steinberg.conjugate_commute ⟨γ, δ, hγδ⟩ ⟨β', δ, h1⟩ (Ne.symm h1) hγδ w b
      rw [hcX, hcZ]
      exact hgen
    · have hcX := Steinberg.conjugate_commute ⟨γ, δ, hγδ⟩ ⟨α, β', Ne.symm h1⟩ hδα
        (Ne.symm h3) w a
      have hcZ := Steinberg.conjugate_commute ⟨γ, δ, hγδ⟩ ⟨β', α, h1⟩ (Ne.symm h4) hγα w b
      rw [hcX, hcZ]
      exact hgen

/-- Roots whose word ends at the phase of their column conjugate the correction subgroup into
itself; in particular consistent roots do. -/
theorem conj_root_mem (hK : 5 ≤ K) {γ δ : Fin K} (hγδ : γ ≠ δ) {w : R} (hw : w ∈ G.W)
    (hδ : P δ = G.τ w) {g : Steinberg K R} (hg : g ∈ G.correction P) :
    Steinberg.x ⟨γ, δ, hγδ⟩ w * g * (Steinberg.x ⟨γ, δ, hγδ⟩ w)⁻¹ ∈ G.correction P := by
  have Hle : G.correction P ≤ (G.correction P).comap
      (MulAut.conj (Steinberg.x (R := R) ⟨γ, δ, hγδ⟩ w)).toMonoidHom := by
    apply (Subgroup.closure_le _).mpr
    rintro g (⟨α, β, hαβ, a, ha, hσa, hτa, rfl⟩ | ⟨α, β, hαβ, a, b, ha, hb, hσa, hτb, rfl⟩)
    · exact G.conj_wrongRoot_mem P hγδ hw hδ hαβ ha hσa hτa
    · exact G.conj_wrongDiagonal_mem P hK hγδ hw hδ hαβ ha hb hσa hτb
  exact Hle hg

theorem x_pow_char {k : ℕ} (q : Root k) (a : R) : Steinberg.x q a ^ ℓ = 1 := by
  rw [← Steinberg.x_nsmul, nsmul_eq_mul]
  have hℓR : ((ℓ : ℕ) : R) = 0 := by
    rw [← map_natCast (algebraMap (ZMod ℓ) R), ZMod.natCast_self, map_zero]
  rw [hℓR, zero_mul, Steinberg.x_zero]

/-- Roots whose word ends at the phase of their column normalize the correction subgroup. -/
theorem root_mem_normalizer [Fact ℓ.Prime] (hK : 5 ≤ K) {γ δ : Fin K} (hγδ : γ ≠ δ)
    {w : R} (hw : w ∈ G.W) (hδ : P δ = G.τ w) :
    Steinberg.x ⟨γ, δ, hγδ⟩ w ∈
      Subgroup.normalizer (G.correction P : Set (Steinberg K R)) := by
  have hpow : ∀ k : ℕ, ∀ g ∈ G.correction P,
      Steinberg.x ⟨γ, δ, hγδ⟩ w ^ k * g * (Steinberg.x ⟨γ, δ, hγδ⟩ w ^ k)⁻¹ ∈
        G.correction P := by
    intro k
    induction k with
    | zero =>
      intro g hg
      simpa using hg
    | succ k ih =>
      intro g hg
      have h := G.conj_root_mem P hK hγδ hw hδ (ih g hg)
      have he : Steinberg.x ⟨γ, δ, hγδ⟩ w ^ (k + 1) * g *
          (Steinberg.x ⟨γ, δ, hγδ⟩ w ^ (k + 1))⁻¹ =
          Steinberg.x ⟨γ, δ, hγδ⟩ w * (Steinberg.x ⟨γ, δ, hγδ⟩ w ^ k * g *
            (Steinberg.x ⟨γ, δ, hγδ⟩ w ^ k)⁻¹) * (Steinberg.x ⟨γ, δ, hγδ⟩ w)⁻¹ := by
        rw [pow_succ']
        group
      rw [he]
      exact h
  have hinv : (Steinberg.x (R := R) ⟨γ, δ, hγδ⟩ w)⁻¹ = Steinberg.x ⟨γ, δ, hγδ⟩ w ^ (ℓ - 1) := by
    apply inv_eq_of_mul_eq_one_right
    rw [← pow_succ', Nat.sub_add_cancel (Fact.out : ℓ.Prime).one_lt.le, x_pow_char]
  apply Subgroup.mem_normalizer_iff.mpr
  intro g
  constructor
  · exact G.conj_root_mem P hK hγδ hw hδ
  · intro hg
    have h := hpow (ℓ - 1) _ hg
    rw [← hinv] at h
    have he : (Steinberg.x (R := R) ⟨γ, δ, hγδ⟩ w)⁻¹ *
        (Steinberg.x ⟨γ, δ, hγδ⟩ w * g * (Steinberg.x ⟨γ, δ, hγδ⟩ w)⁻¹) *
        (Steinberg.x ⟨γ, δ, hγδ⟩ w)⁻¹⁻¹ = g := by group
    rwa [he] at h

/-- Generators of the correction subgroup commute pairwise. -/
theorem gens_commute (hK : 5 ≤ K) (hopp : G.OppositeCommute K) {g g' : Steinberg K R}
    (hg : g ∈ G.wrongRoots P ∪ G.wrongDiagonals P)
    (hg' : g' ∈ G.wrongRoots P ∪ G.wrongDiagonals P) : Commute g g' := by
  -- off-diagonal against off-diagonal
  have off_off : ∀ {α β γ δ : Fin K} (hαβ : α ≠ β) (hγδ : γ ≠ δ) {a b : R}, a ∈ G.W →
      b ∈ G.W → P α ≠ G.σ a → P β = G.τ a → P γ ≠ G.σ b → P δ = G.τ b →
      Commute (Steinberg.x ⟨α, β, hαβ⟩ a) (Steinberg.x ⟨γ, δ, hγδ⟩ b) := by
    intro α β γ δ hαβ hγδ a b ha hb hσa hτa hσb hτb
    apply commute_roots
    · intro hc _
      exact G.mul_eq_zero a ha b hb (by
        change β = γ at hc
        rw [← hτa, hc]
        exact hσb)
    · intro hr _
      exact G.mul_eq_zero b hb a ha (by
        change α = δ at hr
        rw [← hτb, ← hr]
        exact hσa)
    · intro hc hr
      change β = γ at hc
      change α = δ at hr
      apply commute_opposite _ _ _ _ hc hr
      apply hopp _ _ _ _ ha _ hb
      · rw [← hτb, ← hr]
        exact Ne.symm hσa
      · exact G.mul_eq_zero a ha b hb (by rw [← hτa, hc]; exact hσb)
  -- off-diagonal against a diagonal generator
  have off_diag : ∀ {γ δ : Fin K} (hγδ : γ ≠ δ) {b' : R}, b' ∈ G.W → P γ ≠ G.σ b' →
      P δ = G.τ b' → ∀ {α β : Fin K} (hαβ : α ≠ β) {a b : R}, a ∈ G.W → b ∈ G.W →
      P α ≠ G.σ a → P α = G.τ b →
      Commute (Steinberg.x ⟨γ, δ, hγδ⟩ b')
        (bracket (Steinberg.x ⟨α, β, hαβ⟩ a) (Steinberg.x ⟨β, α, hαβ.symm⟩ b)) := by
    intro γ δ hγδ b' hb' hσb' hτb' α β hαβ a b ha hb hσa hτb
    have hba : b * a = 0 := G.mul_eq_zero b hb a ha (by rw [← hτb]; exact hσa)
    obtain ⟨β', h1, h2, h3, h4⟩ := exists_fresh hK α β γ δ
    rw [bracket_index hαβ (Ne.symm h1) h2 hba]
    apply CommutatorCalculus.commute_bracket_right
    · apply commute_roots
      · intro hc _
        exact G.mul_eq_zero b' hb' a ha (by
          change δ = α at hc
          rw [← hτb', hc]
          exact hσa)
      · intro hr _
        exact absurd hr (fun h => h3 h.symm)
      · intro _ hr
        exact absurd hr (fun h => h3 h.symm)
    · apply commute_roots
      · intro hc _
        exact absurd hc (fun h => h4 h.symm)
      · intro hr _
        exact G.mul_eq_zero b hb b' hb' (by
          change γ = α at hr
          rw [← hτb, ← hr]
          exact hσb')
      · intro hc _
        exact absurd hc (fun h => h4 h.symm)
  -- diagonal against diagonal
  have diag_diag : ∀ {α β : Fin K} (hαβ : α ≠ β) {a b : R}, a ∈ G.W → b ∈ G.W →
      P α ≠ G.σ a → P α = G.τ b → ∀ {γ δ : Fin K} (hγδ : γ ≠ δ) {c d : R}, c ∈ G.W →
      d ∈ G.W → P γ ≠ G.σ c → P γ = G.τ d →
      Commute (bracket (Steinberg.x ⟨α, β, hαβ⟩ a) (Steinberg.x ⟨β, α, hαβ.symm⟩ b))
        (bracket (Steinberg.x ⟨γ, δ, hγδ⟩ c) (Steinberg.x ⟨δ, γ, hγδ.symm⟩ d)) := by
    intro α β hαβ a b ha hb hσa hτb γ δ hγδ c d hc hd hσc hτd
    have hba : b * a = 0 := G.mul_eq_zero b hb a ha (by rw [← hτb]; exact hσa)
    have hdc : d * c = 0 := G.mul_eq_zero d hd c hc (by rw [← hτd]; exact hσc)
    obtain ⟨δ', k1, k2, k3, k4⟩ := exists_fresh hK γ δ α β
    obtain ⟨β', h1, h2, h3, h4⟩ := exists_fresh hK α β γ δ'
    rw [bracket_index hγδ (Ne.symm k1) k2 hdc, bracket_index hαβ (Ne.symm h1) h2 hba]
    apply CommutatorCalculus.commute_bracket_right
    · apply CommutatorCalculus.commute_bracket_left
      · apply commute_roots
        · intro hcol _
          exact absurd hcol h3
        · intro hrow _
          exact absurd hrow (fun h => k3 h.symm)
        · intro hcol _
          exact absurd hcol h3
      · apply commute_roots
        · intro hcol _
          exact G.mul_eq_zero b hb c hc (by
            change α = γ at hcol
            rw [← hτb, hcol]
            exact hσc)
        · intro hrow _
          exact absurd hrow h4
        · intro _ hrow
          exact absurd hrow h4
    · apply CommutatorCalculus.commute_bracket_left
      · apply commute_roots
        · intro hcol _
          exact absurd hcol h4
        · intro hrow _
          exact G.mul_eq_zero d hd a ha (by
            change α = γ at hrow
            rw [← hτd, ← hrow]
            exact hσa)
        · intro hcol _
          exact absurd hcol h4
      · apply commute_roots
        · intro hcol _
          exact absurd hcol (fun h => k3 h.symm)
        · intro hrow _
          exact absurd hrow h3
        · intro hcol _
          exact absurd hcol (fun h => k3 h.symm)
  rcases hg with ⟨α, β, hαβ, a, ha, hσa, hτa, rfl⟩ | ⟨α, β, hαβ, a, b, ha, hb, hσa, hτb, rfl⟩
  · rcases hg' with ⟨γ, δ, hγδ, c, hc, hσc, hτc, rfl⟩ | ⟨γ, δ, hγδ, c, d, hc, hd, hσc, hτd, rfl⟩
    · exact off_off hαβ hγδ ha hc hσa hτa hσc hτc
    · exact off_diag hαβ ha hσa hτa hγδ hc hd hσc hτd
  · rcases hg' with ⟨γ, δ, hγδ, c, hc, hσc, hτc, rfl⟩ | ⟨γ, δ, hγδ, c, d, hc, hd, hσc, hτd, rfl⟩
    · exact (off_diag hγδ hc hσc hτc hαβ ha hb hσa hτb).symm
    · exact diag_diag hαβ ha hb hσa hτb hγδ hc hd hσc hτd

end PhaseGrading
end Kernel
end
end AllPrimeGroups
