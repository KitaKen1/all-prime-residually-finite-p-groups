import AllPrimeGroups.SteinbergPresentation
import AllPrimeGroups.RelativeTorsion

/-! Long representatives of truncation kernels (manuscript Lemma 22.1).

Let `S` generate the two-sided ideal killed by a quotient of the coefficient ring. Suppose
every element of `S` factors as `b * c` where all left multiples of `b` and all right multiples
of `c` are sums of elements of a set `L` and their negatives. Then every element of the stable
Steinberg group killed by the quotient is represented by a product of roots whose parameters
lie in `L`, and inverses of such roots. For the constructed algebra, `S` consists of the words
of length at least 2M and `L` of the nonzero word classes of length at least M; that instance is
not made here.

A conjugate of `x_ij(b c)` becomes, after one coordinate h is added, the commutator of the
conjugates of `x_ih(b)` and `x_hj(c)`. Those conjugates lie in a column strip and a row strip
whose parameters stay among the left multiples of `b` and the right multiples of `c`. -/

namespace AllPrimeGroups
noncomputable section
namespace Kernel
open Classical
variable {n : ℕ} {R : Type*} [Ring R]

/-- The subgroup generated by roots whose parameters lie in a set. -/
def rootsIn (n : ℕ) (T : Set R) : Subgroup (Steinberg n R) :=
  Subgroup.closure {g | ∃ (q : Root n) (a : R), a ∈ T ∧ g = Steinberg.x q a}

theorem x_mem_rootsIn {T : Set R} (q : Root n) {a : R} (ha : a ∈ AddSubgroup.closure T) :
    Steinberg.x q a ∈ rootsIn n T := by
  induction ha using AddSubgroup.closure_induction with
  | mem a ha => exact Subgroup.subset_closure ⟨q, a, ha, rfl⟩
  | zero =>
    rw [Steinberg.x_zero]
    exact (rootsIn n T).one_mem
  | add a b _ _ ha hb =>
    rw [Steinberg.x_add]
    exact (rootsIn n T).mul_mem ha hb
  | neg a _ ha =>
    rw [Steinberg.x_neg]
    exact (rootsIn n T).inv_mem ha

theorem rootsIn_le {T L : Set R} (h : T ⊆ AddSubgroup.closure L) :
    rootsIn n T ≤ rootsIn n L := by
  apply (Subgroup.closure_le _).mpr
  rintro _ ⟨q, a, ha, rfl⟩
  exact x_mem_rootsIn q (h ha)

/-- A strip generated by roots whose parameters lie in a set. -/
def StripIn (H L : Finset (Fin n)) (hd : Disjoint H L) (T : Set R) :
    Subgroup (Steinberg n R) :=
  Subgroup.closure {g | ∃ (q : RectIndex H L) (a : R), a ∈ T ∧
    g = Steinberg.x (rectPosition H L hd q) a}

theorem stripIn_le_rootsIn (H L : Finset (Fin n)) (hd : Disjoint H L) (T : Set R) :
    StripIn H L hd T ≤ rootsIn n T := by
  apply (Subgroup.closure_le _).mpr
  rintro _ ⟨q, a, ha, rfl⟩
  exact Subgroup.subset_closure ⟨_, a, ha, rfl⟩

theorem rectPosition_mem_stripIn (H L : Finset (Fin n)) (hd : Disjoint H L) (T : Set R)
    (q : RectIndex H L) {a : R} (ha : a ∈ T) :
    Steinberg.x (rectPosition H L hd q) a ∈ StripIn H L hd T :=
  Subgroup.subset_closure ⟨q, a, ha, rfl⟩

/-- Roots inside the row set act on a strip by left multiplication of parameters. -/
theorem left_conjugate_stripIn (H L : Finset (Fin n)) (hd : Disjoint H L) (T : Set R)
    (hT : ∀ r : R, ∀ t ∈ T, r * t ∈ T)
    (p : Root n) (hr : p.row ∈ H) (hc : p.col ∈ H) (a : R)
    {g : Steinberg n R} (hg : g ∈ StripIn H L hd T) :
    Steinberg.x p a * g * (Steinberg.x p a)⁻¹ ∈ StripIn H L hd T := by
  have Hle : StripIn H L hd T ≤
      (StripIn H L hd T).comap (MulAut.conj (Steinberg.x p a)).toMonoidHom := by
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨q, b, hb, rfl⟩
    change Steinberg.x p a * Steinberg.x (rectPosition H L hd q) b * (Steinberg.x p a)⁻¹ ∈
      StripIn H L hd T
    have hrow : p.row ≠ q.2.val := fun he =>
      Finset.disjoint_left.mp hd hr (he.symm ▸ q.2.property)
    by_cases he : p.col = q.1.val
    · have hp : p = ⟨p.row, q.1.val, he ▸ p.ne⟩ := by cases p; cases he; rfl
      rw [hp]
      dsimp only [rectPosition]
      rw [Steinberg.conjugate_chain p.row q.1.val q.2.val (he ▸ p.ne) (rectPosition H L hd q).ne
        hrow a b]
      apply (StripIn H L hd T).mul_mem
      · exact rectPosition_mem_stripIn H L hd T (⟨p.row, hr⟩, q.2) (hT a b hb)
      · exact rectPosition_mem_stripIn H L hd T q hb
    · rw [Steinberg.conjugate_commute p (rectPosition H L hd q) he hrow]
      exact rectPosition_mem_stripIn H L hd T q hb
  exact Hle hg

/-- Roots inside the column set act on a strip by right multiplication of parameters. -/
theorem right_conjugate_stripIn (H L : Finset (Fin n)) (hd : Disjoint H L) (T : Set R)
    (hT : ∀ r : R, ∀ t ∈ T, t * r ∈ T)
    (p : Root n) (hr : p.row ∈ L) (hc : p.col ∈ L) (a : R)
    {g : Steinberg n R} (hg : g ∈ StripIn H L hd T) :
    Steinberg.x p a * g * (Steinberg.x p a)⁻¹ ∈ StripIn H L hd T := by
  have Hle : StripIn H L hd T ≤
      (StripIn H L hd T).comap (MulAut.conj (Steinberg.x p a)).toMonoidHom := by
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨q, b, hb, rfl⟩
    change Steinberg.x p a * Steinberg.x (rectPosition H L hd q) b * (Steinberg.x p a)⁻¹ ∈
      StripIn H L hd T
    have hcol : p.col ≠ q.1.val := fun he =>
      Finset.disjoint_left.mp hd q.1.property (he ▸ hc)
    by_cases he : p.row = q.2.val
    · have hp : p = ⟨q.2.val, p.col, he ▸ p.ne⟩ := by cases p; cases he; rfl
      rw [hp]
      dsimp only [rectPosition]
      rw [Steinberg.conjugate_reverse q.1.val q.2.val p.col (rectPosition H L hd q).ne
        (he ▸ p.ne) hcol.symm b a]
      apply (StripIn H L hd T).mul_mem
      · apply rectPosition_mem_stripIn H L hd T (q.1, ⟨p.col, hc⟩)
        rw [← mul_neg]
        exact hT (-a) b hb
      · exact rectPosition_mem_stripIn H L hd T q hb
    · rw [Steinberg.conjugate_commute p (rectPosition H L hd q) hcol he]
      exact rectPosition_mem_stripIn H L hd T q hb
  exact Hle hg

/-- Elements supported away from a coordinate normalize a column strip into that coordinate
whose parameters form a set closed under left multiplication. -/
theorem away_le_column_normalizer_in (t : Fin n) (T : Set R)
    (hT : ∀ r : R, ∀ s ∈ T, r * s ∈ T) :
    away (R := R) t ≤ Subgroup.normalizer
      (StripIn (awayCoordinates t) {t} (away_disjoint t) T : Set (Steinberg n R)) := by
  apply (Subgroup.closure_le _).mpr
  rintro g ⟨p, a, hpt, hct, rfl⟩
  have hr : p.row ∈ awayCoordinates t := by simp [awayCoordinates, hpt]
  have hc : p.col ∈ awayCoordinates t := by simp [awayCoordinates, hct]
  apply Subgroup.mem_normalizer_iff.mpr
  intro y
  constructor
  · exact left_conjugate_stripIn _ _ _ T hT p hr hc a
  · intro hy
    have H := left_conjugate_stripIn _ _ _ T hT p hr hc (-a) hy
    simpa only [Steinberg.x_neg, inv_inv, mul_assoc, inv_mul_cancel_left, mul_inv_cancel_right,
      inv_mul_cancel, mul_one] using H

/-- Elements supported away from a coordinate normalize a row strip out of that coordinate
whose parameters form a set closed under right multiplication. -/
theorem away_le_row_normalizer_in (t : Fin n) (T : Set R)
    (hT : ∀ r : R, ∀ s ∈ T, s * r ∈ T) :
    away (R := R) t ≤ Subgroup.normalizer
      (StripIn {t} (awayCoordinates t) (away_disjoint t).symm T : Set (Steinberg n R)) := by
  apply (Subgroup.closure_le _).mpr
  rintro g ⟨p, a, hpt, hct, rfl⟩
  have hr : p.row ∈ awayCoordinates t := by simp [awayCoordinates, hpt]
  have hc : p.col ∈ awayCoordinates t := by simp [awayCoordinates, hct]
  apply Subgroup.mem_normalizer_iff.mpr
  intro y
  constructor
  · exact right_conjugate_stripIn _ _ _ T hT p hr hc a
  · intro hy
    have H := right_conjugate_stripIn _ _ _ T hT p hr hc (-a) hy
    simpa only [Steinberg.x_neg, inv_inv, mul_assoc, inv_mul_cancel_left, mul_inv_cancel_right,
      inv_mul_cancel, mul_one] using H

/-- After one coordinate is added, a conjugate of a root with parameter `b * c` is a product of
roots whose parameters are left multiples of `b` or right multiples of `c`. -/
theorem pad_conjugate_mem (g : Steinberg n R) (q : Root n) (b c : R) :
    padSteinberg (g * Steinberg.x q (b * c) * g⁻¹) ∈
      rootsIn (n + 1) (Set.range (fun r : R => r * b) ∪ Set.range (fun r : R => c * r)) := by
  let h := spareCoordinate n
  let i := coordinateIndex n q.row
  let j := coordinateIndex n q.col
  have hih : i ≠ h := coordinateIndex_ne_spare q.row
  have hhj : h ≠ j := (coordinateIndex_ne_spare q.col).symm
  have hij : i ≠ j := fun he => q.ne (coordinateIndex_injective n he)
  let X := Steinberg.x (R := R) ⟨i, h, hih⟩ b
  let Y := Steinberg.x (R := R) ⟨h, j, hhj⟩ c
  have hx : padSteinberg (Steinberg.x q (b * c)) = bracket X Y := by
    rw [Steinberg.x_mul i h j hih hhj hij b c]
    rfl
  let G := padSteinberg g
  have hG : G ∈ away h := pad_mem_away g
  have hX : G * X * G⁻¹ ∈ StripIn (awayCoordinates h) {h} (away_disjoint h)
      (Set.range (fun r : R => r * b)) := by
    have hmem : X ∈ StripIn (awayCoordinates h) {h} (away_disjoint h)
        (Set.range (fun r : R => r * b)) :=
      rectPosition_mem_stripIn _ _ _ _
        (⟨i, by simp [awayCoordinates, hih]⟩, ⟨h, Finset.mem_singleton_self h⟩) ⟨1, one_mul b⟩
    refine (Subgroup.mem_normalizer_iff.mp
      (away_le_column_normalizer_in h _ ?_ hG) X).mp hmem
    rintro r _ ⟨s, rfl⟩
    exact ⟨r * s, mul_assoc r s b⟩
  have hY : G * Y * G⁻¹ ∈ StripIn {h} (awayCoordinates h) (away_disjoint h).symm
      (Set.range (fun r : R => c * r)) := by
    have hmem : Y ∈ StripIn {h} (awayCoordinates h) (away_disjoint h).symm
        (Set.range (fun r : R => c * r)) :=
      rectPosition_mem_stripIn _ _ _ _
        (⟨h, Finset.mem_singleton_self h⟩, ⟨j, by simp [awayCoordinates, hhj.symm]⟩)
        ⟨1, mul_one c⟩
    refine (Subgroup.mem_normalizer_iff.mp
      (away_le_row_normalizer_in h _ ?_ hG) Y).mp hmem
    rintro r _ ⟨s, rfl⟩
    exact ⟨s * r, (mul_assoc c s r).symm⟩
  let U := Set.range (fun r : R => r * b) ∪ Set.range (fun r : R => c * r)
  have hsubX : Set.range (fun r : R => r * b) ⊆ AddSubgroup.closure U :=
    fun a ha => AddSubgroup.subset_closure (Or.inl ha)
  have hsubY : Set.range (fun r : R => c * r) ⊆ AddSubgroup.closure U :=
    fun a ha => AddSubgroup.subset_closure (Or.inr ha)
  have hX' : G * X * G⁻¹ ∈ rootsIn (n + 1) U :=
    rootsIn_le hsubX (stripIn_le_rootsIn _ _ _ _ hX)
  have hY' : G * Y * G⁻¹ ∈ rootsIn (n + 1) U :=
    rootsIn_le hsubY (stripIn_le_rootsIn _ _ _ _ hY)
  have he : padSteinberg (g * Steinberg.x q (b * c) * g⁻¹) =
      bracket (G * X * G⁻¹) (G * Y * G⁻¹) := by
    rw [map_mul, map_mul, map_inv, hx]
    simp only [G, bracket, mul_assoc, mul_inv_rev, inv_inv, inv_mul_cancel_left]
  rw [he]
  unfold bracket
  exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.mul_mem _ hX' hY')
    (Subgroup.inv_mem _ hX')) (Subgroup.inv_mem _ hY')

/-- Manuscript Lemma 22.1 at finite rank: after one coordinate is added, the normal closure of
the roots with parameters in `S` consists of products of roots with parameters in `L`. -/
theorem pad_mem_rootsIn {S L : Set R}
    (hS : ∀ a ∈ S, ∃ b c : R, a = b * c ∧ (∀ r : R, r * b ∈ AddSubgroup.closure L) ∧
      ∀ r : R, c * r ∈ AddSubgroup.closure L)
    {g : Steinberg n R} (hg : g ∈ SteinbergQuotient.normal (n := n) S) :
    padSteinberg g ∈ rootsIn (n + 1) L := by
  have H : SteinbergQuotient.normal (n := n) S ≤ (rootsIn (n + 1) L).comap padSteinberg := by
    apply (Subgroup.closure_le _).mpr
    intro y hy
    obtain ⟨x, ⟨q, a, ha, rfl⟩, hconj⟩ := Group.mem_conjugatesOfSet_iff.mp hy
    obtain ⟨k, rfl⟩ := isConj_iff.mp hconj
    obtain ⟨b, c, rfl, hb, hc⟩ := hS a ha
    apply rootsIn_le _ (pad_conjugate_mem k q b c)
    rintro _ (⟨r, rfl⟩ | ⟨r, rfl⟩)
    · exact hb r
    · exact hc r
  exact H hg

end Kernel

namespace SteinbergQuotient
variable {n : ℕ} {R : Type*} [Ring R] (S : Set R)

/-- In rank at least five, the kernel of the coefficient quotient map is the normal closure of
the roots with parameters in `S`. -/
theorem mem_normal_of_map_eq_one (hn : 5 ≤ n) {g : Steinberg n R}
    (hg : Steinberg.map (coeffIdeal S).ringCon.mk' g = 1) : g ∈ normal (n := n) S := by
  have h1 : toCoeff S (proj S g) = 1 := by
    rw [toCoeff_proj]
    exact hg
  have h2 := DFunLike.congr_fun (fromCoeff_comp_toCoeff S hn) (proj S g)
  rw [MonoidHom.comp_apply, h1, map_one, MonoidHom.id_apply] at h2
  exact (QuotientGroup.eq_one_iff g).mp h2.symm

end SteinbergQuotient

namespace Stable
variable {R : Type*} [Ring R]

/-- Manuscript Lemma 22.1: an element of the stable Steinberg group killed by the quotient by
the two-sided ideal generated by `S` has a representative in the subgroup generated by roots with
parameters in `L`. -/
theorem exists_long_representative {S L : Set R}
    (hS : ∀ a ∈ S, ∃ b c : R, a = b * c ∧ (∀ r : R, r * b ∈ AddSubgroup.closure L) ∧
      ∀ r : R, c * r ∈ AddSubgroup.closure L)
    (z : StableSteinberg R) (hz : map (SteinbergQuotient.coeffIdeal S).ringCon.mk' z = 1) :
    ∃ (m : ℕ) (u : Steinberg m R), of R m u = z ∧ u ∈ Kernel.rootsIn m L := by
  obtain ⟨n₀, u₀, hzu⟩ := Chain.exists_stage (steinbergStep R) z
  have hzu' : z = of R n₀ u₀ := hzu
  have hn₀ : n₀ ≤ max n₀ 5 := le_max_left _ _
  have hn5 : 5 ≤ max n₀ 5 := le_max_right _ _
  have hu₁ := of_castLE R hn₀ u₀
  have hε' : of _ (max n₀ 5) (Steinberg.map (SteinbergQuotient.coeffIdeal S).ringCon.mk'
      (Steinberg.coordinateMap (Fin.castLE hn₀) (Fin.castLE_injective _) u₀)) = 1 := by
    rw [← map_of, hu₁, ← hzu']
    exact hz
  obtain ⟨m, hnm, hm⟩ := (of_eq_one_iff _ (max n₀ 5) _).mp hε'
  rw [connect_eq_castLE, ← Steinberg.coordinateMap_ringMap] at hm
  have hu := (of_castLE R hnm
    (Steinberg.coordinateMap (Fin.castLE hn₀) (Fin.castLE_injective _) u₀)).trans hu₁
  generalize Steinberg.coordinateMap (Fin.castLE hnm) (Fin.castLE_injective _)
    (Steinberg.coordinateMap (Fin.castLE hn₀) (Fin.castLE_injective _) u₀) = u at hm hu
  have hnormal := SteinbergQuotient.mem_normal_of_map_eq_one S (hn5.trans hnm) hm
  refine ⟨m + 1, Kernel.padSteinberg u, ?_, Kernel.pad_mem_rootsIn hS hnormal⟩
  rw [show of R (m + 1) (Kernel.padSteinberg u) = of R m u from
    Chain.of_step (steinbergStep R) m u, hu, hzu']

end Stable
end
end AllPrimeGroups
