import AllPrimeGroups.CosetTransport
import AllPrimeGroups.LocalColumns
import Mathlib.GroupTheory.PresentedGroup

/-! The presentation of GL_m by relations on at most five coordinates (manuscript Lemma 11.1).

Generators are the elementary matrices and the diagonal units in one position. `Pres m B` is
the group generated by them subject to every word that is supported on at most five coordinates
and evaluates to the identity matrix. This file sets up the presentation, the principle that
equal matrix words on at most five coordinates are equal in `Pres m B`, and the case m ≤ 5. -/

namespace AllPrimeGroups
namespace GLPres

open LocalGL

variable {B : Type*} [Ring B]

/-- Generators: elementary matrices and diagonal units in one position. -/
inductive Gen (m : ℕ) (B : Type*) [Ring B] : Type _
  | elem : Root m → B → Gen m B
  | diag : Fin m → Bˣ → Gen m B

variable {m : ℕ}

/-- The matrix of a generator. -/
def Gen.val : Gen m B → (Matrix (Fin m) (Fin m) B)ˣ
  | .elem p a => Elementary.e p a
  | .diag i u => LocalGL.d i u

/-- The coordinates of a generator. -/
def Gen.supp : Gen m B → Finset (Fin m)
  | .elem p _ => {p.row, p.col}
  | .diag i _ => {i}

/-- Evaluation of words. -/
def ev : FreeGroup (Gen m B) →* (Matrix (Fin m) (Fin m) B)ˣ := FreeGroup.lift Gen.val

@[simp] theorem ev_of (g : Gen m B) : ev (FreeGroup.of g) = g.val := FreeGroup.lift_apply_of

/-- Words supported on a set of coordinates. -/
def supported (T : Finset (Fin m)) : Subgroup (FreeGroup (Gen m B)) :=
  Subgroup.closure (FreeGroup.of '' {g | g.supp ⊆ T})

theorem of_mem_supported {T : Finset (Fin m)} {g : Gen m B} (h : g.supp ⊆ T) :
    FreeGroup.of g ∈ supported T :=
  Subgroup.subset_closure ⟨g, h, rfl⟩

theorem supported_mono {T T' : Finset (Fin m)} (h : T ⊆ T') :
    supported (B := B) T ≤ supported T' :=
  Subgroup.closure_mono (Set.image_mono fun _ hg => Finset.Subset.trans hg h)

/-- True matrix relations supported on at most five coordinates. -/
def rels : Set (FreeGroup (Gen m B)) :=
  {w | ∃ T : Finset (Fin m), T.card ≤ 5 ∧ w ∈ supported T ∧ ev w = 1}

/-- The group presented by the relations on at most five coordinates. -/
abbrev Pres (m : ℕ) (B : Type*) [Ring B] := PresentedGroup (rels (m := m) (B := B))

/-- The words of `Pres`. -/
abbrev mk : FreeGroup (Gen m B) →* Pres m B := PresentedGroup.mk _

/-- The map to matrices. -/
def π : Pres m B →* (Matrix (Fin m) (Fin m) B)ˣ :=
  PresentedGroup.toGroup (f := Gen.val) (fun _ hw => by
    obtain ⟨T, -, -, h⟩ := hw
    exact h)

theorem π_comp_mk : (π (B := B) (m := m)).comp mk = ev := by
  apply FreeGroup.ext_hom
  intro g
  rw [ev_of]
  show π (PresentedGroup.of g) = g.val
  exact PresentedGroup.toGroup.of _

@[simp] theorem π_mk (w : FreeGroup (Gen m B)) : π (mk w) = ev w :=
  DFunLike.congr_fun π_comp_mk w

/-- Equal matrix words supported on at most five coordinates are equal in `Pres`. -/
theorem mk_eq_of_ev_eq {T : Finset (Fin m)} (hT : T.card ≤ 5) {w₁ w₂ : FreeGroup (Gen m B)}
    (h₁ : w₁ ∈ supported T) (h₂ : w₂ ∈ supported T) (he : ev w₁ = ev w₂) :
    mk w₁ = mk w₂ := by
  have hrel : w₁⁻¹ * w₂ ∈ rels :=
    ⟨T, hT, Subgroup.mul_mem _ (Subgroup.inv_mem _ h₁) h₂, by rw [map_mul, map_inv, he,
      inv_mul_cancel]⟩
  have h1 : mk (w₁⁻¹ * w₂) = 1 :=
    (QuotientGroup.eq_one_iff _).mpr (Subgroup.subset_normalClosure hrel)
  rw [map_mul, map_inv, inv_mul_eq_one] at h1
  exact h1

theorem supported_univ : supported (B := B) (Finset.univ : Finset (Fin m)) = ⊤ := by
  rw [eq_top_iff, ← FreeGroup.closure_range_of]
  apply Subgroup.closure_mono
  rintro _ ⟨g, rfl⟩
  exact ⟨g, Finset.subset_univ _, rfl⟩

/-- Manuscript Lemma 11.1 for at most five coordinates: every relation is included. -/
theorem π_injective_of_le (hm : m ≤ 5) : Function.Injective (π (m := m) (B := B)) := by
  rw [← MonoidHom.ker_eq_bot_iff, eq_bot_iff]
  intro x hx
  obtain ⟨w, rfl⟩ := PresentedGroup.mk_surjective _ x
  rw [MonoidHom.mem_ker, π_mk] at hx
  have hT : (Finset.univ : Finset (Fin m)).card ≤ 5 := by
    rw [Finset.card_univ, Fintype.card_fin]
    exact hm
  have := mk_eq_of_ev_eq (B := B) (w₁ := w) (w₂ := 1) hT (by rw [supported_univ]; trivial)
    (Subgroup.one_mem _) (by rw [hx, map_one])
  rw [this, map_one]
  exact Subgroup.one_mem _

theorem ev_range_eq_GE : (ev (m := m) (B := B)).range = GE m B := by
  rw [ev, FreeGroup.range_lift_eq_closure]
  apply le_antisymm
  · apply Subgroup.closure_le _ |>.mpr
    rintro _ ⟨g, rfl⟩
    cases g with
    | elem p a => exact e_mem_GE p a
    | diag i u => exact d_mem_GE i u
  · apply Subgroup.closure_le _ |>.mpr
    rintro _ (⟨p, a, rfl⟩ | ⟨i, u, rfl⟩)
    · exact Subgroup.subset_closure ⟨Gen.elem p a, rfl⟩
    · exact Subgroup.subset_closure ⟨Gen.diag i u, rfl⟩

/-- Over a field-augmented ring with nil augmentation kernel the presentation maps onto GL. -/
theorem π_surjective {K : Type*} [Field K] (ε : B →+* K) (hunit : ∀ b : B, ε b ≠ 0 → IsUnit b) :
    Function.Surjective (π (m := m) (B := B)) := by
  intro g
  have hg : g ∈ (ev (m := m) (B := B)).range := by
    rw [ev_range_eq_GE]
    exact mem_GE ε hunit m g
  obtain ⟨w, rfl⟩ := hg
  exact ⟨mk w, π_mk w⟩

end GLPres
end AllPrimeGroups
