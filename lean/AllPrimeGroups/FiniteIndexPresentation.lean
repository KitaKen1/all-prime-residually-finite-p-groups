import Mathlib.GroupTheory.FinitelyPresentedGroup
import Mathlib.GroupTheory.FreeGroup.NielsenSchreier
import Mathlib.GroupTheory.FreeGroup.Reduce
import Mathlib.GroupTheory.Schreier

/-! Finite-index subgroups of finitely presented groups are finitely presented
(manuscript Lemma 3.1).

The inverse image in the free group is free by mathlib's Nielsen--Schreier theorem and
finitely generated by Schreier's lemma. Its relators are the conjugates of the original
relators by a finite set of coset representatives. -/

namespace AllPrimeGroups

/-- A finitely generated free group has a finite basis. -/
theorem finite_of_fg_freeGroup (α : Type*) [hfg : Group.FG (FreeGroup α)] : Finite α := by
  classical
  obtain ⟨S, hS, hSfin⟩ := Group.fg_iff.mp hfg
  let A : Set α := ⋃ w ∈ S, {a | a ∈ (FreeGroup.toWord w).map Prod.fst}
  have hA : A.Finite := hSfin.biUnion fun w _ => ((FreeGroup.toWord w).map Prod.fst).finite_toSet
  suffices h : A = Set.univ from Set.finite_univ_iff.mp (h ▸ hA)
  by_contra hne
  obtain ⟨a, ha⟩ : ∃ a, a ∉ A := by
    by_contra h
    exact hne (Set.eq_univ_of_forall fun x => by_contra fun hx => h ⟨x, hx⟩)
  let f : α → Multiplicative ℤ := fun b => if b = a then Multiplicative.ofAdd 1 else 1
  let ψ : FreeGroup α →* Multiplicative ℤ := FreeGroup.lift f
  have hker : S ⊆ ψ.ker := by
    intro w hw
    have hw' : ψ w = ψ (FreeGroup.mk (FreeGroup.toWord w)) := by rw [FreeGroup.mk_toWord]
    rw [SetLike.mem_coe, MonoidHom.mem_ker, hw']
    change FreeGroup.lift f (FreeGroup.mk (FreeGroup.toWord w)) = 1
    rw [FreeGroup.lift_mk]
    apply List.prod_eq_one
    intro x hx
    obtain ⟨⟨b, s⟩, hbs, rfl⟩ := List.mem_map.mp hx
    have hb : b ≠ a := by
      rintro rfl
      exact ha (Set.mem_biUnion hw (List.mem_map.mpr ⟨(b, s), hbs, rfl⟩))
    cases s <;> simp [f, hb]
  have htop : (⊤ : Subgroup (FreeGroup α)) ≤ ψ.ker := hS ▸ (Subgroup.closure_le _).mpr hker
  have h1 : ψ (FreeGroup.of a) = 1 := htop (Subgroup.mem_top _)
  have h2 : ψ (FreeGroup.of a) = Multiplicative.ofAdd 1 := by
    change FreeGroup.lift f (FreeGroup.of a) = _
    rw [FreeGroup.lift_apply_of]
    simp [f]
  rw [h2] at h1
  exact one_ne_zero (ofAdd_eq_one.mp h1)

/-- A finitely generated free group is finitely presented. -/
theorem isFinitelyPresented_of_isFreeGroup_fg (F : Type*) [Group F] [IsFreeGroup F]
    [Group.FG F] : Group.IsFinitelyPresented F := by
  let e := IsFreeGroup.toFreeGroup F
  have : Group.FG (FreeGroup (IsFreeGroup.Generators F)) :=
    Group.fg_of_surjective (f := e.toMonoidHom) e.surjective
  have : Finite (IsFreeGroup.Generators F) := finite_of_fg_freeGroup _
  exact Group.IsFinitelyPresented.equiv e.symm

/-- Rewriting the relators: the kernel of the restricted homomorphism is the normal closure,
inside the finite-index inverse image, of finitely many conjugates of the given relators. -/
theorem ker_subgroupComap_isFinitelyNormallyGenerated {F G : Type*} [Group F] [Group G]
    (φ : F →* G) (H : Subgroup G) [(H.comap φ).FiniteIndex]
    (hN : φ.ker.IsFinitelyNormallyGenerated) :
    (φ.subgroupComap H).ker.IsFinitelyNormallyGenerated := by
  classical
  obtain ⟨S, hSfin, hS⟩ := hN
  have hker_le : φ.ker ≤ H.comap φ := fun x hx => by
    rw [Subgroup.mem_comap, MonoidHom.mem_ker.mp hx]
    exact H.one_mem
  have hSker : ∀ s ∈ S, s ∈ φ.ker := fun s hs => hS ▸ Subgroup.subset_normalClosure hs
  have hmem : ∀ (q : F ⧸ H.comap φ) (s : S), q.out⁻¹ * s.val * q.out ∈ H.comap φ := by
    intro q s
    apply hker_le
    have h := (inferInstance : φ.ker.Normal).conj_mem _ (hSker s.val s.property) q.out⁻¹
    simpa only [inv_inv] using h
  let rel : (F ⧸ H.comap φ) × S → H.comap φ := fun qs => ⟨_, hmem qs.1 qs.2⟩
  have : Finite S := hSfin.to_subtype
  refine ⟨Set.range rel, Set.finite_range rel, le_antisymm ?_ ?_⟩
  · apply Subgroup.normalClosure_le_normal
    rintro _ ⟨⟨q, s⟩, rfl⟩
    rw [SetLike.mem_coe, MonoidHom.mem_ker]
    apply Subtype.ext
    change φ (q.out⁻¹ * s.val * q.out) = 1
    rw [map_mul, map_mul, MonoidHom.mem_ker.mp (hSker s.val s.property), mul_one, ← map_mul,
      inv_mul_cancel, map_one]
  · have key : Subgroup.normalClosure S ≤
        (Subgroup.normalClosure (Set.range rel)).map (H.comap φ).subtype := by
      apply (Subgroup.closure_le _).mpr
      intro y hy
      obtain ⟨s, hs, hconj⟩ := Group.mem_conjugatesOfSet_iff.mp hy
      obtain ⟨c, rfl⟩ := isConj_iff.mp hconj
      obtain ⟨h, hh⟩ := QuotientGroup.mk_out_eq_mul (H.comap φ) c⁻¹
      have hc : c = h.val * (QuotientGroup.mk c⁻¹ : F ⧸ H.comap φ).out⁻¹ := by
        rw [hh, mul_inv_rev, inv_inv, mul_inv_cancel_left]
      refine ⟨h * rel (QuotientGroup.mk c⁻¹, ⟨s, hs⟩) * h⁻¹, ?_, ?_⟩
      · exact Subgroup.normalClosure_normal.conj_mem _
          (Subgroup.subset_normalClosure (Set.mem_range_self _)) h
      · change h.val * ((QuotientGroup.mk c⁻¹ : F ⧸ H.comap φ).out⁻¹ * s *
            (QuotientGroup.mk c⁻¹ : F ⧸ H.comap φ).out) * h.val⁻¹ = c * s * c⁻¹
        conv_rhs => rw [hc]
        simp only [mul_inv_rev, inv_inv, mul_assoc]
    intro x hx
    have hx' : x.val ∈ Subgroup.normalClosure S := by
      rw [hS, MonoidHom.mem_ker]
      exact congrArg Subtype.val (MonoidHom.mem_ker.mp hx)
    obtain ⟨m, hm, hmx⟩ := key hx'
    have hmx' : m = x := Subtype.ext hmx
    exact hmx' ▸ hm

/-- Manuscript Lemma 3.1: a subgroup of finite index in a finitely presented group is
finitely presented. -/
theorem isFinitelyPresented_of_finiteIndex {G : Type*} [Group G]
    [hG : Group.IsFinitelyPresented G] (H : Subgroup G) [H.FiniteIndex] :
    Group.IsFinitelyPresented H := by
  obtain ⟨n, φ, hφ, hN⟩ := hG.out
  have hindex : (H.comap φ).FiniteIndex :=
    ⟨by rw [Subgroup.index_comap_of_surjective H hφ]; exact Subgroup.FiniteIndex.index_ne_zero⟩
  have hfg : Group.FG (H.comap φ) := Subgroup.fg_of_index_ne_zero _
  have hfp : Group.IsFinitelyPresented (H.comap φ) :=
    isFinitelyPresented_of_isFreeGroup_fg (H.comap φ)
  exact Group.IsFinitelyPresented.of_surjective (φ.subgroupComap H)
    (φ.subgroupComap_surjective H hφ)
    (ker_subgroupComap_isFinitelyNormallyGenerated φ H hN)

end AllPrimeGroups
