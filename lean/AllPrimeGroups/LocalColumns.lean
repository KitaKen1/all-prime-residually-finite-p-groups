import AllPrimeGroups.MatrixModel
import AllPrimeGroups.Stabilization
import AllPrimeGroups.NilAugmentation
import Mathlib.Data.Matrix.Mul
import Mathlib.LinearAlgebra.Matrix.Notation

/-! Columns and elementary generation over a local ring (manuscript Section 11, first
paragraph).

For a ring B, a column v whose i-th entry is a unit is the i-th column of the invertible matrix
obtained from the identity by replacing its i-th column by v. That matrix is a product of
elementary matrices in column i and a diagonal unit in position i. A matrix fixing the last
standard column is the padding of its upper-left block times the row strip of its last row.

Over an algebra with a field augmentation whose kernel is nil, an entry is a unit exactly when
its augmentation is nonzero, so every invertible matrix is a product of elementary and diagonal
matrices (`mem_GE`). -/

namespace AllPrimeGroups
namespace LocalGL

open Matrix

variable {B : Type*} [Ring B]

section Diagonal
variable {m : ℕ}

/-- The diagonal unit with `u` in position `i` and `1` elsewhere. -/
def d (i : Fin m) (u : Bˣ) : (Matrix (Fin m) (Fin m) B)ˣ where
  val := Matrix.diagonal (Function.update (1 : Fin m → B) i (u : B))
  inv := Matrix.diagonal (Function.update (1 : Fin m → B) i ((u⁻¹ : Bˣ) : B))
  val_inv := by
    rw [Matrix.diagonal_mul_diagonal, ← Matrix.diagonal_one]
    congr 1
    funext l
    by_cases hl : l = i
    · subst hl
      simp
    · simp [Function.update_of_ne hl]
  inv_val := by
    rw [Matrix.diagonal_mul_diagonal, ← Matrix.diagonal_one]
    congr 1
    funext l
    by_cases hl : l = i
    · subst hl
      simp
    · simp [Function.update_of_ne hl]

theorem coe_d (i : Fin m) (u : Bˣ) :
    ((d i u : (Matrix (Fin m) (Fin m) B)ˣ) : Matrix (Fin m) (Fin m) B) =
      Matrix.diagonal (Function.update (1 : Fin m → B) i (u : B)) := rfl

end Diagonal

section Generators

/-- The subgroup generated by elementary matrices and diagonal units in one position. -/
def GE (m : ℕ) (B : Type*) [Ring B] : Subgroup (Matrix (Fin m) (Fin m) B)ˣ :=
  Subgroup.closure ({g | ∃ (p : Root m) (a : B), Elementary.e p a = g} ∪
    {g | ∃ (i : Fin m) (u : Bˣ), d i u = g})

variable {m : ℕ}

theorem e_mem_GE (p : Root m) (a : B) : Elementary.e p a ∈ GE m B :=
  Subgroup.subset_closure (Or.inl ⟨p, a, rfl⟩)

theorem d_mem_GE (i : Fin m) (u : Bˣ) : d i u ∈ GE m B :=
  Subgroup.subset_closure (Or.inr ⟨i, u, rfl⟩)

end Generators

section ReplaceColumn
variable {m : ℕ}

theorem d_mulVec (i : Fin m) (u : Bˣ) (x : Fin m → B) :
    ((d i u : (Matrix (Fin m) (Fin m) B)ˣ) : Matrix (Fin m) (Fin m) B) *ᵥ x =
      fun a => if a = i then (u : B) * x a else x a := by
  funext a
  rw [coe_d, Matrix.mulVec_diagonal]
  by_cases ha : a = i
  · subst ha
    simp
  · simp [ha]

theorem e_mulVec (p : Root m) (a : B) (x : Fin m → B) :
    ((Elementary.e p a : (Matrix (Fin m) (Fin m) B)ˣ) : Matrix (Fin m) (Fin m) B) *ᵥ x =
      fun l => if l = p.row then x l + a * x p.col else x l := by
  funext l
  rw [Elementary.coe_e, Matrix.add_mulVec, Matrix.one_mulVec, Pi.add_apply]
  by_cases hl : l = p.row
  · subst hl
    simp [Matrix.mulVec, dotProduct, Matrix.single_apply]
  · simp [hl, Ne.symm hl, Matrix.mulVec, dotProduct]

/-- The factor of column `i` at row `l`. -/
noncomputable def colFactor (i : Fin m) (c : Fin m → B) (l : Fin m) : (Matrix (Fin m) (Fin m) B)ˣ :=
  if h : l = i then 1 else Elementary.e ⟨l, i, h⟩ (c l)

theorem colFactor_mem (i : Fin m) (c : Fin m → B) (l : Fin m) : colFactor i c l ∈ GE m B := by
  unfold colFactor
  split_ifs with h
  · exact Subgroup.one_mem _
  · exact e_mem_GE _ _

theorem colFactor_mulVec (i : Fin m) (c : Fin m → B) (l : Fin m) (x : Fin m → B) :
    ((colFactor i c l : (Matrix (Fin m) (Fin m) B)ˣ) : Matrix (Fin m) (Fin m) B) *ᵥ x =
      fun a => if a = l ∧ a ≠ i then x a + c a * x i else x a := by
  unfold colFactor
  split_ifs with h
  · subst h
    funext a
    simp only [Units.val_one, Matrix.one_mulVec]
    split_ifs with ha
    · exact absurd ha.1 ha.2
    · rfl
  · rw [e_mulVec]
    funext a
    by_cases ha : a = l
    · subst ha
      simp [h]
    · simp [ha]

/-- The product of the column factors over a list of rows. -/
noncomputable def colProd (i : Fin m) (c : Fin m → B) (L : List (Fin m)) :
    (Matrix (Fin m) (Fin m) B)ˣ := (L.map (colFactor i c)).prod

theorem colProd_mem (i : Fin m) (c : Fin m → B) (L : List (Fin m)) : colProd i c L ∈ GE m B := by
  unfold colProd
  apply Subgroup.list_prod_mem
  intro g hg
  obtain ⟨l, -, rfl⟩ := List.mem_map.mp hg
  exact colFactor_mem i c l

theorem colProd_mulVec (i : Fin m) (c : Fin m → B) :
    ∀ (L : List (Fin m)), L.Nodup → ∀ x : Fin m → B,
      ((colProd i c L : (Matrix (Fin m) (Fin m) B)ˣ) : Matrix (Fin m) (Fin m) B) *ᵥ x =
        fun a => if a ∈ L ∧ a ≠ i then x a + c a * x i else x a
  | [], _, x => by
    funext a
    simp [colProd]
  | l :: L, hL, x => by
    have hL' := (List.nodup_cons.mp hL)
    have hrest := colProd_mulVec i c L hL'.2 x
    have hprod : colProd i c (l :: L) = colFactor i c l * colProd i c L := by
      simp [colProd]
    rw [hprod, Units.val_mul, ← Matrix.mulVec_mulVec, hrest, colFactor_mulVec]
    funext a
    by_cases hai : a = i
    · subst hai
      simp
    · by_cases hal : a = l
      · subst hal
        simp [hai, hL'.1]
      · simp [hai, hal]

/-- A column whose `i`-th entry is a unit is the image of the `i`-th standard column under a
product of elementary matrices in column `i` and a diagonal unit in position `i`; the other
standard columns are fixed. -/
noncomputable def replaceCol (i : Fin m) (v : Fin m → B) (u : Bˣ) : (Matrix (Fin m) (Fin m) B)ˣ :=
  colProd i (fun l => v l * ((u⁻¹ : Bˣ) : B)) (List.finRange m) * d i u

theorem replaceCol_mem (i : Fin m) (v : Fin m → B) (u : Bˣ) : replaceCol i v u ∈ GE m B :=
  Subgroup.mul_mem _ (colProd_mem _ _ _) (d_mem_GE _ _)

theorem replaceCol_mulVec (i : Fin m) (v : Fin m → B) (u : Bˣ) (hu : v i = u) (x : Fin m → B) :
    ((replaceCol i v u : (Matrix (Fin m) (Fin m) B)ˣ) : Matrix (Fin m) (Fin m) B) *ᵥ x =
      fun a => if a = i then (u : B) * x i else x a + v a * x i := by
  unfold replaceCol
  rw [Units.val_mul, ← Matrix.mulVec_mulVec, d_mulVec,
    colProd_mulVec i _ _ (List.nodup_finRange m)]
  funext a
  by_cases hai : a = i
  · subst hai
    simp
  · simp only [List.mem_finRange, true_and, ne_eq, hai, not_false_eq_true, ↓reduceIte]
    rw [mul_assoc, Units.inv_mul_cancel_left]

theorem replaceCol_single (i : Fin m) (v : Fin m → B) (u : Bˣ) (hu : v i = u) :
    ((replaceCol i v u : (Matrix (Fin m) (Fin m) B)ˣ) : Matrix (Fin m) (Fin m) B) *ᵥ
      Pi.single i 1 = v := by
  rw [replaceCol_mulVec i v u hu]
  funext a
  by_cases hai : a = i
  · subst hai
    simp [hu]
  · simp [hai]

theorem replaceCol_single_ne (i : Fin m) (v : Fin m → B) (u : Bˣ) (hu : v i = u) {l : Fin m}
    (hl : l ≠ i) :
    ((replaceCol i v u : (Matrix (Fin m) (Fin m) B)ˣ) : Matrix (Fin m) (Fin m) B) *ᵥ
      Pi.single l 1 = Pi.single l 1 := by
  rw [replaceCol_mulVec i v u hu]
  funext a
  by_cases hai : a = i
  · subst hai
    simp [hl.symm]
  · simp [hai, Pi.single_apply, hl.symm]

end ReplaceColumn

section Padding
variable {m : ℕ}

theorem pad_apply (A : (Matrix (Fin m) (Fin m) B)ˣ) (x y : Fin (m + 1)) :
    ((Kernel.padUnitsHom A : (Matrix (Fin (m + 1)) (Fin (m + 1)) B)ˣ) :
      Matrix (Fin (m + 1)) (Fin (m + 1)) B) x y =
      Matrix.fromBlocks (A : Matrix (Fin m) (Fin m) B) 0 0 1
        ((Kernel.coordinateEquiv m).symm x) ((Kernel.coordinateEquiv m).symm y) := rfl

theorem coordinateEquiv_symm_castSucc (a : Fin m) :
    (Kernel.coordinateEquiv m).symm a.castSucc = Sum.inl a :=
  finSumFinEquiv_symm_apply_castAdd a

theorem coordinateEquiv_symm_last :
    (Kernel.coordinateEquiv m).symm (Fin.last m) = Sum.inr 0 :=
  finSumFinEquiv_symm_last

theorem pad_d (i : Fin m) (u : Bˣ) : Kernel.padUnitsHom (d i u) = d i.castSucc u := by
  apply Units.ext
  ext x y
  rw [pad_apply, coe_d, coe_d]
  induction x using Fin.lastCases with
  | last =>
    induction y using Fin.lastCases with
    | last =>
      rw [coordinateEquiv_symm_last, Matrix.fromBlocks_apply₂₂]
      simp [Function.update_of_ne (Fin.castSucc_lt_last i).ne']
    | cast b =>
      rw [coordinateEquiv_symm_last, coordinateEquiv_symm_castSucc, Matrix.fromBlocks_apply₂₁]
      simp [Matrix.diagonal_apply_ne _ (Fin.castSucc_lt_last b).ne']
  | cast a =>
    induction y using Fin.lastCases with
    | last =>
      rw [coordinateEquiv_symm_last, coordinateEquiv_symm_castSucc, Matrix.fromBlocks_apply₁₂]
      simp
    | cast b =>
      rw [coordinateEquiv_symm_castSucc, coordinateEquiv_symm_castSucc, Matrix.fromBlocks_apply₁₁,
        Matrix.diagonal_apply, Matrix.diagonal_apply]
      by_cases hab : a = b
      · subst hab
        by_cases hai : a = i
        · subst hai
          simp
        · simp [hai]
      · simp [hab, (Fin.castSucc_injective m).ne hab]

theorem pad_mem_GE {A : (Matrix (Fin m) (Fin m) B)ˣ} (hA : A ∈ GE m B) :
    Kernel.padUnitsHom A ∈ GE (m + 1) B := by
  have h : GE m B ≤ (GE (m + 1) B).comap Kernel.padUnitsHom := by
    apply (Subgroup.closure_le _).mpr
    rintro g (⟨p, a, rfl⟩ | ⟨i, u, rfl⟩)
    · show Kernel.padUnitsHom (Elementary.e p a) ∈ GE (m + 1) B
      rw [Kernel.padUnitsHom_e]
      exact e_mem_GE _ _
    · show Kernel.padUnitsHom (d i u) ∈ GE (m + 1) B
      rw [pad_d]
      exact d_mem_GE _ _
  exact h hA

/-- A matrix fixing the last standard column, with zero last row off the diagonal, is the
padding of its upper-left block. -/
theorem eq_pad (M : (Matrix (Fin (m + 1)) (Fin (m + 1)) B)ˣ)
    (hcol : ∀ x, (M : Matrix (Fin (m + 1)) (Fin (m + 1)) B) x (Fin.last m) =
      if x = Fin.last m then 1 else 0)
    (hrow : ∀ b : Fin m, (M : Matrix (Fin (m + 1)) (Fin (m + 1)) B) (Fin.last m) b.castSucc = 0) :
    ∃ A : (Matrix (Fin m) (Fin m) B)ˣ, M = Kernel.padUnitsHom A := by
  have hcs : ∀ a : Fin m, (a.castSucc = Fin.last m) = False := fun a =>
    eq_false (Fin.castSucc_lt_last a).ne
  let A : (Matrix (Fin m) (Fin m) B)ˣ :=
    { val := Matrix.of fun a b => (M : Matrix _ _ B) a.castSucc b.castSucc
      inv := Matrix.of fun a b => ((M⁻¹ : (Matrix _ _ B)ˣ) : Matrix _ _ B) a.castSucc b.castSucc
      val_inv := by
        ext a c
        have key := congrArg (fun N : Matrix (Fin (m + 1)) (Fin (m + 1)) B => N a.castSucc c.castSucc)
          M.mul_inv
        simp only [Matrix.mul_apply, Fin.sum_univ_castSucc, hcol, hcs, ↓reduceIte, zero_mul,
          add_zero, Matrix.one_apply, Fin.castSucc_inj] at key
        simpa [Matrix.mul_apply, Matrix.one_apply] using key
      inv_val := by
        ext a c
        have key := congrArg (fun N : Matrix (Fin (m + 1)) (Fin (m + 1)) B => N a.castSucc c.castSucc)
          M.inv_mul
        simp only [Matrix.mul_apply, Fin.sum_univ_castSucc, hrow, mul_zero, add_zero,
          Matrix.one_apply, Fin.castSucc_inj] at key
        simpa [Matrix.mul_apply, Matrix.one_apply] using key }
  refine ⟨A, ?_⟩
  apply Units.ext
  ext x y
  rw [pad_apply]
  induction x using Fin.lastCases with
  | last =>
    induction y using Fin.lastCases with
    | last =>
      rw [coordinateEquiv_symm_last, Matrix.fromBlocks_apply₂₂, hcol]
      simp
    | cast b =>
      rw [coordinateEquiv_symm_last, coordinateEquiv_symm_castSucc, Matrix.fromBlocks_apply₂₁,
        hrow]
      rfl
  | cast a =>
    induction y using Fin.lastCases with
    | last =>
      rw [coordinateEquiv_symm_last, coordinateEquiv_symm_castSucc, Matrix.fromBlocks_apply₁₂,
        hcol]
      simp [hcs]
    | cast b =>
      rw [coordinateEquiv_symm_castSucc, coordinateEquiv_symm_castSucc, Matrix.fromBlocks_apply₁₁]
      rfl

/-- The elementary factor in the last row and column `b`. -/
def rowFactor (r : Fin m → B) (b : Fin m) : (Matrix (Fin (m + 1)) (Fin (m + 1)) B)ˣ :=
  Elementary.e ⟨Fin.last m, b.castSucc, (Fin.castSucc_lt_last b).ne'⟩ (r b)

/-- The row strip with last row `r`. -/
def rowProd (r : Fin m → B) (L : List (Fin m)) : (Matrix (Fin (m + 1)) (Fin (m + 1)) B)ˣ :=
  (L.map (rowFactor r)).prod

theorem rowProd_mem (r : Fin m → B) (L : List (Fin m)) : rowProd r L ∈ GE (m + 1) B := by
  unfold rowProd
  apply Subgroup.list_prod_mem
  intro g hg
  obtain ⟨b, -, rfl⟩ := List.mem_map.mp hg
  exact e_mem_GE _ _

theorem rowProd_mulVec (r : Fin m → B) : ∀ (L : List (Fin m)) (x : Fin (m + 1) → B),
    ((rowProd r L : (Matrix _ _ B)ˣ) : Matrix (Fin (m + 1)) (Fin (m + 1)) B) *ᵥ x =
      fun a => if a = Fin.last m then x a + (L.map fun b => r b * x b.castSucc).sum else x a
  | [], x => by
    funext a
    simp [rowProd]
  | b :: L, x => by
    have hprod : rowProd r (b :: L) = rowFactor r b * rowProd r L := by simp [rowProd]
    rw [hprod, Units.val_mul, ← Matrix.mulVec_mulVec, rowProd_mulVec r L x, rowFactor, e_mulVec]
    funext a
    by_cases ha : a = Fin.last m
    · subst ha
      simp only [↓reduceIte, (Fin.castSucc_lt_last b).ne, List.map_cons, List.sum_cons]
      abel
    · simp [ha]

end Padding

section Generation
variable {K : Type*} [Field K] (ε : B →+* K)

theorem map_single_one {m : ℕ} (j : Fin m) : (ε ∘ Pi.single j (1 : B)) = Pi.single j (1 : K) := by
  funext l
  by_cases hl : l = j
  · subst hl
    simp
  · simp [hl]

/-- An invertible matrix sends a standard column to a column with an entry outside the kernel of
the augmentation. -/
theorem exists_unit_entry {m : ℕ} (g : (Matrix (Fin m) (Fin m) B)ˣ) (j : Fin m) :
    ∃ l, ε (((g : Matrix (Fin m) (Fin m) B) *ᵥ Pi.single j 1) l) ≠ 0 := by
  by_contra h
  have h0 : ∀ l, ε (((g : Matrix (Fin m) (Fin m) B) *ᵥ Pi.single j 1) l) = 0 := fun l => by
    by_contra hl
    exact h ⟨l, hl⟩
  have h1 : ((g : Matrix (Fin m) (Fin m) B).map ε) *ᵥ (Pi.single j (1 : K)) = 0 := by
    funext l
    have := RingHom.map_mulVec ε (g : Matrix (Fin m) (Fin m) B) (Pi.single j 1) l
    rw [h0, map_single_one] at this
    exact this.symm
  have h2 : (((g⁻¹ : (Matrix (Fin m) (Fin m) B)ˣ) : Matrix (Fin m) (Fin m) B).map ε) *
      ((g : Matrix (Fin m) (Fin m) B).map ε) = 1 := by
    rw [← Matrix.map_mul, Units.inv_mul, Matrix.map_one _ ε.map_zero ε.map_one]
  have h3 := congrArg (fun N : Matrix (Fin m) (Fin m) K => (N *ᵥ Pi.single j (1 : K)) j) h2
  simp only [Matrix.one_mulVec, ← Matrix.mulVec_mulVec, h1, Matrix.mulVec_zero, Pi.zero_apply,
    Pi.single_eq_same] at h3
  exact zero_ne_one h3

variable (hunit : ∀ b : B, ε b ≠ 0 → IsUnit b)
include hunit

/-- Every invertible matrix is a product of elementary matrices and diagonal units. -/
theorem mem_GE : ∀ (m : ℕ) (g : (Matrix (Fin m) (Fin m) B)ˣ), g ∈ GE m B
  | 0, g => by
    have : g = 1 := Subsingleton.elim _ _
    rw [this]
    exact Subgroup.one_mem _
  | m + 1, g => by
    set v := (g : Matrix (Fin (m + 1)) (Fin (m + 1)) B) *ᵥ Pi.single (Fin.last m) 1 with hv
    obtain ⟨h₁, hh₁, he₁⟩ : ∃ h₁ ∈ GE (m + 1) B,
        (h₁ : Matrix (Fin (m + 1)) (Fin (m + 1)) B) *ᵥ Pi.single (Fin.last m) 1 = v := by
      by_cases hlast : ε (v (Fin.last m)) ≠ 0
      · obtain ⟨u, hu⟩ := hunit _ hlast
        exact ⟨replaceCol (Fin.last m) v u, replaceCol_mem _ _ _,
          replaceCol_single _ _ _ hu.symm⟩
      · obtain ⟨l, hl⟩ := exists_unit_entry ε g (Fin.last m)
        have hlv : ε (v l) ≠ 0 := hl
        have hll : l ≠ Fin.last m := fun h => hlast (h ▸ hlv)
        let f := Elementary.e ⟨Fin.last m, l, hll.symm⟩ (1 : B)
        set v' := (f : Matrix (Fin (m + 1)) (Fin (m + 1)) B) *ᵥ v with hv'
        have hv'l : v' (Fin.last m) = v (Fin.last m) + v l := by
          rw [hv', e_mulVec]
          simp
        have hε : ε (v' (Fin.last m)) ≠ 0 := by
          rw [hv'l, map_add, not_ne_iff.mp hlast, zero_add]
          exact hlv
        obtain ⟨u, hu⟩ := hunit _ hε
        refine ⟨f⁻¹ * replaceCol (Fin.last m) v' u,
          Subgroup.mul_mem _ (Subgroup.inv_mem _ (e_mem_GE _ _)) (replaceCol_mem _ _ _), ?_⟩
        rw [Units.val_mul, ← Matrix.mulVec_mulVec, replaceCol_single _ _ _ hu.symm, hv',
          Matrix.mulVec_mulVec, Units.inv_mul, Matrix.one_mulVec]
    set g₁ := h₁⁻¹ * g with hg₁
    have hcol₁ : (g₁ : Matrix (Fin (m + 1)) (Fin (m + 1)) B) *ᵥ Pi.single (Fin.last m) 1 =
        Pi.single (Fin.last m) 1 := by
      rw [hg₁, Units.val_mul, ← Matrix.mulVec_mulVec, ← hv, ← he₁, Matrix.mulVec_mulVec,
        Units.inv_mul, Matrix.one_mulVec]
    set r : Fin m → B := fun b => -(g₁ : Matrix (Fin (m + 1)) (Fin (m + 1)) B) (Fin.last m)
      b.castSucc with hr
    set k := rowProd r (List.finRange m) with hk
    set g₂ := g₁ * k with hg₂
    have hk_last : (k : Matrix (Fin (m + 1)) (Fin (m + 1)) B) *ᵥ Pi.single (Fin.last m) 1 =
        Pi.single (Fin.last m) 1 := by
      rw [hk, rowProd_mulVec]
      funext a
      by_cases ha : a = Fin.last m
      · subst ha
        simp [(Fin.castSucc_lt_last _).ne]
      · simp [ha]
    have hcol₂ : ∀ x, (g₂ : Matrix (Fin (m + 1)) (Fin (m + 1)) B) x (Fin.last m) =
        if x = Fin.last m then 1 else 0 := by
      intro x
      have := congrFun (show (g₂ : Matrix (Fin (m + 1)) (Fin (m + 1)) B) *ᵥ
          Pi.single (Fin.last m) 1 = Pi.single (Fin.last m) 1 by
        rw [hg₂, Units.val_mul, ← Matrix.mulVec_mulVec, hk_last, hcol₁]) x
      rw [Matrix.mulVec_single_one] at this
      rw [show (g₂ : Matrix (Fin (m + 1)) (Fin (m + 1)) B) x (Fin.last m) =
        (g₂ : Matrix (Fin (m + 1)) (Fin (m + 1)) B).col (Fin.last m) x from rfl, this]
      by_cases hx : x = Fin.last m
      · subst hx
        simp
      · simp [hx]
    have hrow₂ : ∀ b : Fin m, (g₂ : Matrix (Fin (m + 1)) (Fin (m + 1)) B) (Fin.last m)
        b.castSucc = 0 := by
      intro b
      have hkb : (k : Matrix (Fin (m + 1)) (Fin (m + 1)) B) *ᵥ Pi.single b.castSucc 1 =
          Pi.single b.castSucc 1 + Pi.single (Fin.last m) (r b) := by
        rw [hk, rowProd_mulVec]
        funext a
        by_cases ha : a = Fin.last m
        · subst ha
          rw [← Fin.sum_univ_def]
          simp [Pi.single_apply, (Fin.castSucc_lt_last b).ne']
        · simp [ha]
      have h1 := congrFun (show (g₂ : Matrix (Fin (m + 1)) (Fin (m + 1)) B) *ᵥ
          Pi.single b.castSucc 1 = (g₁ : Matrix (Fin (m + 1)) (Fin (m + 1)) B) *ᵥ
            (Pi.single b.castSucc 1 + Pi.single (Fin.last m) (r b)) by
        rw [hg₂, Units.val_mul, ← Matrix.mulVec_mulVec, hkb]) (Fin.last m)
      rw [Matrix.mulVec_single_one, Matrix.mulVec_add, Matrix.mulVec_single_one,
        Matrix.mulVec_single, Pi.add_apply] at h1
      have hll : (g₁ : Matrix (Fin (m + 1)) (Fin (m + 1)) B) (Fin.last m) (Fin.last m) = 1 := by
        have := congrFun hcol₁ (Fin.last m)
        rwa [Matrix.mulVec_single_one, Pi.single_eq_same] at this
      change (g₂ : Matrix (Fin (m + 1)) (Fin (m + 1)) B).col b.castSucc (Fin.last m) = 0
      rw [h1]
      simp [Matrix.col, hll, hr]
    obtain ⟨A, hA⟩ := eq_pad g₂ hcol₂ hrow₂
    have hpad : g₂ ∈ GE (m + 1) B := by
      rw [hA]
      exact pad_mem_GE (mem_GE m A)
    have hg : g = h₁ * g₂ * k⁻¹ := by
      rw [hg₂, hg₁]
      group
    rw [hg]
