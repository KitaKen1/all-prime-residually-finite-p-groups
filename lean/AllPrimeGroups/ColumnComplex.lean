import Mathlib.LinearAlgebra.Dimension.Constructions
import Mathlib.LinearAlgebra.Dimension.Finrank
import Mathlib.LinearAlgebra.StdBasis
import Mathlib.Logic.Relation
import Mathlib.Data.List.Chain

/-! Simple connectivity of the complex of columns with independent reductions (manuscript
Lemma 11.1, first paragraph).

Vertices are labels with a reduction in `k^n`; two vertices are joined when their reductions are
independent, and three vertices span a triangle when their reductions are independent. Edge paths
are lists of vertices, and homotopy is generated by backtracking and by removing the middle
vertex of a triangle.

If the standard basis vectors occur as reductions of vertices and n ≥ 3, every closed edge path
at a standard vertex is homotopic to the trivial path. The proof removes the non-standard vertices
of a path one at a time: the link of a vertex in the complex spanned by the path and the standard
vertices has diameter at most two through a standard vertex. The labels may repeat reductions;
nothing about the coefficient ring of the columns is used. -/

namespace AllPrimeGroups
namespace ColumnComplex

open Classical

section Vectors
variable {k : Type*} [Field k] {E : Type*} [AddCommGroup E] [Module k E]

/-- Two independent vectors. -/
def Ind2 (x y : E) : Prop := ∀ a b : k, a • x + b • y = 0 → a = 0 ∧ b = 0

/-- Three independent vectors. -/
def Ind3 (x y z : E) : Prop :=
  ∀ a b c : k, a • x + b • y + c • z = 0 → a = 0 ∧ b = 0 ∧ c = 0

theorem Ind2.symm {x y : E} (h : Ind2 (k := k) x y) : Ind2 (k := k) y x := by
  intro a b hab
  have := h b a (by rw [add_comm]; exact hab)
  exact ⟨this.2, this.1⟩

theorem Ind3.swap12 {x y z : E} (h : Ind3 (k := k) x y z) : Ind3 (k := k) y x z := by
  intro a b c habc
  have := h b a c (by rw [← habc]; abel)
  exact ⟨this.2.1, this.1, this.2.2⟩

theorem Ind3.swap23 {x y z : E} (h : Ind3 (k := k) x y z) : Ind3 (k := k) x z y := by
  intro a b c habc
  have := h a c b (by rw [← habc]; abel)
  exact ⟨this.1, this.2.2, this.2.1⟩

theorem Ind3.ind2_12 {x y z : E} (h : Ind3 (k := k) x y z) : Ind2 (k := k) x y := by
  intro a b hab
  have := h a b 0 (by rw [zero_smul, add_zero, hab])
  exact ⟨this.1, this.2.1⟩

theorem Ind3.ind2_23 {x y z : E} (h : Ind3 (k := k) x y z) : Ind2 (k := k) y z := by
  intro a b hab
  have := h 0 a b (by rw [zero_smul, zero_add]; exact hab)
  exact ⟨this.2.1, this.2.2⟩

theorem Ind3.ind2_13 {x y z : E} (h : Ind3 (k := k) x y z) : Ind2 (k := k) x z :=
  h.swap23.ind2_12

theorem ind3_of_not_mem {x y z : E} (h : Ind2 (k := k) x y) (hz : ∀ a b : k, a • x + b • y ≠ z) :
    Ind3 (k := k) x y z := by
  intro a b c habc
  by_cases hc : c = 0
  · subst hc
    rw [zero_smul, add_zero] at habc
    exact ⟨(h a b habc).1, (h a b habc).2, rfl⟩
  · exfalso
    apply hz (-c⁻¹ * a) (-c⁻¹ * b)
    have e : c • z = -(a • x + b • y) := add_eq_zero_iff_eq_neg'.mp habc
    calc (-c⁻¹ * a) • x + (-c⁻¹ * b) • y = -c⁻¹ • (a • x + b • y) := by
          rw [smul_add, mul_smul, mul_smul]
      _ = c⁻¹ • (c • z) := by rw [e, smul_neg, neg_smul]
      _ = z := by rw [smul_smul, inv_mul_cancel₀ hc, one_smul]

theorem exists_of_not_ind3 {x y z : E} (h : Ind2 (k := k) x y) (hz : ¬ Ind3 (k := k) x y z) :
    ∃ a b : k, a • x + b • y = z := by
  by_contra hn
  exact hz (ind3_of_not_mem h fun a b hab => hn ⟨a, b, hab⟩)

end Vectors

section Standard
variable {k : Type*} [Field k] {n : ℕ}

theorem ind2_single {i j : Fin n} (hij : i ≠ j) :
    Ind2 (k := k) (Pi.single i (1 : k) : Fin n → k) (Pi.single j 1) := by
  intro a b hab
  have hi := congrFun hab i
  have hj := congrFun hab j
  simp [hij, hij.symm] at hi hj
  exact ⟨hi, hj⟩

theorem ind3_single {i j l : Fin n} (hij : i ≠ j) (hjl : j ≠ l) (hil : i ≠ l) :
    Ind3 (k := k) (Pi.single i (1 : k) : Fin n → k) (Pi.single j 1) (Pi.single l 1) := by
  intro a b c habc
  have hi := congrFun habc i
  have hj := congrFun habc j
  have hl := congrFun habc l
  simp [hij, hjl, hil, hij.symm, hjl.symm, hil.symm] at hi hj hl
  exact ⟨hi, hj, hl⟩

/-- In rank at least three, some standard basis vector is outside the span of two vectors. -/
theorem exists_single_not_mem (hn : 3 ≤ n) (x y : Fin n → k) :
    ∃ i : Fin n, ∀ a b : k, a • x + b • y ≠ Pi.single i 1 := by
  by_contra h
  have h' : ∀ i : Fin n, ∃ a b : k, a • x + b • y = Pi.single i 1 := fun i => by
    by_contra hi
    exact h ⟨i, fun a b hab => hi ⟨a, b, hab⟩⟩
  have hspan : Submodule.span k (({x, y} : Finset (Fin n → k)) : Set (Fin n → k)) = ⊤ := by
    rw [eq_top_iff, ← (Pi.basisFun k (Fin n)).span_eq, Submodule.span_le]
    rintro _ ⟨i, rfl⟩
    obtain ⟨a, b, hab⟩ := h' i
    rw [Pi.basisFun_apply, ← hab]
    exact Submodule.add_mem _ (Submodule.smul_mem _ _ (Submodule.subset_span (by simp)))
      (Submodule.smul_mem _ _ (Submodule.subset_span (by simp)))
  have h1 := finrank_span_finset_le_card (R := k) ({x, y} : Finset (Fin n → k))
  have h2 : (({x, y} : Finset (Fin n → k)) : Set (Fin n → k)).finrank k = n := by
    rw [Set.finrank, hspan, finrank_top, Module.finrank_fin_fun]
  have h3 : ({x, y} : Finset (Fin n → k)).card ≤ 2 := Finset.card_le_two
  omega

end Standard

section Complex
variable {k : Type*} [Field k] {n : ℕ} {V : Type*} (r : V → Fin n → k)

/-- Adjacent vertices: independent reductions. -/
def Adj (u v : V) : Prop := Ind2 (k := k) (r u) (r v)

/-- Triangles: three independent reductions. -/
def Tri (u v w : V) : Prop := Ind3 (k := k) (r u) (r v) (r w)

/-- The elementary homotopies of edge paths. -/
inductive Move : List V → List V → Prop
  | back (x y : List V) (v w : V) : Adj r v w → Move (x ++ v :: w :: v :: y) (x ++ v :: y)
  | tri (x y : List V) (u v w : V) : Tri r u v w → Move (x ++ u :: v :: w :: y) (x ++ u :: w :: y)

/-- Homotopy of edge paths. -/
def Homotopic : List V → List V → Prop := Relation.EqvGen (Move r)

variable {r}

theorem Adj.symm {u v : V} (h : Adj r u v) : Adj r v u := Ind2.symm h

theorem Adj.irrefl (v : V) : ¬ Adj r v v := by
  intro h
  have := h 1 (-1) (by rw [neg_one_smul, one_smul, add_neg_cancel])
  exact one_ne_zero this.1

theorem Tri.adj12 {u v w : V} (h : Tri r u v w) : Adj r u v := Ind3.ind2_12 h
theorem Tri.adj23 {u v w : V} (h : Tri r u v w) : Adj r v w := Ind3.ind2_23 h
theorem Tri.adj13 {u v w : V} (h : Tri r u v w) : Adj r u w := Ind3.ind2_13 h

/-- A move relates edge paths to edge paths. -/
theorem Move.isChain_iff {p q : List V} (h : Move r p q) :
    p.IsChain (Adj r) ↔ q.IsChain (Adj r) := by
  cases h with
  | back x y v w hvw =>
    rw [List.isChain_split (l₁ := x) (c := v) (l₂ := w :: v :: y),
      List.isChain_split (l₁ := x) (c := v) (l₂ := y)]
    simp only [List.isChain_cons_cons]
    constructor
    · rintro ⟨h1, -, -, h4⟩
      exact ⟨h1, h4⟩
    · rintro ⟨h1, h4⟩
      exact ⟨h1, hvw, hvw.symm, h4⟩
  | tri x y u v w huvw =>
    rw [List.isChain_split (l₁ := x) (c := u) (l₂ := v :: w :: y),
      List.isChain_split (l₁ := x) (c := u) (l₂ := w :: y)]
    simp only [List.isChain_cons_cons]
    constructor
    · rintro ⟨h1, -, -, h4⟩
      exact ⟨h1, huvw.adj13, h4⟩
    · rintro ⟨h1, -, h4⟩
      exact ⟨h1, huvw.adj12, huvw.adj23, h4⟩

/-- A quantity on edge paths that is unchanged by single moves is unchanged by homotopy. -/
theorem Homotopic.invariant {S : Type*} (F : List V → S)
    (hF : ∀ p q, Move r p q → p.IsChain (Adj r) → F p = F q) {p q : List V}
    (h : Homotopic r p q) : (p.IsChain (Adj r) → F p = F q) ∧
      (p.IsChain (Adj r) ↔ q.IsChain (Adj r)) := by
  induction h with
  | rel p q hpq => exact ⟨hF p q hpq, hpq.isChain_iff⟩
  | refl p => exact ⟨fun _ => rfl, Iff.rfl⟩
  | symm p q _ ih => exact ⟨fun hq => (ih.1 (ih.2.mpr hq)).symm, ih.2.symm⟩
  | trans p q s _ _ ih₁ ih₂ =>
    exact ⟨fun hp => (ih₁.1 hp).trans (ih₂.1 (ih₁.2.mp hp)), ih₁.2.trans ih₂.2⟩

theorem Homotopic.refl (p : List V) : Homotopic r p p := Relation.EqvGen.refl p

theorem Homotopic.trans {p q s : List V} (h₁ : Homotopic r p q) (h₂ : Homotopic r q s) :
    Homotopic r p s := Relation.EqvGen.trans _ _ _ h₁ h₂

theorem Homotopic.symm {p q : List V} (h : Homotopic r p q) : Homotopic r q p :=
  Relation.EqvGen.symm _ _ h

theorem Homotopic.of_move {p q : List V} (h : Move r p q) : Homotopic r p q :=
  Relation.EqvGen.rel _ _ h

variable (r)
variable (b : Fin n → V) (hb : ∀ i, r (b i) = Pi.single i 1)

/-- Standard vertices. -/
def IsStandard (v : V) : Prop := ∃ i, b i = v

include hb in
theorem adj_standard {i j : Fin n} (hij : i ≠ j) : Adj r (b i) (b j) := by
  unfold Adj
  rw [hb, hb]
  exact ind2_single hij

include hb in
theorem tri_standard {i j l : Fin n} (hij : i ≠ j) (hjl : j ≠ l) (hil : i ≠ l) :
    Tri r (b i) (b j) (b l) := by
  unfold Tri
  rw [hb, hb, hb]
  exact ind3_single hij hjl hil

include hb in
/-- An edge path through standard vertices only, closed at a standard vertex, is
null-homotopic. -/
theorem standard_loop (hn : 3 ≤ n) :
    ∀ (m : ℕ) (p : List V) (v : V), p.length ≤ m → (v :: p).IsChain (Adj r) →
      (∀ w ∈ v :: p, IsStandard b w) → (v :: p).getLast? = some v →
      Homotopic r (v :: p) [v]
  | 0, p, v, hl, _, _, _ => by
    rw [List.length_eq_zero_iff.mp (Nat.le_zero.mp hl)]
    exact Homotopic.refl _
  | m + 1, [], v, _, _, _, _ => Homotopic.refl _
  | m + 1, [w], v, _, hc, _, hlast => by
    simp only [List.getLast?_cons_cons, List.getLast?_singleton, Option.some.injEq] at hlast
    subst hlast
    simp only [List.isChain_cons_cons] at hc
    exact absurd hc.1 (Adj.irrefl _)
  | m + 1, w :: z :: p, v, hl, hc, hs, hlast => by
    simp only [List.isChain_cons_cons] at hc
    obtain ⟨hvw, hwz, hc⟩ := hc
    have hlast' : (v :: z :: p).getLast? = some v := by
      simpa only [List.getLast?_cons_cons] using hlast
    by_cases hvz : z = v
    · rw [hvz] at hc hlast' ⊢
      have hback : Homotopic r (v :: w :: v :: p) (v :: p) :=
        Homotopic.of_move (Move.back [] p v w hvw)
      have hrest : Homotopic r (v :: p) [v] := by
        cases p with
        | nil => exact Homotopic.refl _
        | cons y p =>
          refine standard_loop hn m (y :: p) v (by simp at hl ⊢; omega) hc
            (fun u hu => hs u (by simp at hu ⊢; tauto)) ?_
          simpa only [List.getLast?_cons_cons] using hlast'
      exact hback.trans hrest
    · obtain ⟨i, rfl⟩ := hs v (by simp)
      obtain ⟨j, rfl⟩ := hs w (by simp)
      obtain ⟨l, rfl⟩ := hs z (by simp)
      have hij : i ≠ j := by
        intro h
        subst h
        exact Adj.irrefl _ hvw
      have hjl : j ≠ l := by
        intro h
        subst h
        exact Adj.irrefl _ hwz
      have hil : i ≠ l := by
        intro h
        exact hvz (by rw [h])
      have htri : Homotopic r (b i :: b j :: b l :: p) (b i :: b l :: p) :=
        Homotopic.of_move (Move.tri [] p (b i) (b j) (b l) (tri_standard r b hb hij hjl hil))
      refine htri.trans (standard_loop hn m (b l :: p) (b i) (by simp at hl ⊢; omega) ?_
        (fun u hu => hs u (by simp at hu ⊢; tauto)) hlast')
      exact List.isChain_cons_cons.mpr ⟨adj_standard r b hb hil, hc⟩

include hb in
/-- Replacing a vertex of a path by at most one standard vertex. -/
theorem replace (hn : 3 ≤ n) (x y : List V) (a w c : V) (haw : Adj r a w) (hwc : Adj r w c) :
    ∃ m : List V, (∀ u ∈ m, IsStandard b u) ∧
      Homotopic r (x ++ a :: w :: c :: y) (x ++ a :: (m ++ c :: y)) := by
  by_cases ht : Tri r a w c
  · exact ⟨[], by simp, Homotopic.of_move (Move.tri x y a w c ht)⟩
  · obtain ⟨α, β, hc⟩ := exists_of_not_ind3 (k := k) haw ht
    obtain ⟨i, hi⟩ := exists_single_not_mem hn (r a) (r w)
    have t1 : Tri r a (b i) w := by
      unfold Tri
      rw [hb]
      exact (ind3_of_not_mem haw hi).swap23
    have t2 : Tri r (b i) w c := by
      unfold Tri
      rw [hb]
      have h2 : ∀ γ δ : k, γ • r w + δ • r c ≠ Pi.single i 1 := by
        intro γ δ h
        apply hi (δ * α) (γ + δ * β)
        rw [← h, ← hc]
        simp only [smul_add, mul_smul, add_smul]
        abel
      exact (ind3_of_not_mem hwc h2).swap23.swap12
    refine ⟨[b i], fun u hu => ⟨i, (List.mem_singleton.mp hu).symm⟩, ?_⟩
    have m1 : Move r (x ++ a :: b i :: w :: c :: y) (x ++ a :: w :: c :: y) :=
      Move.tri x (c :: y) a (b i) w t1
    have m2 := Move.tri (x ++ [a]) y (b i) w c t2
    have e1 : (x ++ [a]) ++ b i :: w :: c :: y = x ++ a :: b i :: w :: c :: y := by simp
    have e2 : (x ++ [a]) ++ b i :: c :: y = x ++ a :: ([b i] ++ c :: y) := by simp
    rw [e1, e2] at m2
    exact (Homotopic.of_move m1).symm.trans (Homotopic.of_move m2)

theorem Homotopic.isChain_iff {p q : List V} (h : Homotopic r p q) :
    p.IsChain (Adj r) ↔ q.IsChain (Adj r) :=
  (h.invariant (fun _ => ()) (fun _ _ _ _ => rfl)).2

include hb in
/-- Manuscript Lemma 11.1, first paragraph: in rank at least three, every closed edge path at a
standard vertex is null-homotopic. -/
theorem simply_connected (hn : 3 ≤ n) :
    ∀ (N : ℕ) (p : List V) (v : V), (v :: p).countP (fun u => ¬ IsStandard b u) ≤ N →
      (v :: p).IsChain (Adj r) → IsStandard b v → (v :: p).getLast? = some v →
      Homotopic r (v :: p) [v]
  | 0, p, v, hN, hc, _, hlast => by
    refine standard_loop r b hb hn _ p v le_rfl hc (fun u hu => ?_) hlast
    by_contra hu'
    have := (List.countP_pos_iff (p := fun u => decide ¬IsStandard b u)).mpr
      ⟨u, hu, decide_eq_true hu'⟩
    omega
  | N + 1, p, v, hN, hc, hv, hlast => by
    by_cases hall : ∀ u ∈ p, IsStandard b u
    · refine standard_loop r b hb hn _ p v le_rfl hc (fun u hu => ?_) hlast
      rcases List.mem_cons.mp hu with rfl | hu
      · exact hv
      · exact hall u hu
    · obtain ⟨w, hw, hws⟩ : ∃ w ∈ p, ¬ IsStandard b w := by
        by_contra h
        exact hall fun u hu => by
          by_contra hu'
          exact h ⟨u, hu, hu'⟩
      obtain ⟨s, t, rfl⟩ := List.append_of_mem hw
      obtain ⟨c, y, rfl⟩ : ∃ c y, t = c :: y := by
        cases t with
        | nil =>
          exfalso
          have hwv : w = v := by
            simpa [List.getLast?_cons, List.getLast?_append] using hlast
          exact hws (hwv ▸ hv)
        | cons c y => exact ⟨c, y, rfl⟩
      obtain ⟨x, a, hxa⟩ : ∃ x a, v :: s = x ++ [a] := by
        rcases List.eq_nil_or_concat' (v :: s) with h | ⟨x, a, h⟩
        · exact absurd h (List.cons_ne_nil _ _)
        · exact ⟨x, a, h⟩
      have hpath : v :: (s ++ w :: c :: y) = x ++ a :: w :: c :: y := by
        calc v :: (s ++ w :: c :: y) = (v :: s) ++ w :: c :: y := rfl
          _ = (x ++ [a]) ++ w :: c :: y := by rw [hxa]
          _ = x ++ a :: w :: c :: y := by simp
      have hc' := hc
      rw [hpath, List.isChain_split] at hc'
      have haw : Adj r a w := (List.isChain_cons_cons.mp hc'.2).1
      have hwc : Adj r w c := (List.isChain_cons_cons.mp (List.isChain_cons_cons.mp hc'.2).2).1
      obtain ⟨m, hm, hhom⟩ := replace r b hb hn x y a w c haw hwc
      have hnew : x ++ a :: (m ++ c :: y) = v :: (s ++ (m ++ c :: y)) := by
        calc x ++ a :: (m ++ c :: y) = (x ++ [a]) ++ (m ++ c :: y) := by simp
          _ = (v :: s) ++ (m ++ c :: y) := by rw [hxa]
          _ = v :: (s ++ (m ++ c :: y)) := rfl
      rw [hpath]
      rw [hnew] at hhom
      refine hhom.trans (simply_connected hn N (s ++ (m ++ c :: y)) v ?_ ?_ hv ?_)
      · have hm0 : m.countP (fun u => ¬ IsStandard b u) = 0 :=
          List.countP_eq_zero.mpr fun u hu => by simpa using hm u hu
        have hN' := hN
        simp only [List.countP_cons, List.countP_append] at hN' ⊢
        simp only [hws, not_false_eq_true, decide_true, ↓reduceIte, hm0] at hN' ⊢
        omega
      · exact hhom.isChain_iff.mp (hpath ▸ hc)
      · have h1 : (v :: (s ++ w :: c :: y)).getLast? = (c :: y).getLast? := by
          rw [← List.cons_append, List.getLast?_append_cons, List.getLast?_cons_cons]
        have h2 : (v :: (s ++ (m ++ c :: y))).getLast? = (c :: y).getLast? := by
          rw [← List.cons_append, ← List.append_assoc, List.getLast?_append_cons]
        rw [h2, ← h1]
        exact hlast

end Complex

end ColumnComplex
end AllPrimeGroups
