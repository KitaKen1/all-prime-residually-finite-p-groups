import AllPrimeGroups.GLSwap
import AllPrimeGroups.CosetTransport

/-! The induction step of manuscript Lemma 11.1.

For `Pres (m + 2) B` the base column is the last one, `x₁` is the last column of the upper-left
block and `x₂` an earlier one. Given that `Pres (m + 1) B → GL_{m+1}(B)` is bijective, the section
`σ` of the stabilizer of the last column is available (`GLLift.lean`). This file checks the
hypotheses of the coset transport of `CosetTransport.lean`:

* `σ` sends the matrix of a generator fixing the last column to that generator (`σ_val`);
* the generators fixing the last column and the swap generate (`gen_top`);
* the stabilizer moves the neighbours and triangles at the base column (`nbr_exists`,
  `tri_exists`), using local columns with a unit entry;
* the stabilizer of two columns is generated by generators fixing both, so conjugation by the swap
  keeps it in the image of `σ` (`stab_conj`);
* the triangle relation is a relation on three coordinates (`triangle_mem`).

By induction from the relations on at most five coordinates, `π` is injective in every rank
(`π_injective_all`). -/

namespace AllPrimeGroups
namespace GLPres

open LocalGL ColumnComplex Matrix

variable {B : Type*} [Ring B] {m : ℕ}

/-- Generators fixing the last standard column: elementary generators whose column is not the
last coordinate, and diagonal generators away from it. -/
def Gen.FixLast : Gen (m + 1) B → Prop
  | .elem p _ => p.col ≠ Fin.last m
  | .diag i _ => i ≠ Fin.last m

theorem Gen.val_last (g : Gen (m + 1) B) (hg : g.FixLast) :
    ((g.val : (Matrix (Fin (m + 1)) (Fin (m + 1)) B)ˣ) : Matrix (Fin (m + 1)) (Fin (m + 1)) B) *ᵥ
      Pi.single (Fin.last m) 1 = Pi.single (Fin.last m) 1 := by
  cases g with
  | elem p c =>
    have hcol : p.col ≠ Fin.last m := hg
    simp only [Gen.val, e_mulVec]
    funext l
    by_cases hl : l = p.row
    · subst hl
      simp [Pi.single_apply, hcol]
    · simp [hl]
  | diag i u =>
    have hi : i ≠ Fin.last m := hg
    simp only [Gen.val, d_mulVec]
    funext l
    by_cases hl : l = i
    · subst hl
      simp [hi]
    · simp [hl]

theorem Gen.val_mem_range (g : Gen (m + 1) B) (hg : g.FixLast) : g.val ∈ (ι (m := m) (B := B)).range :=
  exists_ι _ (g.val_last hg)

/-- Words in the generators fixing the last column. -/
def fixLastWords : Subgroup (FreeGroup (Gen (m + 1) B)) :=
  Subgroup.closure (FreeGroup.of '' {g | g.FixLast})

theorem ev_mem_of_fixLastWords {w : FreeGroup (Gen (m + 1) B)} (hw : w ∈ fixLastWords) :
    ev w ∈ (ι (m := m) (B := B)).range := by
  have h : fixLastWords (m := m) (B := B) ≤ (ι (m := m) (B := B)).range.comap ev := by
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨g, hg, rfl⟩
    rw [SetLike.mem_coe, Subgroup.mem_comap, ev_of]
    exact g.val_mem_range hg
  exact h hw

section Section
variable (ψ : (Matrix (Fin m) (Fin m) B)ˣ →* Pres m B) (hψ : ∀ A, π (ψ A) = A)
  (hψπ : ∀ x, ψ (π x) = x)

theorem σ_ι (x : Row m B ⋊[rowAct] (Matrix (Fin m) (Fin m) B)ˣ) :
    σ ψ hψ ⟨ι x, x, rfl⟩ = κ ψ hψ x := by
  show κ ψ hψ ((MonoidHom.ofInjective ι_injective).symm ⟨ι x, x, rfl⟩) = κ ψ hψ x
  congr 1
  apply (MonoidHom.ofInjective (ι_injective (m := m) (B := B))).injective
  rw [MulEquiv.apply_symm_apply]
  apply Subtype.ext
  rw [MonoidHom.ofInjective_apply]

theorem σ_eq {p : (ι (m := m) (B := B)).range} (x : Row m B ⋊[rowAct] (Matrix (Fin m) (Fin m) B)ˣ)
    (hx : (p : (Matrix (Fin (m + 1)) (Fin (m + 1)) B)ˣ) = ι x) : σ ψ hψ p = κ ψ hψ x := by
  have : p = ⟨ι x, x, rfl⟩ := Subtype.ext hx
  rw [this, σ_ι]

theorem Root.ext' {n : ℕ} {p q : Root n} (h1 : p.row = q.row) (h2 : p.col = q.col) : p = q := by
  cases p
  cases q
  simp only at h1 h2
  subst h1
  subst h2
  rfl

theorem rowMat_single (b : Fin m) (c : B) :
    rowMat (Pi.single b c) = Elementary.e (rowRoot b) c := by
  apply units_ext_mulVec
  intro x
  rw [rowMat_mulVec, e_mulVec]
  funext l
  by_cases hl : l = Fin.last m
  · subst hl
    simp [Pi.single_apply]
  · simp [hl]

theorem π_of (g : Gen m B) : π (PresentedGroup.of g) = g.val := by
  show π (mk (FreeGroup.of g)) = g.val
  rw [π_mk, ev_of]

include hψπ in
/-- The key lemma: σ sends the matrix of a generator fixing the last column to the generator. -/
theorem σ_val (g : Gen (m + 1) B) (hg : g.FixLast) :
    σ ψ hψ ⟨g.val, g.val_mem_range hg⟩ = PresentedGroup.of g := by
  cases g with
  | elem p c =>
    have hcol : p.col ≠ Fin.last m := hg
    obtain ⟨b, hb⟩ := Fin.exists_castSucc_eq.mpr hcol
    by_cases hrow : p.row = Fin.last m
    · have hp : p = rowRoot b := Root.ext' hrow hb.symm
      subst hp
      rw [σ_eq ψ hψ (SemidirectProduct.inl (Multiplicative.ofAdd (Pi.single b c)))
        (by rw [ι_inl, toAdd_ofAdd, rowMat_single]; rfl)]
      simp only [κ, SemidirectProduct.lift_inl, rowLift_single]
      rfl
    · obtain ⟨a, ha⟩ := Fin.exists_castSucc_eq.mpr hrow
      have hab : a ≠ b := by
        intro e
        apply p.ne
        rw [← ha, ← hb, e]
      have hp : p = (⟨a, b, hab⟩ : Root m).map (Kernel.coordinateIndex m)
          (Kernel.coordinateIndex_injective m) := Root.ext' ha.symm hb.symm
      subst hp
      rw [σ_eq ψ hψ (SemidirectProduct.inr (Elementary.e ⟨a, b, hab⟩ c))
        (by rw [ι_inr, Kernel.padUnitsHom_e]; rfl)]
      simp only [κ, SemidirectProduct.lift_inr, MonoidHom.comp_apply]
      rw [show (Elementary.e ⟨a, b, hab⟩ c : (Matrix (Fin m) (Fin m) B)ˣ) =
        π (PresentedGroup.of (Gen.elem ⟨a, b, hab⟩ c)) from (π_of (Gen.elem ⟨a, b, hab⟩ c)).symm,
        hψπ, shift_of]
      rfl
  | diag i u =>
    have hi : i ≠ Fin.last m := hg
    obtain ⟨a, ha⟩ := Fin.exists_castSucc_eq.mpr hi
    subst ha
    rw [σ_eq ψ hψ (SemidirectProduct.inr (d a u)) (by rw [ι_inr, pad_d]; rfl)]
    simp only [κ, SemidirectProduct.lift_inr, MonoidHom.comp_apply]
    rw [show (d a u : (Matrix (Fin m) (Fin m) B)ˣ) = π (PresentedGroup.of (Gen.diag a u)) from
      (π_of (Gen.diag a u)).symm, hψπ, shift_of]
    rfl

include hψπ in
/-- `σ` of a word in generators fixing the last column is the word. -/
theorem σ_ev {w : FreeGroup (Gen (m + 1) B)} (hw : w ∈ fixLastWords) :
    σ ψ hψ ⟨ev w, ev_mem_of_fixLastWords hw⟩ = mk w := by
  induction hw using Subgroup.closure_induction with
  | mem x hx =>
    obtain ⟨g, hg, rfl⟩ := hx
    have e : (⟨ev (FreeGroup.of g), ev_mem_of_fixLastWords (Subgroup.subset_closure ⟨g, hg, rfl⟩)⟩ :
        (ι (m := m) (B := B)).range) = ⟨g.val, g.val_mem_range hg⟩ := Subtype.ext (ev_of g)
    rw [e, σ_val ψ hψ hψπ g hg]
    rfl
  | one =>
    have e : (⟨ev 1, ev_mem_of_fixLastWords (Subgroup.one_mem _)⟩ :
        (ι (m := m) (B := B)).range) = 1 := Subtype.ext (map_one ev)
    rw [e, map_one, map_one]
  | mul x y hx hy ihx ihy =>
    have e : (⟨ev (x * y), ev_mem_of_fixLastWords (Subgroup.mul_mem _ hx hy)⟩ :
        (ι (m := m) (B := B)).range) =
        ⟨ev x, ev_mem_of_fixLastWords hx⟩ * ⟨ev y, ev_mem_of_fixLastWords hy⟩ :=
      Subtype.ext (map_mul ev x y)
    rw [e, map_mul, ihx, ihy, map_mul]
  | inv x hx ihx =>
    have e : (⟨ev x⁻¹, ev_mem_of_fixLastWords (Subgroup.inv_mem _ hx)⟩ :
        (ι (m := m) (B := B)).range) = ⟨ev x, ev_mem_of_fixLastWords hx⟩⁻¹ :=
      Subtype.ext (map_inv ev x)
    rw [e, map_inv, ihx, map_inv]

end Section

/-! ### Generators fixing columns -/

/-- The subgroup generated by the matrices of the generators with a property. -/
def genSub {n : ℕ} (P : Gen n B → Prop) : Subgroup (Matrix (Fin n) (Fin n) B)ˣ :=
  Subgroup.closure {x | ∃ g, P g ∧ Gen.val g = x}

theorem val_mem_genSub {n : ℕ} {P : Gen n B → Prop} {g : Gen n B} (hg : P g) :
    g.val ∈ genSub P :=
  Subgroup.subset_closure ⟨g, hg, rfl⟩

/-- The transposition of the last two coordinates. -/
abbrev lastSwap (m : ℕ) : Equiv.Perm (Fin (m + 1 + 1)) :=
  Equiv.swap (Fin.last (m + 1)) (Fin.last m).castSucc

theorem lastSwap_castSucc {b : Fin (m + 1)} (hb : b ≠ Fin.last m) :
    lastSwap m b.castSucc = b.castSucc :=
  Equiv.swap_apply_of_ne_of_ne (castSucc_ne_last' b) (fun e => hb (Fin.castSucc_injective _ e))

theorem castSucc_last_ne (c : Fin m) : (Fin.last m).castSucc ≠ c.castSucc.castSucc :=
  fun e => castSucc_ne_last' c (Fin.castSucc_injective _ e).symm

/-- Generators fixing the last column, also after the transposition of the last two
coordinates. -/
def Gen.FixTwo (g : Gen (m + 1 + 1) B) : Prop := g.FixLast ∧ (g.perm (lastSwap m)).FixLast

theorem Gen.fixTwo_cast (g : Gen (m + 1) B) (hg : g.FixLast) : (Gen.cast g).FixTwo := by
  cases g with
  | elem p a =>
    have hc : p.col ≠ Fin.last m := hg
    refine ⟨castSucc_ne_last' p.col, ?_⟩
    show lastSwap m p.col.castSucc ≠ Fin.last (m + 1)
    rw [lastSwap_castSucc hc]
    exact castSucc_ne_last' _
  | diag i u =>
    have hi : i ≠ Fin.last m := hg
    refine ⟨castSucc_ne_last' i, ?_⟩
    show lastSwap m i.castSucc ≠ Fin.last (m + 1)
    rw [lastSwap_castSucc hi]
    exact castSucc_ne_last' _

theorem Gen.perm_swap_swap {n : ℕ} (a b : Fin n) (g : Gen n B) :
    (g.perm (Equiv.swap a b)).perm (Equiv.swap a b) = g := by
  cases g with
  | elem p c =>
    cases p
    simp only [Gen.perm, Equiv.swap_apply_self]
  | diag i u => simp only [Gen.perm, Equiv.swap_apply_self]

theorem Gen.fixLast_perm (g : Gen (m + 1 + 1) B) (hg : ¬ g.FixLast) :
    (g.perm (lastSwap m)).FixLast := by
  cases g with
  | elem p c =>
    have hc : p.col = Fin.last (m + 1) := by
      by_contra h
      exact hg h
    show lastSwap m p.col ≠ Fin.last (m + 1)
    rw [hc, lastSwap, Equiv.swap_apply_left]
    exact castSucc_ne_last' _
  | diag i u =>
    have hi : i = Fin.last (m + 1) := by
      by_contra h
      exact hg h
    show lastSwap m i ≠ Fin.last (m + 1)
    rw [hi, lastSwap, Equiv.swap_apply_left]
    exact castSucc_ne_last' _

theorem fixTwo_aux (r : Fin (m + 1) → B) (A : (Matrix (Fin (m + 1)) (Fin (m + 1)) B)ˣ)
    (h : ((rowMat r * Kernel.padUnitsHom A : (Matrix (Fin (m + 1 + 1)) (Fin (m + 1 + 1)) B)ˣ) :
      Matrix (Fin (m + 1 + 1)) (Fin (m + 1 + 1)) B) *ᵥ Pi.single (Fin.last m).castSucc 1 =
        Pi.single (Fin.last m).castSucc 1) :
    (A : Matrix (Fin (m + 1)) (Fin (m + 1)) B) *ᵥ Pi.single (Fin.last m) 1 =
      Pi.single (Fin.last m) 1 ∧ r (Fin.last m) = 0 := by
  rw [Units.val_mul, ← Matrix.mulVec_mulVec, pad_mulVec, rowMat_mulVec] at h
  have hx : (fun b : Fin (m + 1) =>
      (Pi.single (Fin.last m).castSucc (1 : B) : Fin (m + 1 + 1) → B) b.castSucc) =
        Pi.single (Fin.last m) 1 := by
    funext b
    simp [Pi.single_apply]
  rw [hx] at h
  have h1 : (A : Matrix (Fin (m + 1)) (Fin (m + 1)) B) *ᵥ Pi.single (Fin.last m) 1 =
      Pi.single (Fin.last m) 1 := by
    funext a
    have := congrFun h a.castSucc
    simp only [castSucc_ne_last', ↓reduceIte, Fin.lastCases_castSucc] at this
    rw [this]
    simp [Pi.single_apply]
  refine ⟨h1, ?_⟩
  have := congrFun h (Fin.last (m + 1))
  simpa [h1, Pi.single_apply] using this

section Generation
variable {K : Type*} [Field K] (ε : B →+* K) (hunit : ∀ b : B, ε b ≠ 0 → IsUnit b)

include hunit in
/-- The stabilizer of the last standard column is generated by the generators fixing it. -/
theorem mem_genSub_fixLast (q : (Matrix (Fin (m + 1)) (Fin (m + 1)) B)ˣ)
    (hq : (q : Matrix (Fin (m + 1)) (Fin (m + 1)) B) *ᵥ Pi.single (Fin.last m) 1 =
      Pi.single (Fin.last m) 1) :
    q ∈ genSub (Gen.FixLast (m := m) (B := B)) := by
  obtain ⟨y, rfl⟩ := exists_ι q hq
  rw [← SemidirectProduct.inl_left_mul_inr_right y, map_mul, ι_inl, ι_inr]
  refine Subgroup.mul_mem _ ?_ ?_
  · rw [rowMat, rowProd]
    apply Subgroup.list_prod_mem
    intro x hx
    obtain ⟨b, -, rfl⟩ := List.mem_map.mp hx
    exact val_mem_genSub (P := Gen.FixLast (m := m) (B := B))
      (g := Gen.elem (rowRoot b) (Multiplicative.toAdd y.left b)) (castSucc_ne_last' b)
  · have h : GE m B ≤ (genSub (Gen.FixLast (m := m) (B := B))).comap Kernel.padUnitsHom := by
      apply (Subgroup.closure_le _).mpr
      rintro _ (⟨p, a, rfl⟩ | ⟨i, u, rfl⟩)
      · have := val_mem_genSub (P := Gen.FixLast (m := m) (B := B))
          (g := Gen.cast (Gen.elem p a)) (castSucc_ne_last' p.col)
        rwa [Gen.cast_val] at this
      · have := val_mem_genSub (P := Gen.FixLast (m := m) (B := B))
          (g := Gen.cast (Gen.diag i u)) (castSucc_ne_last' i)
        rwa [Gen.cast_val] at this
    exact h (mem_GE ε hunit m _)

include hunit in
/-- The stabilizer of the last two standard columns is generated by the generators fixing them. -/
theorem mem_genSub_fixTwo (q : (Matrix (Fin (m + 1 + 1)) (Fin (m + 1 + 1)) B)ˣ)
    (hq : (q : Matrix (Fin (m + 1 + 1)) (Fin (m + 1 + 1)) B) *ᵥ Pi.single (Fin.last (m + 1)) 1 =
      Pi.single (Fin.last (m + 1)) 1)
    (hq' : (q : Matrix (Fin (m + 1 + 1)) (Fin (m + 1 + 1)) B) *ᵥ
      Pi.single (Fin.last m).castSucc 1 = Pi.single (Fin.last m).castSucc 1) :
    q ∈ genSub (Gen.FixTwo (m := m) (B := B)) := by
  obtain ⟨y, rfl⟩ := exists_ι q hq
  rw [← SemidirectProduct.inl_left_mul_inr_right y, map_mul, ι_inl, ι_inr] at hq' ⊢
  obtain ⟨hA, hr⟩ := fixTwo_aux _ _ hq'
  refine Subgroup.mul_mem _ ?_ ?_
  · rw [rowMat, rowProd]
    apply Subgroup.list_prod_mem
    intro x hx
    obtain ⟨b, -, rfl⟩ := List.mem_map.mp hx
    by_cases hb : b = Fin.last m
    · subst hb
      rw [rowFactor, hr, Elementary.e_zero]
      exact Subgroup.one_mem _
    · refine val_mem_genSub (P := Gen.FixTwo (m := m) (B := B))
        (g := Gen.elem (rowRoot b) (Multiplicative.toAdd y.left b)) ⟨castSucc_ne_last' b, ?_⟩
      show lastSwap m b.castSucc ≠ Fin.last (m + 1)
      rw [lastSwap_castSucc hb]
      exact castSucc_ne_last' _
  · have h : genSub (Gen.FixLast (m := m) (B := B)) ≤
        (genSub (Gen.FixTwo (m := m) (B := B))).comap Kernel.padUnitsHom := by
      apply (Subgroup.closure_le _).mpr
      rintro _ ⟨g, hg, rfl⟩
      have := val_mem_genSub (P := Gen.FixTwo (m := m) (B := B)) (Gen.fixTwo_cast g hg)
      rwa [Gen.cast_val] at this
    exact h (mem_genSub_fixLast ε hunit _ hA)

include hunit in
/-- A standard column can be moved to any column with a unit entry outside a set of fixed
standard columns, fixing those. -/
theorem exists_move {n : ℕ} (i : Fin n) (S : Finset (Fin n)) (hi : i ∉ S) (v : Fin n → B)
    (hv : ∃ j, j ∉ S ∧ ε (v j) ≠ 0) :
    ∃ M : (Matrix (Fin n) (Fin n) B)ˣ, (M : Matrix (Fin n) (Fin n) B) *ᵥ Pi.single i 1 = v ∧
      ∀ l ∈ S, (M : Matrix (Fin n) (Fin n) B) *ᵥ Pi.single l 1 = Pi.single l 1 := by
  by_cases hvi : ε (v i) = 0
  · obtain ⟨j, hjS, hj⟩ := hv
    have hji : i ≠ j := by
      rintro rfl
      exact hj hvi
    set E : (Matrix (Fin n) (Fin n) B)ˣ := Elementary.e (⟨i, j, hji⟩ : Root n) (1 : B) with hE
    have hv'i : ((E : Matrix (Fin n) (Fin n) B) *ᵥ v) i = v i + v j := by
      rw [hE, e_mulVec]
      simp
    have hu : ε (((E : Matrix (Fin n) (Fin n) B) *ᵥ v) i) ≠ 0 := by
      rw [hv'i, map_add, hvi, zero_add]
      exact hj
    obtain ⟨u, hu'⟩ := hunit _ hu
    refine ⟨Elementary.e ⟨i, j, hji⟩ (-1) * replaceCol i ((E : Matrix (Fin n) (Fin n) B) *ᵥ v) u,
      ?_, ?_⟩
    · rw [Units.val_mul, ← Matrix.mulVec_mulVec, replaceCol_single i _ u hu'.symm, hE,
        Matrix.mulVec_mulVec, ← Units.val_mul, ← Elementary.e_add, neg_add_cancel,
        Elementary.e_zero, Units.val_one, Matrix.one_mulVec]
    · intro l hl
      have hli : l ≠ i := fun e => hi (e ▸ hl)
      have hlj : l ≠ j := fun e => hjS (e ▸ hl)
      rw [Units.val_mul, ← Matrix.mulVec_mulVec, replaceCol_single_ne i _ u hu'.symm hli, e_mulVec]
      funext a
      simp [Pi.single_apply, hlj.symm]
  · obtain ⟨u, hu'⟩ := hunit _ hvi
    exact ⟨replaceCol i v u, replaceCol_single i v u hu'.symm,
      fun l hl => replaceCol_single_ne i v u hu'.symm (fun e => hi (e ▸ hl))⟩

end Generation

/-! ### Reductions -/

section Reduction
variable {K : Type*} [Field K]

theorem exists_entry_of_ind2 {n : ℕ} {i : Fin n} {x : Fin n → K}
    (h : Ind2 (k := K) (Pi.single i (1 : K)) x) : ∃ j, j ≠ i ∧ x j ≠ 0 := by
  by_contra hx'
  have hx : ∀ j, j ≠ i → x j = 0 := fun j hj => by_contra fun h => hx' ⟨j, hj, h⟩
  have e : x i • (Pi.single i (1 : K) : Fin n → K) + (-1 : K) • x = 0 := by
    funext j
    by_cases hj : j = i
    · subst hj
      simp
    · simp [hj, hx j hj]
  exact neg_ne_zero.mpr one_ne_zero (h _ _ e).2

theorem exists_entry_of_ind3 {n : ℕ} {i i' : Fin n} {x : Fin n → K}
    (h : Ind3 (k := K) (Pi.single i (1 : K)) (Pi.single i' 1) x) :
    ∃ j, j ≠ i ∧ j ≠ i' ∧ x j ≠ 0 := by
  have hii' : i ≠ i' := by
    rintro rfl
    have := h 1 (-1) 0 (by simp)
    exact one_ne_zero this.1
  by_contra hx'
  have hx : ∀ j, j ≠ i → j ≠ i' → x j = 0 := fun j hj hj' => by_contra fun h => hx' ⟨j, hj, hj', h⟩
  have e : x i • (Pi.single i (1 : K) : Fin n → K) + x i' • Pi.single i' 1 + (-1 : K) • x = 0 := by
    funext j
    by_cases hj : j = i
    · subst hj
      simp [hii']
    · by_cases hj' : j = i'
      · subst hj'
        simp [hj]
      · simp [hj, hj', hx j hj hj']
  exact neg_ne_zero.mpr one_ne_zero (h _ _ _ e).2.2

end Reduction

/-! ### Swaps -/

/-- The standard columns. -/
abbrev ecol {n : ℕ} (i : Fin n) : Col n B := Pi.single i 1

theorem single_swap {n : ℕ} (a b l : Fin n) :
    (fun k => (Pi.single l (1 : B) : Fin n → B) (Equiv.swap a b k)) =
      Pi.single (Equiv.swap a b l) 1 := by
  funext k
  simp only [Pi.single_apply, Equiv.swap_apply_eq_iff]

set_option linter.unusedSimpArgs false in
theorem swap_braid {n : ℕ} (a b c : Fin n) (hab : a ≠ b) (hbc : b ≠ c) (hac : a ≠ c) (k : Fin n) :
    Equiv.swap a b (Equiv.swap b c (Equiv.swap a b (Equiv.swap b c (Equiv.swap a b k)))) =
      Equiv.swap b c k := by
  by_cases ha : k = a
  · subst ha
    simp [Equiv.swap_apply_of_ne_of_ne, hab, hbc, hac, hab.symm, hbc.symm, hac.symm]
  · by_cases hb : k = b
    · subst hb
      simp [Equiv.swap_apply_of_ne_of_ne, hab, hbc, hac, hab.symm, hbc.symm, hac.symm]
    · by_cases hc : k = c
      · subst hc
        simp [Equiv.swap_apply_of_ne_of_ne, hab, hbc, hac, hab.symm, hbc.symm, hac.symm]
      · simp [Equiv.swap_apply_of_ne_of_ne, ha, hb, hc]

/-- The swap of the last two coordinates in the presentation. -/
def sw : Pres (m + 1 + 1) B :=
  mk (swapWord (Fin.last (m + 1)) (Fin.last m).castSucc (last_ne_castSucc' _))

theorem sw_sq : (sw : Pres (m + 1 + 1) B) * sw = 1 := swap_sq _ _ _

theorem sw_inv : (sw : Pres (m + 1 + 1) B)⁻¹ = sw := inv_eq_of_mul_eq_one_right sw_sq

theorem sw_inv_conj (x : Pres (m + 1 + 1) B) : sw⁻¹ * x * sw = sw * x * sw⁻¹ := by
  rw [sw_inv]

theorem sw_conj (g : Gen (m + 1 + 1) B) :
    sw * PresentedGroup.of g * sw⁻¹ = PresentedGroup.of (g.perm (lastSwap m)) :=
  conj_swap _ _ _ g

theorem sw_smul (l : Fin (m + 1 + 1)) :
    π (sw : Pres (m + 1 + 1) B) • (ecol l : Col (m + 1 + 1) B) =
      (ecol (lastSwap m l) : Col (m + 1 + 1) B) := by
  rw [smul_def, sw, π_mk, swapWord_mulVec]
  exact single_swap _ _ l

theorem sw_s₀ : π (sw : Pres (m + 1 + 1) B) •
    (ecol (Fin.last (m + 1)) : Col (m + 1 + 1) B) =
      (ecol (Fin.last m).castSucc : Col (m + 1 + 1) B) := by
  rw [sw_smul, lastSwap, Equiv.swap_apply_left]

theorem sw_s₂ (c : Fin m) : π (sw : Pres (m + 1 + 1) B) •
    (ecol c.castSucc.castSucc : Col (m + 1 + 1) B) =
      (ecol c.castSucc.castSucc : Col (m + 1 + 1) B) := by
  rw [sw_smul, lastSwap, Equiv.swap_apply_of_ne_of_ne (castSucc_ne_last' _)
    (castSucc_last_ne c).symm]

theorem swapWord_mem_fixLastWords {a b : Fin (m + 1)} (h : a ≠ b) (ha : a ≠ Fin.last m)
    (hb : b ≠ Fin.last m) : swapWord (B := B) a b h ∈ fixLastWords := by
  unfold swapWord
  refine Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.mul_mem _ ?_ ?_) ?_) ?_
  · exact Subgroup.subset_closure ⟨Gen.elem ⟨a, b, h⟩ 1, hb, rfl⟩
  · exact Subgroup.subset_closure ⟨Gen.elem ⟨b, a, h.symm⟩ (-1), ha, rfl⟩
  · exact Subgroup.subset_closure ⟨Gen.elem ⟨a, b, h⟩ 1, hb, rfl⟩
  · exact Subgroup.subset_closure ⟨Gen.diag a (-1), ha, rfl⟩

/-- The transposition of the two columns before the last one, in the stabilizer. -/
def swT (c : Fin m) : (ι (m := m + 1) (B := B)).range :=
  ⟨ev (swapWord (Fin.last m).castSucc c.castSucc.castSucc (castSucc_last_ne c)),
    ev_mem_of_fixLastWords (swapWord_mem_fixLastWords _ (castSucc_ne_last' _) (castSucc_ne_last' _))⟩

theorem swT_t₁ (c : Fin m) :
    ((swT c : (ι (m := m + 1) (B := B)).range) : (Matrix (Fin (m + 1 + 1)) (Fin (m + 1 + 1)) B)ˣ) •
      (ecol (Fin.last m).castSucc : Col (m + 1 + 1) B) =
        (ecol c.castSucc.castSucc : Col (m + 1 + 1) B) := by
  show ((ev (swapWord (B := B) (Fin.last m).castSucc c.castSucc.castSucc (castSucc_last_ne c)) :
    (Matrix (Fin (m + 1 + 1)) (Fin (m + 1 + 1)) B)ˣ) : Matrix (Fin (m + 1 + 1)) (Fin (m + 1 + 1)) B)
      *ᵥ Pi.single (Fin.last m).castSucc 1 = Pi.single c.castSucc.castSucc 1
  rw [swapWord_mulVec, single_swap, Equiv.swap_apply_left]

theorem fix₀' (p : (ι (m := m) (B := B)).range) :
    (p : (Matrix (Fin (m + 1)) (Fin (m + 1)) B)ˣ) •
      (ecol (Fin.last m) : Col (m + 1) B) = (ecol (Fin.last m) : Col (m + 1) B) := by
  obtain ⟨_, y, rfl⟩ := p
  exact ι_last y

/-! ### The transport data -/

section Transport
variable {K : Type*} [Field K] (ε : B →+* K) (hunit : ∀ b : B, ε b ≠ 0 → IsUnit b)

include hunit in
theorem nbr_exists (w : Col (m + 1 + 1) B)
    (hw : Adj (red ε) (ecol (Fin.last (m + 1)) : Col (m + 1 + 1) B) w) :
    ∃ p : (ι (m := m + 1) (B := B)).range,
      (p : (Matrix (Fin (m + 1 + 1)) (Fin (m + 1 + 1)) B)ˣ) •
        (ecol (Fin.last m).castSucc : Col (m + 1 + 1) B) = w := by
  unfold Adj at hw
  rw [red_single] at hw
  obtain ⟨j, hj, hjw⟩ := exists_entry_of_ind2 hw
  obtain ⟨M, hM, hMS⟩ := exists_move ε hunit (Fin.last m).castSucc {Fin.last (m + 1)}
    (by simp) w ⟨j, by simpa using hj, hjw⟩
  exact ⟨⟨M, exists_ι M (hMS _ (Finset.mem_singleton_self _))⟩, hM⟩

include hunit in
theorem tri_exists (c : Fin m) (w u : Col (m + 1 + 1) B)
    (h : Tri (red ε) (ecol (Fin.last (m + 1)) : Col (m + 1 + 1) B) w u) :
    ∃ p : (ι (m := m + 1) (B := B)).range,
      (p : (Matrix (Fin (m + 1 + 1)) (Fin (m + 1 + 1)) B)ˣ) •
        (ecol (Fin.last m).castSucc : Col (m + 1 + 1) B) = w ∧
      (p : (Matrix (Fin (m + 1 + 1)) (Fin (m + 1 + 1)) B)ˣ) •
        (ecol c.castSucc.castSucc : Col (m + 1 + 1) B) = u := by
  obtain ⟨p₁, hp₁⟩ := nbr_exists ε hunit w h.adj12
  have hfix : (p₁ : (Matrix (Fin (m + 1 + 1)) (Fin (m + 1 + 1)) B)ˣ)⁻¹ •
      (ecol (Fin.last (m + 1)) : Col (m + 1 + 1) B) =
        (ecol (Fin.last (m + 1)) : Col (m + 1 + 1) B) :=
    inv_smul_eq_iff.mpr (fix₀' p₁).symm
  have h' : Tri (red ε) (ecol (Fin.last (m + 1)) : Col (m + 1 + 1) B)
      (ecol (Fin.last m).castSucc : Col (m + 1 + 1) B)
      ((p₁ : (Matrix (Fin (m + 1 + 1)) (Fin (m + 1 + 1)) B)ˣ)⁻¹ • u) := by
    have := tri_smul ε (p₁ : (Matrix (Fin (m + 1 + 1)) (Fin (m + 1 + 1)) B)ˣ)⁻¹ _ _ _ h
    rwa [← hp₁, inv_smul_smul, hfix] at this
  unfold Tri at h'
  rw [red_single, red_single] at h'
  obtain ⟨j, hj0, hj1, hju⟩ := exists_entry_of_ind3 h'
  obtain ⟨M, hM, hMS⟩ := exists_move ε hunit c.castSucc.castSucc
    {Fin.last (m + 1), (Fin.last m).castSucc} (by simp)
    ((p₁ : (Matrix (Fin (m + 1 + 1)) (Fin (m + 1 + 1)) B)ˣ)⁻¹ • u) ⟨j, by simp [hj0, hj1], hju⟩
  have hM₀ : ((⟨M, exists_ι M (hMS _ (by simp))⟩ : (ι (m := m + 1) (B := B)).range) :
      (Matrix (Fin (m + 1 + 1)) (Fin (m + 1 + 1)) B)ˣ) •
        (ecol (Fin.last m).castSucc : Col (m + 1 + 1) B) =
          (ecol (Fin.last m).castSucc : Col (m + 1 + 1) B) := hMS _ (by simp)
  refine ⟨p₁ * ⟨M, exists_ι M (hMS _ (by simp))⟩, ?_, ?_⟩
  · rw [Subgroup.coe_mul, mul_smul, hM₀, hp₁]
  · rw [Subgroup.coe_mul, mul_smul]
    show (p₁ : (Matrix (Fin (m + 1 + 1)) (Fin (m + 1 + 1)) B)ˣ) •
      (show Col (m + 1 + 1) B from
        (M : Matrix (Fin (m + 1 + 1)) (Fin (m + 1 + 1)) B) *ᵥ Pi.single c.castSucc.castSucc 1) = u
    rw [hM, smul_inv_smul]

variable (ψ : (Matrix (Fin (m + 1)) (Fin (m + 1)) B)ˣ →* Pres (m + 1) B) (hψ : ∀ A, π (ψ A) = A)
  (hψπ : ∀ x, ψ (π x) = x)

include hψπ in
theorem gen_top : Subgroup.closure (Set.range (σ ψ hψ) ∪ {sw}) = ⊤ := by
  rw [eq_top_iff, ← PresentedGroup.closure_range_of, Subgroup.closure_le]
  rintro _ ⟨g, rfl⟩
  have hσ : ∀ g' : Gen (m + 1 + 1) B, g'.FixLast →
      PresentedGroup.of g' ∈ Subgroup.closure (Set.range (σ ψ hψ) ∪ {sw}) :=
    fun g' hg' => Subgroup.subset_closure (Or.inl ⟨_, σ_val ψ hψ hψπ g' hg'⟩)
  by_cases hg : g.FixLast
  · exact hσ g hg
  · have hs : (sw : Pres (m + 1 + 1) B) ∈ Subgroup.closure (Set.range (σ ψ hψ) ∪ {sw}) :=
      Subgroup.subset_closure (Or.inr rfl)
    have e : (PresentedGroup.of g : Pres (m + 1 + 1) B) =
        sw * PresentedGroup.of (g.perm (lastSwap m)) * sw⁻¹ := by
      rw [sw_conj, Gen.perm_swap_swap]
    rw [SetLike.mem_coe, e]
    exact Subgroup.mul_mem _ (Subgroup.mul_mem _ hs (hσ _ (g.fixLast_perm hg)))
      (Subgroup.inv_mem _ hs)

include hunit hψπ in
theorem stab_conj (q : (ι (m := m + 1) (B := B)).range)
    (hq : (q : (Matrix (Fin (m + 1 + 1)) (Fin (m + 1 + 1)) B)ˣ) •
      (ecol (Fin.last m).castSucc : Col (m + 1 + 1) B) =
        (ecol (Fin.last m).castSucc : Col (m + 1 + 1) B)) :
    sw⁻¹ * σ ψ hψ q * sw ∈ (σ ψ hψ).range := by
  let φ : (ι (m := m + 1) (B := B)).range →* Pres (m + 1 + 1) B :=
    (MulAut.conj (sw : Pres (m + 1 + 1) B)⁻¹).toMonoidHom.comp (σ ψ hψ)
  have hφ : ∀ x, φ x = sw⁻¹ * σ ψ hψ x * sw := fun x => by
    simp only [φ, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, MulAut.conj_apply, inv_inv]
  have hle : genSub (Gen.FixTwo (m := m) (B := B)) ≤
      ((σ ψ hψ).range.comap φ).map (ι (m := m + 1) (B := B)).range.subtype := by
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨g, ⟨hg1, hg2⟩, rfl⟩
    refine ⟨⟨g.val, g.val_mem_range hg1⟩, ?_, rfl⟩
    rw [SetLike.mem_coe, Subgroup.mem_comap, hφ, σ_val ψ hψ hψπ g hg1, sw_inv_conj, sw_conj]
    exact ⟨⟨_, Gen.val_mem_range _ hg2⟩, σ_val ψ hψ hψπ _ hg2⟩
  obtain ⟨q', hq', he⟩ := hle (mem_genSub_fixTwo ε hunit
    (q : (Matrix (Fin (m + 1 + 1)) (Fin (m + 1 + 1)) B)ˣ) (fix₀' q) hq)
  have e : q' = q := Subtype.ext he
  rw [e, SetLike.mem_coe, Subgroup.mem_comap, hφ] at hq'
  exact hq'

include hψπ in
theorem σ_swT (c : Fin m) : σ ψ hψ (swT c) =
    mk (swapWord (Fin.last m).castSucc c.castSucc.castSucc (castSucc_last_ne c)) :=
  σ_ev ψ hψ hψπ (swapWord_mem_fixLastWords _ (castSucc_ne_last' _) (castSucc_ne_last' _))

include hψπ in
theorem triangle_mem (c : Fin m) :
    sw⁻¹ * (σ ψ hψ (swT c))⁻¹ * sw * σ ψ hψ (swT c) * sw ∈ (σ ψ hψ).range := by
  refine ⟨swT c, ?_⟩
  rw [σ_swT ψ hψ hψπ c]
  symm
  simp only [sw, ← map_inv, ← map_mul]
  have hT : ∀ {a b : Fin (m + 1 + 1)}, a ∈ ({Fin.last (m + 1), (Fin.last m).castSucc,
      c.castSucc.castSucc} : Finset (Fin (m + 1 + 1))) → b ∈ ({Fin.last (m + 1),
      (Fin.last m).castSucc, c.castSucc.castSucc} : Finset (Fin (m + 1 + 1))) →
      ({a, b} : Finset (Fin (m + 1 + 1))) ⊆ {Fin.last (m + 1), (Fin.last m).castSucc,
        c.castSucc.castSucc} := fun ha hb => Finset.insert_subset ha (Finset.singleton_subset_iff.mpr hb)
  have h01 := supported_mono (hT (by simp) (by simp))
    (swapWord_mem (B := B) _ _ (last_ne_castSucc' (Fin.last m)))
  have h12 := supported_mono (hT (by simp) (by simp)) (swapWord_mem (B := B) _ _ (castSucc_last_ne c))
  apply mk_eq_of_ev_eq (Finset.card_le_three.trans (by norm_num))
    (Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.mul_mem _
      (Subgroup.inv_mem _ h01) (Subgroup.inv_mem _ h12)) h01) h12) h01) h12
  rw [map_mul, map_mul, map_mul, map_mul, map_inv, map_inv]
  apply units_ext_mulVec
  intro x
  simp only [Units.val_mul, ← Matrix.mulVec_mulVec, swapWord_mulVec, swapWord_inv_mulVec]
  funext k
  rw [swap_braid _ _ _ (last_ne_castSucc' _) (castSucc_last_ne c) (last_ne_castSucc' _)]

include hunit hψπ in
/-- The coset transport data for `GL_{m+2}`, given the section for `GL_{m+1}`. -/
noncomputable def transportData (c : Fin m) :
    TransportData (red ε : Col (m + 1 + 1) B → Fin (m + 1 + 1) → K) (Pres (m + 1 + 1) B)
      (Matrix (Fin (m + 1 + 1)) (Fin (m + 1 + 1)) B)ˣ where
  π := π
  b i := (ecol i : Col (m + 1 + 1) B)
  hb := red_single ε
  i₀ := Fin.last (m + 1)
  i₁ := (Fin.last m).castSucc
  i₂ := c.castSucc.castSucc
  P := (ι (m := m + 1) (B := B)).range
  σ := σ ψ hψ
  s := sw
  adj_smul := adj_smul ε
  tri_smul := tri_smul ε
  π_σ := π_σ ψ hψ
  fix₀ := fix₀'
  s₀ := sw_s₀
  s₂ := sw_s₂ c
  gen := gen_top ψ hψ hψπ
  sq := by
    rw [sw_sq]
    exact Subgroup.one_mem _
  nbr := nbr_exists ε hunit
  tri := tri_exists ε hunit c
  stab := stab_conj ε hunit ψ hψ hψπ
  t := swT c
  t₁ := swT_t₁ c
  triangle := triangle_mem ψ hψ hψπ c

end Transport

section Induction
variable {K : Type*} [Field K] (ε : B →+* K) (hunit : ∀ b : B, ε b ≠ 0 → IsUnit b)

include hunit in
/-- The induction step of manuscript Lemma 11.1. -/
theorem π_injective_succ (c : Fin m) (hbij : Function.Bijective (π (m := m + 1) (B := B))) :
    Function.Injective (π (m := m + 1 + 1) (B := B)) := by
  let e := MulEquiv.ofBijective (π (m := m + 1) (B := B)) hbij
  have hψ : ∀ A, π (e.symm.toMonoidHom A) = A := fun A => e.apply_symm_apply A
  have hψπ : ∀ x, e.symm.toMonoidHom (π x) = x := fun x => e.symm_apply_apply x
  have hn : 3 ≤ m + 1 + 1 := by
    have := c.pos
    omega
  exact (transportData ε hunit e.symm.toMonoidHom hψ hψπ c).π_injective hn
    (adj_standard (red ε) (fun i => (ecol i : Col (m + 1 + 1) B)) (red_single ε)
      (last_ne_castSucc' (Fin.last m)))

include hunit in
/-- Manuscript Lemma 11.1: over a ring whose elements of nonzero reduction are units, the
presentation of `GL_n` by the relations on at most five coordinates is faithful. -/
theorem π_injective_all : ∀ n, Function.Injective (π (m := n) (B := B))
  | 0 => π_injective_of_le (by norm_num)
  | 1 => π_injective_of_le (by norm_num)
  | n + 2 => by
    by_cases h : n + 2 ≤ 5
    · exact π_injective_of_le h
    · exact π_injective_succ ε hunit (m := n) ⟨0, by omega⟩
        ⟨π_injective_all (n + 1), π_surjective ε hunit⟩

end Induction

end GLPres
