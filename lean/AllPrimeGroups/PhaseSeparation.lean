import AllPrimeGroups.OffsetCollection

/-! Stable separation from phases (manuscript Theorem 22.2, assembled from its parts).

The graded evaluation at a numerical matrix is a well-defined endomorphism of the stable
Steinberg group, so the identity `W_z(C_m) = z^m` needs to be checked for one representative of
z only. In characteristic ℓ the long representative of manuscript Lemma 22.1 is a product of
roots without inverses. Combined with relative torsion, wrap removal and the collection by
offsets, this proves stable separation for a ring over `ZMod ℓ` with a grading, from the
following data for arbitrarily large moduli prime to ℓ: phases on a set of words, the zero
alternative of manuscript Lemma 20.2, the relocation of manuscript Lemma 21.1, and a set of
truncation generators that factor into long words.

Relocation (manuscript Lemma 21.1) is a hypothesis here, and none of the data is constructed
for R(p) in this file. -/

namespace AllPrimeGroups
noncomputable section

namespace Kernel
open Classical

section Evaluation
variable {ℓ : ℕ} [Fact ℓ.Prime] {n n' m : ℕ} {R : Type*} [Ring R] [Algebra (ZMod ℓ) R]

/-- A coordinate map compatible with the block structure sends block roots to block roots. -/
theorem blockRoot_coordinateMap (f : Fin n → Fin n') (hf : Function.Injective f)
    (g : Fin (n * m) → Fin (n' * m)) (hg : Function.Injective g)
    (hfg : ∀ i s, g (blockIndex i s) = blockIndex (f i) s) (p : Root n)
    (A : Matrix (Fin m) (Fin m) R) :
    Steinberg.coordinateMap g hg (blockRoot p A) = blockRoot (p.map f hf) A := by
  induction A using Matrix.induction_on' with
  | h_zero => simp [blockRoot_zero]
  | h_add A B hA hB => rw [blockRoot_add, map_mul, hA, hB, blockRoot_add]
  | h_std_basis s t a =>
    rw [blockRoot_single, blockRoot_single, Steinberg.coordinateMap_x]
    congr 1
    exact root_eq (hfg p.row s) (hfg p.col t)

theorem blockIndex_pad (h : n * m ≤ (n + 1) * m) (i : Fin n) (s : Fin m) :
    Fin.castLE h (blockIndex i s) = blockIndex (coordinateIndex n i) s := by
  apply Fin.ext
  simp [blockIndex, coordinateIndex, coordinateEquiv]

/-- The evaluation at a numerical matrix commutes with adding a coordinate. -/
theorem matrixSteinbergEval_pad (T : Matrix (Fin m) (Fin m) (ZMod ℓ)) (h : n * m ≤ (n + 1) * m)
    (v : Steinberg n (Polynomial R)) :
    matrixSteinbergEval T (padSteinberg v) =
      Steinberg.coordinateMap (Fin.castLE h) (Fin.castLE_injective h)
        (matrixSteinbergEval T v) := by
  have H : (matrixSteinbergEval (n := n + 1) (R := R) T).comp padSteinberg =
      (Steinberg.coordinateMap (Fin.castLE h) (Fin.castLE_injective h)).comp
        (matrixSteinbergEval (n := n) T) := by
    apply Steinberg.hom_ext
    intro p f
    simp only [MonoidHom.comp_apply, padSteinberg, Steinberg.coordinateMap_x,
      matrixSteinbergEval_x]
    exact (blockRoot_coordinateMap (coordinateIndex n) (coordinateIndex_injective n)
      (Fin.castLE h) (Fin.castLE_injective h) (blockIndex_pad h) p _).symm
  exact DFunLike.congr_fun H v

end Evaluation

section Words
variable {n n' : ℕ} {R : Type*} [Ring R]

theorem rootWord_replicate (k : ℕ) (qa : Root n × R) :
    rootWord (List.replicate k qa) = Steinberg.x qa.1 qa.2 ^ k := by
  induction k with
  | zero => simp [rootWord]
  | succ k ih => rw [List.replicate_succ, rootWord_cons, ih, pow_succ']

theorem rootWord_coordinateMap (f : Fin n → Fin n') (hf : Function.Injective f)
    (l : List (Root n × R)) :
    Steinberg.coordinateMap f hf (rootWord l) =
      rootWord (l.map (fun qa => (qa.1.map f hf, qa.2))) := by
  induction l with
  | nil => simp [rootWord]
  | cons qa l ih =>
    rw [List.map_cons, rootWord_cons, rootWord_cons, map_mul, Steinberg.coordinateMap_x, ih]

end Words

section CharRoots
variable {ℓ : ℕ} [hℓ : Fact ℓ.Prime] {n : ℕ} {R : Type*} [Ring R] [hR : Algebra (ZMod ℓ) R]

/-- In characteristic ℓ the inverse of a root is its (ℓ-1)-st power. -/
theorem x_pow_pred_char (q : Root n) (a : R) :
    Steinberg.x q a ^ (ℓ - 1) = (Steinberg.x q a)⁻¹ := by
  have hpow : Steinberg.x q a ^ ℓ = 1 := by
    rw [← Steinberg.x_nsmul, nsmul_eq_mul]
    have hℓR : ((ℓ : ℕ) : R) = 0 := by
      rw [← map_natCast (algebraMap (ZMod ℓ) R), ZMod.natCast_self, map_zero]
    rw [hℓR, zero_mul, Steinberg.x_zero]
  apply eq_inv_of_mul_eq_one_left
  rw [← pow_succ, Nat.sub_add_cancel hℓ.out.one_lt.le, hpow]

theorem rootWord_inv_char (l : List (Root n × R)) :
    rootWord (l.reverse.flatMap (fun qa => List.replicate (ℓ - 1) qa)) = (rootWord l)⁻¹ := by
  induction l with
  | nil => simp [rootWord]
  | cons qa l ih =>
    rw [List.reverse_cons, List.flatMap_append, rootWord_append, ih, List.flatMap_singleton,
      rootWord_replicate, x_pow_pred_char, rootWord_cons, mul_inv_rev]

include hℓ hR in
/-- In characteristic ℓ, an element of the subgroup generated by roots with parameters in a set
is a product of such roots, without inverses. -/
theorem exists_rootWord_of_mem_rootsIn {T : Set R} {g : Steinberg n R}
    (hg : g ∈ rootsIn n T) :
    ∃ l : List (Root n × R), (∀ qa ∈ l, qa.2 ∈ T) ∧ rootWord l = g := by
  induction hg using Subgroup.closure_induction with
  | mem g hg =>
    obtain ⟨q, a, ha, rfl⟩ := hg
    exact ⟨[(q, a)], by simpa using ha, by simp [rootWord]⟩
  | one => exact ⟨[], by simp, by simp [rootWord]⟩
  | mul g h _ _ ihg ihh =>
    obtain ⟨l, hl, rfl⟩ := ihg
    obtain ⟨k, hk, rfl⟩ := ihh
    exact ⟨l ++ k, fun qa hqa => (List.mem_append.mp hqa).elim (hl qa) (hk qa),
      rootWord_append l k⟩
  | inv g _ ih =>
    obtain ⟨l, hl, rfl⟩ := ih
    refine ⟨l.reverse.flatMap (fun qa => List.replicate (ℓ - 1) qa), ?_,
      rootWord_inv_char (ℓ := ℓ) l⟩
    intro qa hqa
    obtain ⟨qb, hqb, hmem⟩ := List.mem_flatMap.mp hqa
    rw [List.eq_of_mem_replicate hmem]
    exact hl qb (List.mem_reverse.mp hqb)

end CharRoots

namespace CyclicPhases
variable {m : ℕ} [NeZero m] {R : Type*} [Ring R] (P : CyclicPhases R m)

/-- Manuscript Lemma 21.1 for a phase structure: the offset zero word of a root word in phased
words with trivial matrix represents the same stable element. -/
def Relocates : Prop :=
  ∀ (n : ℕ) (l : List (Root n × R)), (∀ qa ∈ l, qa.2 ∈ P.W) →
    Elementary.representation (rootWord l) = 1 →
    Stable.of R (n * m) (P.offsetWord l 0) = Stable.of R n (rootWord l)

end CyclicPhases
end Kernel

namespace Stable
variable {ℓ : ℕ} [hℓ : Fact ℓ.Prime] {R : Type*} [Ring R] [hR : Algebra (ZMod ℓ) R]

/-- The graded evaluation at a numerical matrix, as an endomorphism of the stable group. -/
def cyclicEvalHom {m : ℕ} (T : Matrix (Fin m) (Fin m) (ZMod ℓ)) (γ : R →+* Polynomial R) :
    StableSteinberg R →* StableSteinberg R :=
  Chain.lift (steinbergStep R)
    (fun n => (of R (n * m)).comp
      ((Kernel.matrixSteinbergEval T).comp (Steinberg.map (n := n) γ)))
    (by
      intro n
      apply MonoidHom.ext
      intro u
      have h : n * m ≤ (n + 1) * m := Nat.mul_le_mul_right m (Nat.le_succ n)
      change of R ((n + 1) * m) (Kernel.matrixSteinbergEval T
          (Steinberg.map γ (Kernel.padSteinberg u))) =
        of R (n * m) (Kernel.matrixSteinbergEval T (Steinberg.map γ u))
      rw [Kernel.pad_ringMap, Kernel.matrixSteinbergEval_pad T h, of_castLE])

@[simp] theorem cyclicEvalHom_of {m : ℕ} (T : Matrix (Fin m) (Fin m) (ZMod ℓ))
    (γ : R →+* Polynomial R) (n : ℕ) (u : Steinberg n R) :
    cyclicEvalHom T γ (of R n u) =
      of R (n * m) (Kernel.matrixSteinbergEval T (Steinberg.map γ u)) := rfl

/-- Manuscript Proposition 9.1 with the graded cyclic evaluation as a stable endomorphism. -/
theorem eq_one_of_cyclicEvalHom (ε : R →+* ZMod ℓ) (γ : R →+* Polynomial R)
    (h1 : (Kernel.scalarEval (1 : ZMod ℓ)).comp γ = RingHom.id R)
    (h0 : (Kernel.scalarEval (0 : ZMod ℓ)).comp γ = (algebraMap (ZMod ℓ) R).comp ε)
    (z : StableSteinberg R) (hz : representation R z = 1) (hε : map ε z = 1)
    (hcyc : ∀ B : ℕ, ∃ m : ℕ, B < m ∧ m.Coprime ℓ ∧
      cyclicEvalHom (Kernel.cyclicShift m (ZMod ℓ)) γ z = z ^ m) :
    z = 1 := by
  apply eq_one_of_cyclic_evaluation ε γ h1 h0 z hz hε
  intro B
  obtain ⟨m, hBm, hcop, hm⟩ := hcyc B
  refine ⟨m, hBm, hcop, fun n u _ hu _ _ => ?_⟩
  rw [← hm, ← hu, cyclicEvalHom_of]

/-- Manuscript Proposition 21.2 from relocation, for a representative of rank with `3 ≤ n m`. -/
theorem cyclicEvalHom_eq_pow_of_rank {m : ℕ} [NeZero m] (P : Kernel.CyclicPhases R m)
    (γ : R →+* Polynomial R) (hγ : ∀ w ∈ P.W, γ w = Polynomial.monomial (P.len w) w)
    (hopp : ∀ k, 3 ≤ k → P.OppositeCommute k) (hreloc : P.Relocates)
    (z : StableSteinberg R) (hz : representation R z = 1) {n : ℕ} (hnm : 3 ≤ n * m)
    (l : List (Root n × R)) (hl : ∀ qa ∈ l, qa.2 ∈ P.W)
    (hlz : of R n (Kernel.rootWord l) = z) :
    cyclicEvalHom (Kernel.cyclicShift m (ZMod ℓ)) γ z = z ^ m := by
  have hrep : Elementary.representation (Kernel.rootWord l) = 1 :=
    finite_matrix_kernel R n _ (by rw [hlz, hz])
  have h0 := hreloc n l hl hrep
  rw [hlz] at h0
  have h0rep : Elementary.representation (P.offsetWord l 0) = 1 :=
    finite_matrix_kernel R (n * m) _ (by rw [h0, hz])
  calc cyclicEvalHom (Kernel.cyclicShift m (ZMod ℓ)) γ z
      = cyclicEvalHom (Kernel.cyclicShift m (ZMod ℓ)) γ (of R n (Kernel.rootWord l)) := by
        rw [hlz]
    _ = of R (n * m) (P.offsetWord l 0) ^ m := by
        rw [cyclicEvalHom_of]
        exact cyclic_eval_eq_offset_pow (ℓ := ℓ) P hnm γ hγ (hopp _ hnm) l hl h0rep
    _ = z ^ m := by rw [h0]

/-- Manuscript Proposition 21.2 from relocation. -/
theorem cyclicEvalHom_eq_pow {m : ℕ} [NeZero m] (P : Kernel.CyclicPhases R m)
    (γ : R →+* Polynomial R) (hγ : ∀ w ∈ P.W, γ w = Polynomial.monomial (P.len w) w)
    (hopp : ∀ k, 3 ≤ k → P.OppositeCommute k) (hreloc : P.Relocates)
    (z : StableSteinberg R) (hz : representation R z = 1) {n : ℕ}
    (l : List (Root n × R)) (hl : ∀ qa ∈ l, qa.2 ∈ P.W)
    (hlz : of R n (Kernel.rootWord l) = z) :
    cyclicEvalHom (Kernel.cyclicShift m (ZMod ℓ)) γ z = z ^ m := by
  have hn : n ≤ n + 3 := by omega
  have hm : 3 ≤ (n + 3) * m := by
    have := NeZero.pos m
    nlinarith
  apply cyclicEvalHom_eq_pow_of_rank P γ hγ hopp hreloc z hz hm
    (l.map (fun qa => (qa.1.map (Fin.castLE hn) (Fin.castLE_injective hn), qa.2)))
  · intro qa hqa
    obtain ⟨qb, hqb, rfl⟩ := List.mem_map.mp hqa
    exact hl qb hqb
  · rw [← Kernel.rootWord_coordinateMap, of_castLE, hlz]

/-- Manuscript Theorem 22.2 for a ring over `ZMod ℓ` with a grading. An element of the stable
matrix kernel with trivial reduction is trivial if, for arbitrarily large moduli prime to ℓ,
there are phases on a set of words with the zero alternative of Lemma 20.2 in rank at least
three and the relocation of Lemma 21.1, and the element is killed by a quotient whose
generators factor into long words. -/
theorem eq_one_of_phases (ε : R →+* ZMod ℓ) (γ : R →+* Polynomial R)
    (h1 : (Kernel.scalarEval (1 : ZMod ℓ)).comp γ = RingHom.id R)
    (h0 : (Kernel.scalarEval (0 : ZMod ℓ)).comp γ = (algebraMap (ZMod ℓ) R).comp ε)
    (z : StableSteinberg R) (hz : representation R z = 1) (hε : map ε z = 1)
    (hphase : ∀ B : ℕ, ∃ (m : ℕ) (P : Kernel.CyclicPhases R (m + 1)) (S : Set R),
      B < m + 1 ∧ (m + 1).Coprime ℓ ∧
      (∀ w ∈ P.W, γ w = Polynomial.monomial (P.len w) w) ∧
      (∀ k, 3 ≤ k → P.OppositeCommute k) ∧ P.Relocates ∧
      (∀ a ∈ S, ∃ b c : R, a = b * c ∧ (∀ r : R, r * b ∈ AddSubgroup.closure P.W) ∧
        ∀ r : R, c * r ∈ AddSubgroup.closure P.W) ∧
      map (SteinbergQuotient.coeffIdeal S).ringCon.mk' z = 1) :
    z = 1 := by
  apply eq_one_of_cyclicEvalHom ε γ h1 h0 z hz hε
  intro B
  obtain ⟨m, P, S, hBm, hcop, hγ, hopp, hreloc, hS, hzS⟩ := hphase B
  refine ⟨m + 1, hBm, hcop, ?_⟩
  obtain ⟨n, u, hu, hmem⟩ := exists_long_representative hS z hzS
  obtain ⟨l, hl, rfl⟩ := Kernel.exists_rootWord_of_mem_rootsIn (ℓ := ℓ) hmem
  exact cyclicEvalHom_eq_pow P γ hγ hopp hreloc z hz l hl hu

end Stable
end
end AllPrimeGroups
