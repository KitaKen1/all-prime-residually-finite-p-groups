import AllPrimeGroups.HierarchyGrading
import AllPrimeGroups.Relocation
import AllPrimeGroups.PrimeReduction

/-! Stable separation for R(p) (manuscript Theorem 22.2).

For one level h of a machine hierarchy, with phases of long surviving words modulo m + 2:

* the phase grading over `ZMod ℓ`, whose projections onto phase components keep the long
  surviving words with given outer phases (`phaseGrading`);
* long words factor into two long words whose one-sided multiples are sums of long surviving
  words (`longSet_factor`);
* the quotients by the ideals generated by the words of length at least d are finite
  (`finite_trunc`), and these ideals meet in zero (`eq_zero_of_forall_mem`).

For R(p), the phases of `HierarchyPhases.lean` over n levels have the modulus
`period D n h`, which is prime to p and at least 2^n. The general theorem
`Stable.eq_one_of_phaseGradings` then shows that the finite quotients R(p)/I_d separate the
stable Steinberg group: this is the second half of `OpenObligations`. -/

namespace AllPrimeGroups
namespace Phases
open OAI OAI.SourceBurnside OAI.SourceBurnside.FiniteTable
open Classical

noncomputable section

theorem smul_mem_closure {ℓ : ℕ} [Fact ℓ.Prime] {M : Type*} [AddCommGroup M]
    [Module (ZMod ℓ) M] {W : Set M} (k : ZMod ℓ) {y : M} (hy : y ∈ AddSubgroup.closure W) :
    k • y ∈ AddSubgroup.closure W := by
  have : NeZero ℓ := ⟨(Fact.out : ℓ.Prime).ne_zero⟩
  rw [← ZMod.natCast_zmod_val k, Nat.cast_smul_eq_nsmul]
  exact AddSubgroup.nsmul_mem _ hy _

namespace Hierarchy
variable {D : ℕ} {hD : 2 ≤ D} (A : SourceMachine.MachineHierarchy D hD)
variable {h : ℕ} (hh : A.threshold ≤ h)

section Grading
variable {m : ℕ} (P : LevelPhases (Surv A h hh) (m + 2))

/-- Long surviving words with given outer phases. -/
def PhaseWord (s t : Fin (m + 2)) (w : FreeMonoid (Codec.Raw h)) : Prop :=
  2 * P.thr + 3 ≤ w.toList.length ∧ ¬ (A.table h hh).Vanishes w ∧
    (id (P.σ w.toList) : Fin (m + 2)) = s ∧
    (id (P.σ w.toList + (w.toList.length : ZMod (m + 2))) : Fin (m + 2)) = t

theorem phaseWord_compatible (s t : Fin (m + 2)) :
    WordBasis.Compatible (A.table h hh) (PhaseWord A hh P s t) where
  reach {v w} hr := by
    have hl : v.toList.length = w.toList.length :=
      (A.table h hh).length_eq_of_reach (A.table_homogeneous hh) hr
    have hr' : Codec.Reach (A.height_pos hh) (A.schedule h hh) (10000 * (D * h))
        v.toList w.toList := Codec.reach_iff_table.mpr hr
    constructor
    · rintro ⟨hlen, hv, hs, ht⟩
      have hσ := phase_reach A hh P hr' ((Codec.survives_iff_not_vanishes v.toList).mpr hv)
        (by omega)
      refine ⟨by omega, fun hw => hv ((A.table h hh).vanishes_of_reach hr hw), ?_, ?_⟩
      · rw [hσ]
        exact hs
      · rw [hσ, ← hl]
        exact ht
    · rintro ⟨hlen, hw, hs, ht⟩
      have hσ := phase_reach A hh P (Codec.reach_symm hr')
        ((Codec.survives_iff_not_vanishes w.toList).mpr hw) (by omega)
      refine ⟨by omega, fun hv => hw ((A.table h hh).vanishes_of_reach
        ((conGen (A.table h hh).rep).symm hr) hv), ?_, ?_⟩
      · rw [hσ]
        exact hs
      · rw [hσ, hl]
        exact ht
  vanish hv hw := hw.2.1 hv

variable (ℓ : ℕ) [Fact ℓ.Prime]

/-- The phase grading of the classes of long surviving words over `ZMod ℓ`. -/
def phaseGrading : Kernel.PhaseGrading ℓ (A.Algebra (ZMod ℓ) h hh) (m + 2) where
  toCyclicPhases := cyclicPhases A hh P (ZMod ℓ)
  ε := (A.augmentation hh (ZMod ℓ)).toRingHom
  ε_word := by
    rintro x ⟨w, hw⟩
    rw [← hw.2.2]
    have hl : (FreeMonoid.ofList w).length ≠ 0 := by
      change w.length ≠ 0
      have := hw.1
      omega
    show (A.table h hh).augmentation (K := ZMod ℓ) (A.table_homogeneous hh)
      (A.table_zero_nonempty hh) ((A.table h hh).word (FreeMonoid.ofList w)) = 0
    rw [WordAlgebra.Table.augmentation_word, ite_eq_right_iff]
    exact fun h0 => absurd h0 hl
  proj s t := WordBasis.filterMap (A.table h hh) (phaseWord_compatible A hh P s t)
  proj_word s t x hx := by
    obtain ⟨w, hw⟩ := hx
    have e1 : (cyclicPhases A hh P (ZMod ℓ)).σ x = id (P.σ w) :=
      phaseOf_eq A hh P (ZMod ℓ) hw
    have e2 : (cyclicPhases A hh P (ZMod ℓ)).τ x = id (P.σ w + (w.length : ZMod (m + 2))) := by
      show phaseOf A hh P (ZMod ℓ) x + (lenOf A hh P (ZMod ℓ) x : ZMod (m + 2)) = _
      rw [phaseOf_eq A hh P (ZMod ℓ) hw, lenOf_eq A hh P (ZMod ℓ) hw]
      rfl
    have hiff : PhaseWord A hh P s t (FreeMonoid.ofList w) ↔
        ((cyclicPhases A hh P (ZMod ℓ)).σ x = s ∧ (cyclicPhases A hh P (ZMod ℓ)).τ x = t) := by
      rw [e1, e2]
      constructor
      · rintro ⟨-, -, h1, h2⟩
        exact ⟨h1, h2⟩
      · rintro ⟨h1, h2⟩
        exact ⟨hw.1, (Codec.survives_iff_not_vanishes w).mp hw.2.1, h1, h2⟩
    have key : WordBasis.filterMap (K := ZMod ℓ) (A.table h hh) (phaseWord_compatible A hh P s t) x =
        if PhaseWord A hh P s t (FreeMonoid.ofList w) then x else 0 := by
      rw [← hw.2.2]
      exact WordBasis.filterMap_word (A.table h hh) (phaseWord_compatible A hh P s t) _
    exact key.trans (if_congr hiff rfl rfl)
  proj_one s t := by
    have hz : ¬ PhaseWord A hh P s t (1 : FreeMonoid (Codec.Raw h)) := fun hc => by
      have h1 := hc.1
      change 2 * P.thr + 3 ≤ 0 at h1
      omega
    have key := WordBasis.filterMap_word (K := ZMod ℓ) (A.table h hh)
      (phaseWord_compatible A hh P s t) 1
    rw [WordAlgebra.Table.word_one, ite_eq_right_of_eq_false _ _ (eq_false hz)] at key
    exact key
  mul_mem := by
    rintro x ⟨u, hu⟩ y ⟨v, hv⟩ h0
    have hxy : x * y = wordVal A hh (ZMod ℓ) (u ++ v) := by
      rw [wordVal_append, hu.2.2, hv.2.2]
    have hs : Surv A h hh (u ++ v) := surv_of_ne A hh (ZMod ℓ) (hxy ▸ h0)
    have hr : Represents A hh P (ZMod ℓ) (x * y) (u ++ v) :=
      ⟨by rw [List.length_append]; have := hu.1; omega, hs, hxy.symm⟩
    refine ⟨⟨u ++ v, hr⟩, ?_, ?_⟩
    · show phaseOf A hh P (ZMod ℓ) (x * y) = phaseOf A hh P (ZMod ℓ) x
      rw [phaseOf_eq A hh P (ZMod ℓ) hr, phaseOf_eq A hh P (ZMod ℓ) hu]
      exact P.pref u v hs (by have := hu.1; omega)
    · show phaseOf A hh P (ZMod ℓ) (x * y) + (lenOf A hh P (ZMod ℓ) (x * y) : ZMod (m + 2)) =
        phaseOf A hh P (ZMod ℓ) y + (lenOf A hh P (ZMod ℓ) y : ZMod (m + 2))
      rw [phaseOf_eq A hh P (ZMod ℓ) hr, lenOf_eq A hh P (ZMod ℓ) hr,
        phaseOf_eq A hh P (ZMod ℓ) hv, lenOf_eq A hh P (ZMod ℓ) hv]
      have h1 := P.suffix u v hs (by have := hv.1; omega)
      rw [← h1, List.length_append, Nat.cast_add]
      ring

theorem mul_left_mem (r : A.Algebra (ZMod ℓ) h hh) {u : List (Codec.Raw h)}
    (hu : 2 * P.thr + 3 ≤ u.length) :
    r * wordVal A hh (ZMod ℓ) u ∈ AddSubgroup.closure (cyclicPhases A hh P (ZMod ℓ)).W := by
  obtain ⟨p, rfl⟩ := ((A.table h hh).ideal (K := ZMod ℓ)).ringCon.mk'_surjective r
  induction p using MonoidAlgebra.induction_on with
  | of w =>
    change (A.table h hh).word w * wordVal A hh (ZMod ℓ) u ∈ _
    have he : (A.table h hh).word (K := ZMod ℓ) w * wordVal A hh (ZMod ℓ) u =
        wordVal A hh (ZMod ℓ) (w.toList ++ u) := (wordVal_append A hh (ZMod ℓ) w.toList u).symm
    rw [he]
    by_cases h0 : wordVal A hh (ZMod ℓ) (w.toList ++ u) = 0
    · rw [h0]
      exact AddSubgroup.zero_mem _
    · exact AddSubgroup.subset_closure ⟨w.toList ++ u,
        by rw [List.length_append]; omega, surv_of_ne A hh _ h0, rfl⟩
  | add p q hp hq =>
    rw [map_add, add_mul]
    exact AddSubgroup.add_mem _ hp hq
  | smul k p hp =>
    rw [WordAlgebra.Table.quotient_smul (A.table h hh) k p, smul_mul_assoc]
    exact smul_mem_closure k hp

theorem mul_right_mem (r : A.Algebra (ZMod ℓ) h hh) {u : List (Codec.Raw h)}
    (hu : 2 * P.thr + 3 ≤ u.length) :
    wordVal A hh (ZMod ℓ) u * r ∈ AddSubgroup.closure (cyclicPhases A hh P (ZMod ℓ)).W := by
  obtain ⟨p, rfl⟩ := ((A.table h hh).ideal (K := ZMod ℓ)).ringCon.mk'_surjective r
  induction p using MonoidAlgebra.induction_on with
  | of w =>
    change wordVal A hh (ZMod ℓ) u * (A.table h hh).word w ∈ _
    have he : wordVal A hh (ZMod ℓ) u * (A.table h hh).word (K := ZMod ℓ) w =
        wordVal A hh (ZMod ℓ) (u ++ w.toList) := (wordVal_append A hh (ZMod ℓ) u w.toList).symm
    rw [he]
    by_cases h0 : wordVal A hh (ZMod ℓ) (u ++ w.toList) = 0
    · rw [h0]
      exact AddSubgroup.zero_mem _
    · exact AddSubgroup.subset_closure ⟨u ++ w.toList,
        by rw [List.length_append]; omega, surv_of_ne A hh _ h0, rfl⟩
  | add p q hp hq =>
    rw [map_add, mul_add]
    exact AddSubgroup.add_mem _ hp hq
  | smul k p hp =>
    rw [WordAlgebra.Table.quotient_smul (A.table h hh) k p, mul_smul_comm]
    exact smul_mem_closure k hp

end Grading

section Truncation
variable (ℓ : ℕ)

/-- The classes of the words of length at least d. -/
def longSet (d : ℕ) : Set (A.Algebra (ZMod ℓ) h hh) :=
  {x | ∃ w : List (Codec.Raw h), d ≤ w.length ∧ wordVal A hh (ZMod ℓ) w = x}

/-- The ideal generated by the words of length at least d. -/
abbrev truncIdeal (d : ℕ) : TwoSidedIdeal (A.Algebra (ZMod ℓ) h hh) :=
  SteinbergQuotient.coeffIdeal (longSet A hh ℓ d)

/-- The quotient by the words of length at least d. -/
abbrev Trunc (d : ℕ) : Type := (truncIdeal A hh ℓ d).ringCon.Quotient

/-- A long word factors into two long words whose one-sided multiples are sums of long
surviving words. -/
theorem longSet_factor [Fact ℓ.Prime] {m : ℕ} (P : LevelPhases (Surv A h hh) (m + 2))
    {a : A.Algebra (ZMod ℓ) h hh} (ha : a ∈ longSet A hh ℓ (2 * (2 * P.thr + 3))) :
    ∃ b c : A.Algebra (ZMod ℓ) h hh, a = b * c ∧
      (∀ r, r * b ∈ AddSubgroup.closure (cyclicPhases A hh P (ZMod ℓ)).W) ∧
      ∀ r, c * r ∈ AddSubgroup.closure (cyclicPhases A hh P (ZMod ℓ)).W := by
  obtain ⟨w, hw, rfl⟩ := ha
  refine ⟨wordVal A hh (ZMod ℓ) (w.take (2 * P.thr + 3)),
    wordVal A hh (ZMod ℓ) (w.drop (2 * P.thr + 3)), ?_,
    fun r => mul_left_mem A hh P ℓ r ?_, fun r => mul_right_mem A hh P ℓ r ?_⟩
  · rw [← wordVal_append, List.take_append_drop]
  · rw [List.length_take]
    omega
  · rw [List.length_drop]
    omega

/-- The quotient by the words of length at least d is finite. -/
theorem finite_trunc [Fact ℓ.Prime] (d : ℕ) : Finite (Trunc A hh ℓ d) := by
  let q := (truncIdeal A hh ℓ d).ringCon.mk'
  let G : Set (Trunc A hh ℓ d) := (fun w => q (wordVal A hh (ZMod ℓ) w)) '' {w | w.length < d}
  have hG : G.Finite := (List.finite_length_lt (Codec.Raw h) d).image _
  have hspan : Submodule.span (ZMod ℓ) G = ⊤ := by
    apply eq_top_iff.mpr
    rintro y -
    obtain ⟨x, rfl⟩ := (truncIdeal A hh ℓ d).ringCon.mk'_surjective y
    obtain ⟨p, rfl⟩ := ((A.table h hh).ideal (K := ZMod ℓ)).ringCon.mk'_surjective x
    induction p using MonoidAlgebra.induction_on with
    | of w =>
      change q ((A.table h hh).word w) ∈ _
      by_cases hw : w.toList.length < d
      · exact Submodule.subset_span ⟨w.toList, hw, rfl⟩
      · have hmem : (A.table h hh).word (K := ZMod ℓ) w ∈ truncIdeal A hh ℓ d :=
          TwoSidedIdeal.subset_span ⟨w.toList, by omega, rfl⟩
        have h0 : q ((A.table h hh).word (K := ZMod ℓ) w) = 0 := by
          rw [← map_zero q]
          exact ((truncIdeal A hh ℓ d).ringCon.eq).mpr
            (((truncIdeal A hh ℓ d).rel_iff _ _).mpr (by rw [sub_zero]; exact hmem))
        rw [h0]
        exact Submodule.zero_mem _
    | add p r hp hr =>
      rw [map_add, map_add]
      exact Submodule.add_mem _ hp hr
    | smul k p hp =>
      rw [WordAlgebra.Table.quotient_smul (A.table h hh) k p]
      exact Submodule.smul_mem _ k hp
  have : Module.Finite (ZMod ℓ) (Trunc A hh ℓ d) := ⟨Submodule.fg_def.mpr ⟨G, hG, hspan⟩⟩
  exact Module.finite_of_finite (ZMod ℓ)

/-- The ideal of elements whose grading has no coefficient below degree d. -/
def gradingIdeal (d : ℕ) : TwoSidedIdeal (A.Algebra (ZMod ℓ) h hh) :=
  TwoSidedIdeal.mk' {x | ∀ e < d,
      ((A.table h hh).gradingHom (K := ZMod ℓ) (A.table_homogeneous hh) x).coeff e = 0}
    (by intro e _; simp)
    (by
      intro x y hx hy e he
      rw [map_add, Polynomial.coeff_add, hx e he, hy e he, add_zero])
    (by
      intro x hx e he
      rw [map_neg, Polynomial.coeff_neg, hx e he, neg_zero])
    (by
      intro x y hy e he
      rw [map_mul, Polynomial.coeff_mul]
      apply Finset.sum_eq_zero
      intro i hi
      have hi' := Finset.HasAntidiagonal.mem_antidiagonal.mp hi
      rw [hy i.2 (by omega), mul_zero])
    (by
      intro x y hx e he
      rw [map_mul, Polynomial.coeff_mul]
      apply Finset.sum_eq_zero
      intro i hi
      have hi' := Finset.HasAntidiagonal.mem_antidiagonal.mp hi
      rw [hx i.1 (by omega), zero_mul])

theorem truncIdeal_le (d : ℕ) : truncIdeal A hh ℓ d ≤ gradingIdeal A hh ℓ d := by
  apply TwoSidedIdeal.span_le.mpr
  rintro _ ⟨w, hw, rfl⟩
  rw [SetLike.mem_coe, gradingIdeal, TwoSidedIdeal.mem_mk']
  intro e he
  have hne : (FreeMonoid.ofList w).length ≠ e := by
    change w.length ≠ e
    omega
  show ((A.table h hh).gradingHom (K := ZMod ℓ) (A.table_homogeneous hh)
    ((A.table h hh).word (FreeMonoid.ofList w))).coeff e = 0
  rw [WordAlgebra.Table.gradingHom_word, Polynomial.coeff_monomial, ite_eq_right_iff]
  exact fun h0 => absurd h0 hne

/-- The ideals generated by long words meet in zero. -/
theorem eq_zero_of_forall_mem {x : A.Algebra (ZMod ℓ) h hh}
    (hx : ∀ d, x ∈ truncIdeal A hh ℓ d) : x = 0 := by
  have hγ : (A.table h hh).gradingHom (K := ZMod ℓ) (A.table_homogeneous hh) x = 0 := by
    ext e
    rw [Polynomial.coeff_zero]
    have hm := truncIdeal_le A hh ℓ (e + 1) (hx (e + 1))
    rw [gradingIdeal, TwoSidedIdeal.mem_mk'] at hm
    exact hm e (Nat.lt_succ_self e)
  have he := congrArg (fun f => f x)
    ((A.table h hh).evalOne_gradingHom (K := ZMod ℓ) (A.table_homogeneous hh))
  simp only [AlgHom.comp_apply, AlgHom.id_apply, hγ, map_zero] at he
  exact he.symm

end Truncation

end Hierarchy

section Prime
open Hierarchy
variable (p : ℕ) (hp : p.Prime)

/-- The ideals of R(p) generated by the words of length at least d. -/
abbrev primeTruncIdeal (d : ℕ) : TwoSidedIdeal (PrimeAlgebra.R p hp) :=
  truncIdeal ConcreteSource.machine (PrimeAlgebra.threshold_le_height p hp) p d

/-- An element of the stable group of R(p) that dies in every truncation has trivial matrix. -/
theorem representation_eq_one (z : StableSteinberg (PrimeAlgebra.R p hp))
    (hz : ∀ d, Stable.map (primeTruncIdeal p hp d).ringCon.mk' z = 1) :
    Stable.representation (PrimeAlgebra.R p hp) z = 1 := by
  obtain ⟨n, g, hg⟩ := Chain.exists_stage (steinbergStep (PrimeAlgebra.R p hp)) z
  have hz' : z = Stable.of _ n g := hg
  subst hz'
  have hmat : ∀ d (i j : Fin n),
      (Elementary.representation g : Matrix (Fin n) (Fin n) (PrimeAlgebra.R p hp)) i j -
        (1 : Matrix (Fin n) (Fin n) (PrimeAlgebra.R p hp)) i j ∈ primeTruncIdeal p hp d := by
    intro d i j
    have h1 := hz d
    rw [Stable.map_of] at h1
    have h2 : Elementary.representation (Steinberg.map (primeTruncIdeal p hp d).ringCon.mk' g) = 1 :=
      Stable.finite_matrix_kernel _ n _ (by rw [h1, map_one])
    have he := DFunLike.congr_fun
      (Elementary.representation_map (n := n) (primeTruncIdeal p hp d).ringCon.mk') g
    simp only [MonoidHom.comp_apply, h2] at he
    have h3 : (primeTruncIdeal p hp d).ringCon.mk'.mapMatrix
        (Elementary.representation g : Matrix (Fin n) (Fin n) (PrimeAlgebra.R p hp)) = 1 := by
      have h := congrArg Units.val he.symm
      rwa [Units.coe_map, Units.val_one] at h
    have h4 := congrArg (fun M => M i j) h3
    simp only [RingHom.mapMatrix_apply, Matrix.map_apply] at h4
    have h5 : (primeTruncIdeal p hp d).ringCon.mk'
        ((Elementary.representation g : Matrix (Fin n) (Fin n) (PrimeAlgebra.R p hp)) i j) =
        (primeTruncIdeal p hp d).ringCon.mk'
          ((1 : Matrix (Fin n) (Fin n) (PrimeAlgebra.R p hp)) i j) := by
      rw [h4, Matrix.one_apply, Matrix.one_apply]
      split_ifs <;> simp
    exact ((primeTruncIdeal p hp d).rel_iff _ _).mp (((primeTruncIdeal p hp d).ringCon.eq).mp h5)
  have hrep : Elementary.representation g = 1 := by
    apply Units.ext
    ext i j
    have h0 := eq_zero_of_forall_mem ConcreteSource.machine (PrimeAlgebra.threshold_le_height p hp) p
      (fun d => hmat d i j)
    rw [sub_eq_zero] at h0
    simpa using h0
  rw [Stable.representation_of, hrep, map_one]

/-- An element of the stable group of R(p) that dies modulo the positive words has trivial
reduction. -/
theorem augmentation_eq_one (z : StableSteinberg (PrimeAlgebra.R p hp))
    (hz1 : Stable.map (primeTruncIdeal p hp 1).ringCon.mk' z = 1) :
    Stable.map (PrimeAlgebra.augmentation p hp) z = 1 := by
  have hker : primeTruncIdeal p hp 1 ≤ TwoSidedIdeal.ker (PrimeAlgebra.augmentation p hp) := by
    apply TwoSidedIdeal.span_le.mpr
    rintro _ ⟨w, hw, rfl⟩
    rw [SetLike.mem_coe, TwoSidedIdeal.mem_ker]
    have hl : (FreeMonoid.ofList w).length ≠ 0 := by
      change w.length ≠ 0
      omega
    show (ConcreteSource.machine.table _ (PrimeAlgebra.threshold_le_height p hp)).augmentation
      (K := ZMod p) (ConcreteSource.machine.table_homogeneous (PrimeAlgebra.threshold_le_height p hp))
      (ConcreteSource.machine.table_zero_nonempty (PrimeAlgebra.threshold_le_height p hp))
      ((ConcreteSource.machine.table _ (PrimeAlgebra.threshold_le_height p hp)).word
        (FreeMonoid.ofList w)) = 0
    rw [WordAlgebra.Table.augmentation_word, ite_eq_right_iff]
    exact fun h0 => absurd h0 hl
  have hle : (primeTruncIdeal p hp 1).ringCon ≤ RingCon.ker (PrimeAlgebra.augmentation p hp) := by
    intro x y hxy
    rw [RingCon.ker_apply]
    have hmem := hker (((primeTruncIdeal p hp 1).rel_iff x y).mp hxy)
    rw [TwoSidedIdeal.mem_ker, map_sub, sub_eq_zero] at hmem
    exact hmem
  have hfac : PrimeAlgebra.augmentation p hp =
      ((primeTruncIdeal p hp 1).ringCon.lift (PrimeAlgebra.augmentation p hp) hle).comp
        (primeTruncIdeal p hp 1).ringCon.mk' := (RingCon.lift_comp_mk' hle).symm
  rw [hfac, Stable.map_comp, MonoidHom.comp_apply, hz1, map_one]

/-- Stable separation for R(p) (manuscript Theorem 22.2): an element of the stable Steinberg
group of R(p) that dies in every quotient by the words of length at least d is trivial. -/
theorem separation (z : StableSteinberg (PrimeAlgebra.R p hp))
    (hz : ∀ d, Stable.map (primeTruncIdeal p hp d).ringCon.mk' z = 1) : z = 1 := by
  have : Fact p.Prime := ⟨hp⟩
  apply Stable.eq_one_of_phaseGradings (PrimeAlgebra.augmentation p hp)
    (PrimeAlgebra.grading p hp) (PrimeAlgebra.grading_one p hp) (PrimeAlgebra.grading_zero p hp) z
    (representation_eq_one p hp z hz) (augmentation_eq_one p hp z (hz 1))
  intro B
  have hper := two_pow_le_period ConcreteSource.dilation (B + 1) (PrimeAlgebra.height p hp)
  have h2 : 2 ≤ 2 ^ (B + 1) := by
    calc 2 = 2 ^ 1 := by norm_num
      _ ≤ 2 ^ (B + 1) := Nat.pow_le_pow_right (by norm_num) (by omega)
  obtain ⟨m, hm⟩ : ∃ m, period ConcreteSource.dilation (B + 1) (PrimeAlgebra.height p hp) = m + 2 :=
    ⟨period ConcreteSource.dilation (B + 1) (PrimeAlgebra.height p hp) - 2, by omega⟩
  let P : LevelPhases (Surv ConcreteSource.machine (PrimeAlgebra.height p hp)
      (PrimeAlgebra.threshold_le_height p hp)) (m + 2) :=
    hm ▸ phases ConcreteSource.machine (B + 1) (PrimeAlgebra.height p hp)
      (PrimeAlgebra.threshold_le_height p hp)
  refine ⟨m, phaseGrading ConcreteSource.machine (PrimeAlgebra.threshold_le_height p hp) P p,
    longSet ConcreteSource.machine (PrimeAlgebra.threshold_le_height p hp) p (2 * (2 * P.thr + 3)),
    ?_, ?_, ?_, ?_, ?_, ?_, ?_, hz _⟩
  · have := (B + 1).lt_two_pow_self
    omega
  · have hc := period_coprime (PrimeAlgebra.blockLength_coprime p hp) (B + 1) 0
    rw [pow_zero, mul_one, hm] at hc
    exact hc
  · exact grading_word ConcreteSource.machine (PrimeAlgebra.threshold_le_height p hp) P (ZMod p)
  · exact fun k hk => oppositeCommute ConcreteSource.machine
      (PrimeAlgebra.threshold_le_height p hp) P (ZMod p) hk
  · exact fun k hk => cutIndependent ConcreteSource.machine
      (PrimeAlgebra.threshold_le_height p hp) P (ZMod p) hk
  · exact linearIndependent ConcreteSource.machine (PrimeAlgebra.threshold_le_height p hp) P (ZMod p)
  · exact fun a ha => longSet_factor ConcreteSource.machine (PrimeAlgebra.threshold_le_height p hp)
      p P ha

/-- The separation part of `OpenObligations`: the finite quotients of R(p) by the words of
bounded length separate its stable Steinberg group. -/
theorem separation_obligation :
    ∃ (ι : Type) (Q : ι → Type) (_ : ∀ i, Ring (Q i)) (_ : ∀ i, Finite (Q i))
      (q : ∀ i, PrimeAlgebra.R p hp →+* Q i),
      ∀ z : StableSteinberg (PrimeAlgebra.R p hp), (∀ i, Stable.map (q i) z = 1) → z = 1 := by
  have : Fact p.Prime := ⟨hp⟩
  exact ⟨ℕ, fun d => (primeTruncIdeal p hp d).ringCon.Quotient, fun _ => inferInstance,
    fun d => finite_trunc ConcreteSource.machine (PrimeAlgebra.threshold_le_height p hp) p d,
    fun d => (primeTruncIdeal p hp d).ringCon.mk', separation p hp⟩

/-- `OpenObligations` reduces to finite-rank injectivity. -/
theorem openObligations_of_injective
    (hinj : Function.Injective (Stable.of (PrimeAlgebra.R p hp) 12)) : OpenObligations p hp :=
  ⟨hinj, separation_obligation p hp⟩

end Prime

/-- The existence theorem follows from finite-rank injectivity of the stable map in rank 12 for
R(p), for every prime p. -/
theorem target_of_injective
    (h : ∀ p : ℕ, ∀ hp : p.Prime, Function.Injective (Stable.of (PrimeAlgebra.R p hp) 12)) :
    Target :=
  target_of_open fun p hp => openObligations_of_injective p hp (h p hp)

end

end Phases
end AllPrimeGroups
