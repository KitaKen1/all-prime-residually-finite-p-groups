OAI.SourceBurnside.thm_main : OAI.SourceBurnside.MainStatement ∧ OAI.SourceBurnside.BurnsideStatement
def OAI.SourceBurnside.MainStatement : Prop :=
∃ R x x_1,
  Infinite (OAI.SourceBurnside.Steinberg 12 R) ∧
    Group.IsFinitelyPresented (OAI.SourceBurnside.Steinberg 12 R) ∧
      OAI.SourceBurnside.Periodic (OAI.SourceBurnside.Steinberg 12 R)
def OAI.SourceBurnside.BurnsideStatement : Prop :=
∃ G x, Infinite G ∧ Group.IsFinitelyPresented G ∧ OAI.SourceBurnside.Periodic G
'OAI.SourceBurnside.thm_main' depends on axioms: [propext, Classical.choice, Quot.sound]
